  "license": "MIT",
  "devDependencies": {
    "@fluentui/svg-icons": "1.1.344",
    "electron": "44.7.0",
    "playwright-core": "1.64.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "imapflow": "2.4.0",
    "mailparser": "3.9.38",
    "nodemailer": "10.1.0",
    "pdfjs-dist": "6.4.299"
  },
  "private": true
}
