node_modules/
/out/
/work/
/cache/
*.iso
*.qcow2
*.img
/shell/test/out/

# The repository root ignores every "bin/" directory (generic template): keep the image's
# /usr/bin scripts (aurora-shell, aurora-session) in git.
!/rootfs/usr/bin/
# and the fake scanimage that test/scan.test.mjs puts first on PATH
!/shell/test/fixtures/scan/bin/
# the fake Linux application of test/xapps.test.mjs and the fake FreeRDP of test/remote-extra.test.mjs
!/shell/test/fixtures/xapps/bin/
!/shell/test/fixtures/remote/bin/

# Selene archive signing key (private; tools/selene-key.sh). Only iso/keys/*.gpg (public) is committed.
/keys/
# its public half is exported next to the image sources on the build machine (made there, never shared)
/iso/keys/selene-archive-keyring.gpg
