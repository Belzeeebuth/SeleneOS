[Desktop Entry]
Type=Application
# Selene OS: hands links and files from Linux / Flatpak apps to the Selene app (aurora-open -> the shell).
# NoDisplay: the Lanceur already lists the Selene app itself.
Name=Selene Media Player
Name[fr]=Selene Lecteur
Exec=aurora-open media %U
TryExec=aurora-open
NoDisplay=true
Terminal=false
StartupNotify=false
MimeType=audio/mpeg;audio/x-wav;audio/wav;audio/ogg;audio/opus;audio/flac;audio/mp4;audio/aac;video/mp4;video/x-m4v;video/webm;video/ogg;video/x-matroska;video/quicktime;
