[Desktop Entry]
Type=Application
# Selene OS: hands links and files from Linux / Flatpak apps to the Selene app (aurora-open -> the shell).
# NoDisplay: the Lanceur already lists the Selene app itself.
Name=Selene PDF Reader
Name[fr]=Selene Lecteur PDF
Exec=aurora-open pdf %U
TryExec=aurora-open
NoDisplay=true
Terminal=false
StartupNotify=false
MimeType=application/pdf;
