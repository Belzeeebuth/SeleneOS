[Desktop Entry]
Type=Application
# Selene OS: hands links and files from Linux / Flatpak apps to the Selene app (aurora-open -> the shell).
# NoDisplay: the Lanceur already lists the Selene app itself.
Name=Selene Web Browser
Name[fr]=Selene Navigateur
Exec=aurora-open browser %U
TryExec=aurora-open
NoDisplay=true
Terminal=false
StartupNotify=false
MimeType=x-scheme-handler/http;x-scheme-handler/https;
