[Plymouth Theme]
Name=Selene OS
Name[fr]=Selene OS
Description=Selene OS boot splash: the crescent logo and a discreet silver spinner on a night-blue background.
Description[fr]=Écran de démarrage de Selene OS : le croissant de lune et un indicateur de chargement discret sur fond bleu nuit.
ModuleName=two-step

# Images (made by iso/build.sh configure_plymouth): watermark.png (the logo, rendered from
# shell/renderer/assets/aurora-logo.svg), throbber-0001..0036.png (a silver arc turning on a faint track)
# and the dialog/keyboard images of Ubuntu's "spinner" theme. Colours: Nocturne, cold ambiance.
[two-step]
Font=Inter 12
TitleFont=Inter Light 24
ImageDir=/usr/share/plymouth/themes/aurora
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.62
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.25
HorizontalAlignment=.5
VerticalAlignment=.64
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.42
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x080c16
BackgroundEndColor=0x121a2b
ProgressBarBackgroundColor=0x2a3247
ProgressBarForegroundColor=0xc9d3e6
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing updates... / Installation des mises à jour...
SubTitle=Do not turn off your computer / N'éteignez pas votre ordinateur

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading Selene OS... / Mise à niveau de Selene OS...
SubTitle=Do not turn off your computer / N'éteignez pas votre ordinateur

[firmware-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading firmware... / Mise à jour du micrologiciel...
SubTitle=Do not turn off your computer / N'éteignez pas votre ordinateur

[system-reset]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Resetting Selene OS... / Réinitialisation de Selene OS...
SubTitle=Do not turn off your computer / N'éteignez pas votre ordinateur
