#!/bin/bash
# aurora-install — installs Selene OS from the live medium onto a whole disk.
#
# Run as root. The graphical installer (shell/main/ipc/installer.js) starts it as
#     sudo -n /usr/lib/aurora/helpers/aurora-install --json --password-stdin --disk /dev/vda ...
# In the live session the live user has passwordless sudo: casper's initramfs script
# casper-bottom/25adduser writes "/etc/sudoers.d/casper" (<user> ALL=(ALL) NOPASSWD: ALL) into the
# live root at every boot. The automated install (aurora.autoinstall=1, see
# /usr/lib/aurora/autoinstall/README) runs it as root directly.
#
# Usage:
#   aurora-install --disk /dev/vda --user NAME --fullname "Full Name" --password-stdin
#                  --hostname aurora-pc --lang en|fr --keyboard us|fr|fr(oss)|ch(fr)|... --timezone Europe/Paris
#                  [--autologin] [--nvidia-driver PACKAGE|recommended] [--gaming APPID[,APPID...]]
#                  [--alongside --fingerprint SHA256 --esp N (--free-space STARTMIB:ENDMIB | --shrink N --new-size MIB)]
#                  [--alongside --expect-table SHA256 --esp N --root-size MIB (--free-start MIB | --shrink N --shrink-to MIB)]
#                  [--alongside --fingerprint SHA256 --esp N --reuse-partition N]
#   aurora-install --probe --json [--disk DEV]...
#                  [--source DIR|FILE.squashfs] [--medium DIR] [--log FILE]
#                  [--json] [--dry-run [--dry-run-delay SECONDS]] [--fail-at STAGE]
#
#   --probe             read-only survey for the installer (no other option needed): runs aurora-disk-probe --ui and
#                       prints one line {"probe":{"firmware","disks":[…]}} (see its header). Nothing is written.
#   --alongside         install NEXT TO the systems already on --disk instead of erasing it (UEFI + GPT only):
#                       every partition stays as it is, except the one shrunk with --shrink; the existing EFI system
#                       partition is reused (never formatted; only EFI/ubuntu is written, plus the removable
#                       EFI/BOOT/BOOTX64.EFI when the disk has no EFI/BOOT folder), a firmware boot entry « Selene » is
#                       added first in BootOrder (efibootmgr) and GRUB lists the other systems with a 5 s menu: Windows
#                       through os-prober; another Linux (or any other system) through its OWN EFI boot loader, chainloaded
#                       (« {name} »: its os-release PRETTY_NAME, else its firmware label; Limine, systemd-boot, rEFInd,
#                       GRUB…), from the firmware's boot entries on this ESP read before « Selene » is added (efibootmgr -v),
#                       else the known loader paths of the ESP. Written to /etc/grub.d/25_aurora_chainload, which reads
#                       /etc/aurora/boot-chainload.list (update-grub keeps them); the partition of that Linux is in
#                       GRUB_OS_PROBER_SKIP_LIST (no second, fragile os-prober entry for it). No BIOS boot loader is
#                       written. The read-only survey the plan comes from is /usr/lib/aurora/helpers/aurora-disk-probe
#                       (run by the installer as root).
#     --fingerprint H   sha256 of `sfdisk --dump DISK` when the plan was shown (the survey's "fingerprint"): refused,
#                       with nothing written, when the partition table changed since (checked again right before
#                       the partition table is written)
#     --esp N           the EFI system partition to reuse (must be the one the survey reports)
#     --free-space S:E  create the Selene OS partition in the unallocated space S..E (MiB from the start of the disk,
#                       1 MiB aligned, at least 20 GB = 19074 MiB, inside one free region of the survey)
#     --shrink N        shrink partition N first (NTFS: ntfsresize; ext4: e2fsck -f then resize2fs; anything else,
#     --new-size MIB    and a hibernated / Fast Startup / BitLocker / dirty / mounted partition, is refused) to MIB,
#                       between the survey's minSizeMiB (max(used + 5 GB, used / 0.9, the file system's minimum)) and
#                       maxSizeMiB; the
#                       Selene OS partition takes the space freed after it, up to the next partition (1 MiB aligned).
#                       The file system is shrunk first, then its partition entry, and the new partition is created
#                       only after a successful shrink.
#     --reuse-partition N  format again the « Selene OS » partition N an installation that stopped left behind
#                       (aurora-disk-probe plan « reuse »: GPT name « Selene OS », ext4 « AURORA » or not formatted, no
#                       AURORA_INSTALL_COMPLETE in it; a finished installation is refused); the partition table is not changed
#     --expect-table H, --free-start S, --shrink-to MIB: other spellings of --fingerprint, --free-space S:S+R, --new-size
#     --root-size R     size of the Selene OS partition in MiB (default: all the free space / all the space freed)
#                       Every plan is checked again by `aurora-disk-probe --plan` (fresh survey, same rules) before
#                       anything is written. The partition table before the change is saved to the log and to
#                       /var/log/aurora-install-partitions.sfdisk on the installed system (`sfdisk DISK <` restores it).
#   --disk DEV          whole disk to ERASE (sda, vda, nvme0n1, mmcblk0, loopN with partition scanning);
#                       refused when it is the live medium, holds the installation source, has
#                       partitions mounted outside /media, /mnt or /run/media, or is smaller than 12 GB
#   --user NAME         account to create ([a-z_][a-z0-9_-]{0,31}, not a system account); member of
#                       sudo, adm, users, netdev, audio, video, plugdev
#   --password-stdin    the account password is the first line of standard input (never an argument)
#   --autologin         sign that account in automatically (greetd [initial_session])
#   --nvidia-driver P   also install an NVIDIA graphics driver, downloaded from the Ubuntu archive (needs the
#                       Internet): nvidia-driver-NNN[-open|-server|-server-open], or "recommended" (the one
#                       `ubuntu-drivers devices` recommends for this card). It must be offered for this computer by
#                       `ubuntu-drivers devices` (run in the installed system after apt-get update) and is installed
#                       with `ubuntu-drivers install nvidia:NNN[-open…]`, which takes the prebuilt kernel modules
#                       signed by Canonical (linux-modules-nvidia-NNN-<flavour>): Secure Boot keeps working without
#                       enrolling a key. A failure here never fails the installation: it is reported as
#                       {"driver":"failed","package":…,"message":…} (else {"driver":"installed","package":…}) and the
#                       driver can be installed later in Settings > Graphics drivers.
#   --gaming IDS        gaming apps to install from Flathub at the new account's first sign-in (the « Jeux » step):
#                       comma-separated Flathub ids, each one of com.valvesoftware.Steam, com.heroicgameslauncher.hgl,
#                       net.lutris.Lutris, net.davidotek.pupgui2, com.usebottles.bottles, com.discordapp.Discord (nothing
#                       else is accepted). Nothing is downloaded during the installation: the choice is written to
#                       <home>/.config/aurora/first-login/gaming.json ({"version":1,"apps":[…],"requestedAt":"<ISO date>"},
#                       owned by the new account, 0644, directories 0755) and the session installs the apps per user
#                       (flatpak --user) when that account signs in. A failure here never fails the installation: it is
#                       reported as {"gaming":"failed","apps":"…","message":…} (else {"gaming":"saved","apps":"id,id"}).
#   --source            system to copy: a squashfs image (unsquashfs) or a directory (rsync).
#                       Default: /cdrom/casper/filesystem.squashfs, else the casper live root /rofs
#   --medium DIR        root of the live medium (filesystem.manifest-remove, GRUB theme, build id).
#                       Default: two levels above a squashfs source, /cdrom for /rofs
#   --log FILE          log file (default /var/log/aurora-install.log; dry runs log to stderr only)
#   --json              machine-readable progress on stdout, one JSON object per line:
#                         {"stage":"partition|format|copy|configure|bootloader|cleanup|done","progress":0..100,"message":"…"}
#                         {"error":"…","stage":"…","code":N}
#                         {"driver":"installed|failed","package":"nvidia-driver-NNN","message":"…"}  (--nvidia-driver)
#                         {"gaming":"saved|failed","apps":"com.valvesoftware.Steam,…","message":"…"}  (--gaming)
#                         {"bootentry":"added|failed|skipped","message":"…"}  (--alongside: firmware boot entry « Selene »;
#                                                                     a failure is reported, never fatal: the disk is complete)
#                       Human-readable log lines always go to stderr (and to the log file).
#   --dry-run           validate the arguments, then simulate every stage with short sleeps: touches
#                       nothing, needs no root (UI development, tests)
#   --fail-at STAGE     testing aid: fail at the start of STAGE (real or dry run), to exercise error
#                       handling and cleanup
#
# Stages: partition (wipefs, GPT: 1 MiB BIOS boot + 512 MiB EFI System + ext4 "AURORA"), format,
# copy (unsquashfs/rsync with progress), configure (fstab by UUID, hostname, live-session remnants
# removed, live-only packages purged offline from filesystem.manifest-remove, locale, keyboard, time
# zone, user + password, per-user settings, the gaming apps request (--gaming), greetd, machine-id, initramfs), drivers (only with --nvidia-driver:
# apt-get update + ubuntu-drivers install in the target, DNS from the live session), bootloader (GRUB for BIOS
# on the disk AND UEFI on the ESP: EFI/ubuntu + removable EFI/BOOT/BOOTX64.EFI via shim, no NVRAM
# writes; /etc/default/grub.d/50-aurora.cfg, Selene OS GRUB theme, update-grub), cleanup (sync, unmount).
#
# Re-running on the same disk is safe: leftovers of an interrupted run (mounts under
# /run/aurora-install) are unmounted first and the disk is partitioned and formatted again.
# On failure or cancellation (SIGTERM/SIGINT), everything this script mounted is unmounted.
#
# Exit codes: 0 ok, 2 invalid arguments, 3 not found, 4 refused (safety checks), 5 failed, 130 cancelled.
# shellcheck disable=SC2317  # functions below are also called through traps and exported to subshells
# shellcheck disable=SC2016  # single-quoted ${...} are dpkg-query formats and bash -c scripts
set -Eeuo pipefail
umask 022
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
IFS=$' \t\n'

MIN_SIZE=12000000000            # bytes (12 GB)
WORKDIR=/run/aurora-install     # mount root (target system under $WORKDIR/target)
TARGET=$WORKDIR/target
LOCK=/run/aurora-install.lock
LINKS_STATE=/run/aurora-install.links   # /dev/disk/by-uuid links created where udev does not run
STAGES=(shrink partition format copy configure drivers bootloader cleanup)   # shrink: --fail-at only (progress says partition)
USER_GROUPS=(sudo adm users netdev audio video plugdev)
RESERVED_USERS=" root daemon bin sys sync games man lp mail news uucp proxy www-data backup list irc gnats nobody systemd-network systemd-resolve systemd-timesync systemd-coredump messagebus syslog _apt tss uuidd tcpdump sshd polkitd _greetd greeter aurora-greeter admin sudo adm users wheel staff operator ubuntu "

# ------------------------------------------------------------------ arguments
DISK="" USERNAME="" FULLNAME="" HOST_NAME="" LANGUAGE_ID="en" KEYBOARD="us" TIMEZONE="UTC"
AUTOLOGIN=0 SOURCE="" MEDIUM="" LOG_FILE="" JSON=0 DRY_RUN=0 DRY_DELAY=0.35 FAIL_AT="" PASSWORD_STDIN=0 NVIDIA_DRIVER=
GAMING="" GAMING_APPS=()
ALONGSIDE=0 FINGERPRINT="" FREE_SPACE="" FREE_START_ARG="" SHRINK_NUM_ARG="" NEW_SIZE_ARG="" ROOT_SIZE_ARG="" ESP_NUM_ARG="" REUSE_NUM_ARG=""
PROBE_MODE=0 PROBE_DISKS=()
# The only Flathub apps --gaming accepts (same list as shell/main/ipc/installer.js GAMING_APPS).
GAMING_ALLOWED=(com.valvesoftware.Steam com.heroicgameslauncher.hgl net.lutris.Lutris net.davidotek.pupgui2 com.usebottles.bottles com.discordapp.Discord)
PASSWORD=""

usage() { sed -n '2,/^set -E/p' "${BASH_SOURCE[0]}" | sed -e '$d' -e 's/^# \{0,1\}//'; }

ARG_ERR=""
need_val() { [[ $# -ge 2 && -n "${2-}" ]] || { ARG_ERR="$1 needs a value"; return 1; }; }
while (($#)); do
  case "$1" in
    --disk) need_val "$@" || break; DISK=$2; PROBE_DISKS+=("$2"); shift 2 ;;
    --user) need_val "$@" || break; USERNAME=$2; shift 2 ;;
    --fullname) [[ $# -ge 2 ]] || { ARG_ERR="--fullname needs a value"; break; }; FULLNAME=$2; shift 2 ;;
    --hostname) need_val "$@" || break; HOST_NAME=$2; shift 2 ;;
    --lang) need_val "$@" || break; LANGUAGE_ID=$2; shift 2 ;;
    --keyboard) need_val "$@" || break; KEYBOARD=$2; shift 2 ;;
    --timezone) need_val "$@" || break; TIMEZONE=$2; shift 2 ;;
    --source) need_val "$@" || break; SOURCE=$2; shift 2 ;;
    --medium) need_val "$@" || break; MEDIUM=$2; shift 2 ;;
    --log) need_val "$@" || break; LOG_FILE=$2; shift 2 ;;
    --dry-run-delay) need_val "$@" || break; DRY_DELAY=$2; shift 2 ;;
    --fail-at) need_val "$@" || break; FAIL_AT=$2; shift 2 ;;
    --nvidia-driver) need_val "$@" || break; NVIDIA_DRIVER=$2; shift 2 ;;
    --gaming) need_val "$@" || break; GAMING=$2; shift 2 ;;
    --probe) PROBE_MODE=1; shift ;;
    --alongside) ALONGSIDE=1; shift ;;
    --fingerprint|--expect-table) need_val "$@" || break; FINGERPRINT=$2; shift 2 ;;
    --free-space) need_val "$@" || break; FREE_SPACE=$2; shift 2 ;;
    --free-start) need_val "$@" || break; FREE_START_ARG=$2; shift 2 ;;
    --shrink) need_val "$@" || break; SHRINK_NUM_ARG=$2; shift 2 ;;
    --new-size|--shrink-to) need_val "$@" || break; NEW_SIZE_ARG=$2; shift 2 ;;
    --root-size) need_val "$@" || break; ROOT_SIZE_ARG=$2; shift 2 ;;
    --esp) need_val "$@" || break; ESP_NUM_ARG=$2; shift 2 ;;
    --reuse-partition) need_val "$@" || break; REUSE_NUM_ARG=$2; shift 2 ;;
    --password-stdin) PASSWORD_STDIN=1; shift ;;
    --autologin) AUTOLOGIN=1; shift ;;
    --json) JSON=1; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) ARG_ERR="unknown argument: $1 (see --help)"; break ;;
  esac
done

# ------------------------------------------------------------------ output: JSON on fd 3, log on stderr
exec 3>&1 1>&2   # fd 3 = the caller's stdout (JSON only); everything else goes to stderr
# A closed pipe (the installer UI went away) must not kill the installation half-way: writes then
# fail quietly and the log file keeps the full record.
trap '' PIPE
STAGE="" PROGRESS=0 DONE=0 ERROR_SENT=0 T0=$(date +%s) BG_PID=""

json_str() { # json_str TEXT -> "TEXT" with JSON escaping (control characters dropped)
  local s=$1
  s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; s=${s//$'\r'/}; s=${s//$'\t'/ }
  s=$(printf '%s' "$s" | tr -d '\000-\010\013\014\016-\037\177')
  printf '"%s"' "$s"
}
log() { printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*" >&2 || true; }
has_text() { grep -qF -- "$1" <<<"$2"; }   # no pipes: grep -q + pipefail would misreport (SIGPIPE)
# progress STAGE PERCENT MESSAGE: overall percentage, never decreasing
# With --nvidia-driver the stages after the copy make room for the driver download (drivers: 76..88):
# copy 7..75 -> ..64, configure 76..86 -> 65..75, bootloader 87..97 -> 89..97.
progress() {
  local stage=$1 pct=$2 msg=${3:-}
  if [[ -n "${NVIDIA_DRIVER:-}" && "$stage" != drivers ]]; then
    if ((pct <= 75)); then pct=$((pct * 64 / 75))
    elif ((pct <= 86)); then pct=$((pct - 11))
    elif ((pct <= 97)); then pct=$((89 + (pct - 87) * 8 / 10)); fi
  fi
  ((pct < PROGRESS)) && pct=$PROGRESS
  ((pct > 100)) && pct=100
  if [[ "$stage" != "$STAGE" || -n "$msg" ]]; then
    [[ -n "$msg" ]] && log "==> [$pct%] $msg"
  fi
  STAGE=$stage PROGRESS=$pct
  if ((JSON)); then
    printf '{"stage":"%s","progress":%d,"message":%s}\n' "$stage" "$pct" "$(json_str "$msg")" >&3 2>/dev/null || true
  fi
}
emit_driver() { # emit_driver installed|failed PACKAGE [MESSAGE]
  log "graphics driver $2: $1${3:+ ($3)}"
  if ((JSON)); then
    printf '{"driver":"%s","package":%s,"message":%s}\n' "$1" "$(json_str "$2")" "$(json_str "${3:-}")" >&3 2>/dev/null || true
  fi
}
emit_gaming() { # emit_gaming saved|failed [MESSAGE]
  local apps; apps=$(IFS=,; printf '%s' "${GAMING_APPS[*]}")
  log "gaming apps for the first sign-in ($apps): $1${2:+ ($2)}"
  if ((JSON)); then
    printf '{"gaming":"%s","apps":%s,"message":%s}\n' "$1" "$(json_str "$apps")" "$(json_str "${2:-}")" >&3 2>/dev/null || true
  fi
}
emit_bootentry() { # emit_bootentry added|failed|skipped [MESSAGE]
  log "firmware boot entry « Selene »: $1${2:+ ($2)}"
  if ((JSON)); then
    printf '{"bootentry":"%s","message":%s}\n' "$1" "$(json_str "${2:-}")" >&3 2>/dev/null || true
  fi
}
emit_error() { # emit_error CODE MESSAGE
  ((ERROR_SENT)) && return 0
  ERROR_SENT=1
  log "ERROR: $2"
  if ((JSON)); then
    printf '{"error":%s,"stage":"%s","code":%d}\n' "$(json_str "$2")" "${STAGE:-init}" "$1" >&3 2>/dev/null || true
  fi
}
die() { # die CODE MESSAGE
  emit_error "$1" "$2"
  exit "$1"
}
# run MESSAGE CMD...: runs CMD (output to the log), turns a failure into a clean error
run() {
  local msg=$1; shift
  log "\$ $*"
  local cmd=$1; [[ "$cmd" == in_target ]] && cmd=${2:-$1}
  if declare -F bg_wait >/dev/null; then
    bg_wait "$@" || die 5 "$msg (command failed: $cmd)"
  else
    "$@" || die 5 "$msg (command failed: $cmd)"
  fi
}

[[ -z "$ARG_ERR" ]] || die 2 "$ARG_ERR"

# ------------------------------------------------------------------ read-only survey (--probe)
if ((PROBE_MODE)); then
  _probe=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/aurora-disk-probe
  [[ -x "$_probe" ]] || die 3 "$_probe is missing"
  _pargs=(--ui)
  for _d in "${PROBE_DISKS[@]}"; do
    [[ "$_d" =~ ^/dev/[A-Za-z0-9/_.:-]+$ && "$_d" != *..* ]] || die 2 "invalid disk path: $_d"
    _pargs+=(--disk "$_d")
  done
  [[ "${AURORA_INSTALL_TEST_NO_FIRMWARE:-}" == 1 ]] && _pargs+=(--assume-uefi)
  exec "$_probe" "${_pargs[@]}" >&3
fi

# ------------------------------------------------------------------ validation (shared by real and dry runs)
RE_USER='^[a-z_][a-z0-9_-]{0,31}$'
RE_HOST='^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$'
RE_KBD='^([a-z]{2,3})(\(([a-z0-9_-]{1,32})\))?$'
RE_TZ='^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+){0,2}$'
RE_PATH='^/[A-Za-z0-9._/+-]*$'

[[ -n "$DISK" ]] || die 2 "--disk is required"
[[ "$DISK" =~ ^/dev/[A-Za-z0-9/_.:-]+$ && "$DISK" != *..* ]] || die 2 "invalid disk path: $DISK"
[[ -n "$USERNAME" ]] || die 2 "--user is required"
[[ "$USERNAME" =~ $RE_USER ]] || die 2 "invalid user name (lowercase letters, digits, - and _; must start with a letter or _)"
[[ "$RESERVED_USERS" != *" $USERNAME "* ]] || die 2 "the user name '$USERNAME' is reserved by the system"
((${#FULLNAME} <= 128)) || die 2 "the full name is too long"
RE_BADNAME='[:,=\\]'
[[ ! "$FULLNAME" =~ $RE_BADNAME ]] || die 2 "the full name cannot contain : , = or \\"
[[ "$FULLNAME" != *[[:cntrl:]]* ]] || die 2 "the full name contains control characters"
[[ -n "$FULLNAME" ]] || FULLNAME=$USERNAME
[[ -n "$HOST_NAME" ]] || HOST_NAME="$USERNAME-pc"
[[ "$HOST_NAME" =~ $RE_HOST ]] || die 2 "invalid computer name (letters, digits and -, at most 63 characters)"
case "$LANGUAGE_ID" in en) LOCALE=en_US.UTF-8 ;; fr) LOCALE=fr_FR.UTF-8 ;; *) die 2 "--lang must be en or fr" ;; esac
[[ "$KEYBOARD" =~ $RE_KBD ]] || die 2 "invalid keyboard layout: $KEYBOARD (e.g. us, fr, fr(oss), ch(fr))"
XKB_LAYOUT=${BASH_REMATCH[1]} XKB_VARIANT=${BASH_REMATCH[3]:-}
[[ "$TIMEZONE" =~ $RE_TZ && "$TIMEZONE" != *..* && ! "$TIMEZONE" =~ ^(posix|right)/ ]] || die 2 "invalid time zone: $TIMEZONE"
[[ "$DRY_DELAY" =~ ^[0-9]{1,2}(\.[0-9]{1,3})?$ ]] || die 2 "invalid --dry-run-delay"
# Same rule as shell/main/lib/gpu-drivers.js validDriverPkg (plus "recommended").
RE_NVIDIA='^nvidia-driver-[0-9]{3}(-open|-server|-server-open)?$'
if [[ -n "$NVIDIA_DRIVER" ]]; then
  [[ "$NVIDIA_DRIVER" == recommended || "$NVIDIA_DRIVER" =~ $RE_NVIDIA ]] \
    || die 2 "invalid --nvidia-driver: $NVIDIA_DRIVER (nvidia-driver-NNN[-open|-server|-server-open] or recommended)"
fi
# --gaming: comma-separated ids, each one from the allow-list (duplicates dropped, allow-list order kept).
if [[ -n "$GAMING" ]]; then
  [[ "$GAMING" =~ ^[A-Za-z0-9.,]{1,400}$ ]] || die 2 "invalid --gaming: $GAMING (comma-separated Flathub ids)"
  IFS=, read -r -a _ids <<<"$GAMING"
  ((${#_ids[@]})) || die 2 "invalid --gaming: no app"
  for _id in "${_ids[@]}"; do
    [[ " ${GAMING_ALLOWED[*]} " == *" $_id "* ]] || die 2 "invalid --gaming: $_id is not one of the gaming apps (${GAMING_ALLOWED[*]})"
  done
  for _id in "${GAMING_ALLOWED[@]}"; do
    [[ ",$GAMING," == *",$_id,"* ]] && GAMING_APPS+=("$_id")
  done
  unset _ids _id
fi
if [[ -n "$FAIL_AT" ]]; then
  [[ " ${STAGES[*]} " == *" $FAIL_AT "* ]] || die 2 "--fail-at: unknown stage $FAIL_AT (${STAGES[*]})"
fi
# --alongside: one plan, strict numbers (MiB within bounds, partition numbers 1..128, sha256 fingerprint).
MIN_ALONGSIDE_MIB=19074   # 20 GB, aurora-disk-probe MIN_SELENE_MIB (installer.js ROOT_MIN)
RE_MENU_NAME='^[A-Za-z0-9][A-Za-z0-9 ._+(),/-]{0,63}$'   # GRUB menu entry titles we write (aurora-disk-probe RE_MENU_NAME)
num_ok() { [[ "$1" =~ ^[0-9]{1,9}$ ]] && ((10#$1 >= $2 && 10#$1 <= $3)); }
if ((ALONGSIDE)); then
  [[ "$FINGERPRINT" =~ ^[0-9a-f]{64}$ ]] || die 2 "--alongside needs --fingerprint (sha256 of the partition table shown)"
  num_ok "$ESP_NUM_ARG" 1 128 || die 2 "--alongside needs --esp N (the EFI system partition, 1..128)"
  ESP_NUM_ARG=$((10#$ESP_NUM_ARG))
  ROOT_SIZE_MIB=""
  if [[ -n "$ROOT_SIZE_ARG" ]]; then
    num_ok "$ROOT_SIZE_ARG" "$MIN_ALONGSIDE_MIB" 999999999 || die 2 "invalid --root-size: $ROOT_SIZE_ARG (MiB, at least $MIN_ALONGSIDE_MIB)"
    ROOT_SIZE_MIB=$((10#$ROOT_SIZE_ARG))
  fi
  if [[ -n "$REUSE_NUM_ARG" ]]; then   # the partition an installation that stopped left behind: nothing else changes
    [[ -z "$FREE_SPACE$FREE_START_ARG$SHRINK_NUM_ARG$NEW_SIZE_ARG$ROOT_SIZE_ARG" ]] || die 2 "--reuse-partition cannot be combined with another plan or --root-size"
    num_ok "$REUSE_NUM_ARG" 1 128 || die 2 "invalid --reuse-partition: $REUSE_NUM_ARG (partition number)"
    ((10#$REUSE_NUM_ARG != ESP_NUM_ARG)) || die 2 "the EFI system partition cannot be reused for Selene OS"
    PLAN_SPEC="reuse:$((10#$REUSE_NUM_ARG))"
  elif [[ -n "$FREE_START_ARG" ]]; then   # --free-start S --root-size R == --free-space S:S+R
    [[ -z "$FREE_SPACE" && -n "$ROOT_SIZE_MIB" ]] || die 2 "--free-start needs --root-size (and no --free-space)"
    num_ok "$FREE_START_ARG" 1 999999999 || die 2 "invalid --free-start: $FREE_START_ARG (MiB)"
    FREE_SPACE="$((10#$FREE_START_ARG)):$((10#$FREE_START_ARG + ROOT_SIZE_MIB))"
  fi
  if [[ -n "$REUSE_NUM_ARG" ]]; then
    :   # PLAN_SPEC=reuse:N (above)
  elif [[ -n "$FREE_SPACE" ]]; then
    [[ -z "$SHRINK_NUM_ARG$NEW_SIZE_ARG" ]] || die 2 "--free-space and --shrink cannot be combined"
    [[ "$FREE_SPACE" =~ ^([0-9]{1,9}):([0-9]{1,9})$ ]] || die 2 "invalid --free-space: $FREE_SPACE (STARTMIB:ENDMIB)"
    FS_START=$((10#${BASH_REMATCH[1]})) FS_END=$((10#${BASH_REMATCH[2]}))
    ((FS_START >= 1 && FS_END > FS_START && FS_END - FS_START >= MIN_ALONGSIDE_MIB)) \
      || die 2 "invalid --free-space: $FREE_SPACE (at least $MIN_ALONGSIDE_MIB MiB, start >= 1 MiB)"
    PLAN_SPEC="free:$FS_START:$FS_END"
    [[ -z "$ROOT_SIZE_MIB" ]] || ((FS_END - FS_START == ROOT_SIZE_MIB)) || die 2 "--root-size does not match --free-space"
  elif [[ -n "$SHRINK_NUM_ARG" ]]; then
    num_ok "$SHRINK_NUM_ARG" 1 128 || die 2 "invalid --shrink: $SHRINK_NUM_ARG (partition number)"
    num_ok "$NEW_SIZE_ARG" 1024 999999999 || die 2 "--shrink needs --new-size MIB (at least 1024)"
    ((10#$SHRINK_NUM_ARG != ESP_NUM_ARG)) || die 2 "the EFI system partition cannot be shrunk"
    PLAN_SPEC="shrink:$((10#$SHRINK_NUM_ARG)):$((10#$NEW_SIZE_ARG))${ROOT_SIZE_MIB:+:$ROOT_SIZE_MIB}"
  else
    die 2 "--alongside needs --free-space STARTMIB:ENDMIB, --shrink N --new-size MIB or --reuse-partition N"
  fi
else
  [[ -z "$FINGERPRINT$FREE_SPACE$FREE_START_ARG$SHRINK_NUM_ARG$NEW_SIZE_ARG$ROOT_SIZE_ARG$ESP_NUM_ARG$REUSE_NUM_ARG" ]] \
    || die 2 "--fingerprint, --esp, --free-space, --shrink, --new-size, --root-size and --reuse-partition need --alongside"
fi
for _p in "$SOURCE" "$MEDIUM" "$LOG_FILE"; do
  [[ -z "$_p" ]] || { [[ "$_p" =~ $RE_PATH && "$_p" != *..* ]] || die 2 "invalid path: $_p (absolute paths only)"; }
done
if ((PASSWORD_STDIN)); then
  IFS= read -r PASSWORD || true
  PASSWORD=${PASSWORD%$'\r'}
fi
[[ -n "$PASSWORD" ]] || die 2 "a password is required (--password-stdin)"
((${#PASSWORD} <= 256)) || die 2 "the password is too long"
[[ "$PASSWORD" != *[[:cntrl:]]* ]] || die 2 "the password contains control characters"

maybe_fail() { # maybe_fail STAGE — testing aid (--fail-at)
  if [[ "$FAIL_AT" == "$1" ]]; then STAGE=$1; die 5 "simulated failure at stage '$1' (--fail-at)"; fi
  return 0
}

# ------------------------------------------------------------------ dry run
if ((DRY_RUN)); then
  trap 'die 130 "installation cancelled"' INT TERM HUP
  trap 'rc=$?; ((DONE || rc == 0)) || emit_error "$rc" "installation failed (exit $rc)"' EXIT
  dsleep() { sleep "$DRY_DELAY"; }
  # A dry run never opens the named device (it may well be the disk of the machine running it).
  ((ALONGSIDE)) && log "DRY RUN — install alongside: $PLAN_SPEC, EFI system partition $ESP_NUM_ARG kept"
  log "DRY RUN — nothing will be written. disk=$DISK user=$USERNAME host=$HOST_NAME lang=$LANGUAGE_ID keyboard=$KEYBOARD timezone=$TIMEZONE autologin=$AUTOLOGIN${NVIDIA_DRIVER:+ nvidia-driver=$NVIDIA_DRIVER}${GAMING:+ gaming=$(IFS=,; printf '%s' "${GAMING_APPS[*]}")}"
  sim() { # sim STAGE FROM TO MESSAGE [log lines...]
    local st=$1 from=$2 to=$3 msg=$4 i; shift 4
    maybe_fail "$st"
    progress "$st" "$from" "$msg"
    for i in "$@"; do log "$i"; done
    dsleep
    progress "$st" "$to" ""
  }
  pp=""; [[ "$DISK" =~ [0-9]$ ]] && pp=p   # partition names: sda2, nvme0n1p2, loop0p2
  if ((ALONGSIDE)); then
    # AURORA_DRYRUN_PLAN_REFUSED=changed simulates a partition table that changed since it was shown.
    if [[ "${AURORA_DRYRUN_PLAN_REFUSED:-}" == changed ]]; then
      STAGE=partition; die 4 "The partitions of this disk changed since they were shown: nothing was changed. Go back and choose again."
    fi
    if [[ "$PLAN_SPEC" == shrink:* ]]; then
      IFS=: read -r _ _sn _ss _ <<<"$PLAN_SPEC"
      maybe_fail shrink
      sim partition 1 3 "Shrinking partition ${DISK}${pp}${_sn} to ${_ss} MiB (your files are kept)" "\$ ntfsresize --size ${_ss}M ${DISK}${pp}${_sn}"
      dsleep
    fi
    if [[ "$PLAN_SPEC" == reuse:* ]]; then
      sim partition 1 4 "Reusing the Selene OS partition ${DISK}${pp}${PLAN_SPEC#reuse:} of the previous attempt (nothing else changes)" "partition table unchanged (${PLAN_SPEC})"
      sim format 4 7 "Formatting the Selene OS partition" "\$ mkfs.ext4 -L AURORA ${DISK}${pp}${PLAN_SPEC#reuse:} (the EFI system partition is kept)"
    else
      sim partition 3 4 "Creating the Selene OS partition next to your systems" "\$ sfdisk --append $DISK (Selene OS ext4, ${PLAN_SPEC})"
      sim format 4 7 "Formatting the Selene OS partition" "\$ mkfs.ext4 -L AURORA ${DISK}${pp}N (the EFI system partition is kept)"
    fi
  else
    sim partition 1 4 "Partitioning $DISK" "\$ wipefs --all $DISK" "\$ sfdisk --label gpt $DISK (BIOS boot 1 MiB, EFI System 512 MiB, Selene OS ext4)"
    sim format 4 7 "Formatting the partitions" "\$ mkfs.vfat -F 32 -n EFI ${DISK}${pp}2" "\$ mkfs.ext4 -L AURORA ${DISK}${pp}3"
  fi
  maybe_fail copy
  progress copy 7 "Copying the system files"
  for p in 5 12 20 28 37 45 53 61 70 78 86 93 100; do
    sleep "$DRY_DELAY"
    progress copy $((7 + p * 68 / 100)) ""
  done
  sim configure 76 79 "Configuring the system" "fstab, hostname $HOST_NAME, locale $LOCALE, keyboard $KEYBOARD, time zone $TIMEZONE"
  progress configure 81 "Creating the user account $USERNAME"; dsleep
  if ((${#GAMING_APPS[@]})); then
    # Simulated too (nothing is written); AURORA_DRYRUN_GAMING_FAIL=1 simulates a request that cannot be written.
    log "\$ write /home/$USERNAME/.config/aurora/first-login/gaming.json (apps for the first sign-in: ${GAMING_APPS[*]})"
    if [[ "${AURORA_DRYRUN_GAMING_FAIL:-}" == 1 ]]; then emit_gaming failed "simulated failure (AURORA_DRYRUN_GAMING_FAIL)"
    else emit_gaming saved; fi
  fi
  progress configure 83 "Removing live-session packages"; dsleep
  progress configure 86 "Updating the initramfs"; dsleep
  if [[ -n "$NVIDIA_DRIVER" ]]; then
    # The driver is simulated too; --fail-at drivers simulates a driver that cannot be installed (no Internet):
    # reported, and the installation goes on.
    dpkg_drv=$NVIDIA_DRIVER; [[ "$dpkg_drv" == recommended ]] && dpkg_drv=nvidia-driver-550
    progress drivers 76 "Installing the NVIDIA graphics driver ($dpkg_drv)"
    log "\$ apt-get update (in the installed system)"; dsleep
    if [[ "$FAIL_AT" == drivers ]]; then
      log "E: Failed to fetch http://archive.ubuntu.com/ubuntu/dists/noble/InRelease  Temporary failure resolving 'archive.ubuntu.com' (simulated: --fail-at drivers)"
      emit_driver failed "$dpkg_drv" "could not download the package lists (no Internet connection?)"
    else
      progress drivers 79 "Checking the drivers offered for this graphics card"
      log "\$ ubuntu-drivers devices"; dsleep
      progress drivers 80 "Downloading the NVIDIA driver"
      for p in 25 50 75 100; do sleep "$DRY_DELAY"; progress drivers $((80 + p * 4 / 100)) ""; done
      progress drivers 84 "Installing the NVIDIA driver"
      log "\$ ubuntu-drivers install nvidia:${dpkg_drv#nvidia-driver-}"
      for p in 25 50 75 100; do sleep "$DRY_DELAY"; progress drivers $((84 + p * 4 / 100)) ""; done
      emit_driver installed "$dpkg_drv"
    fi
    progress drivers 88 ""
  fi
  if ((ALONGSIDE)); then
    sim bootloader 87 91 "Installing the boot loader (UEFI, next to your other systems)" "\$ grub-install --target=x86_64-efi --bootloader-id=ubuntu --no-nvram (EFI/ubuntu only)"
    log "\$ efibootmgr -v (the other systems' own boot loaders on this EFI system partition: GRUB chainloads them)"
    progress bootloader 94 "Writing the boot menu (with your other systems)"; dsleep
    progress bootloader 96 "Adding « Selene » to the computer's boot menu"; dsleep
    # AURORA_DRYRUN_BOOTENTRY_FAIL=1 simulates firmware that refuses the new boot entry (reported, not fatal).
    if [[ "${AURORA_DRYRUN_BOOTENTRY_FAIL:-}" == 1 ]]; then emit_bootentry failed "simulated failure (AURORA_DRYRUN_BOOTENTRY_FAIL)"
    else emit_bootentry added; fi
    progress bootloader 97 ""
  else
    sim bootloader 87 91 "Installing the boot loader (BIOS)" "\$ grub-install --target=i386-pc $DISK"
    progress bootloader 94 "Installing the boot loader (UEFI)"; dsleep
    progress bootloader 97 "Writing the boot menu"; dsleep
  fi
  sim cleanup 98 99 "Finishing" "sync; unmounting $TARGET"
  DONE=1
  progress "done" 100 "Selene OS has been installed (simulation: nothing was written)"
  exit 0
fi

# ====================================================================== real installation
[[ $EUID -eq 0 ]] || die 4 "must be run as root"
[[ -n "$LOG_FILE" ]] || LOG_FILE=/var/log/aurora-install.log
# Never follow a planted symlink (the log is made root:adm 0640 and appended to as root).
[[ -L "$LOG_FILE" || ( -e "$LOG_FILE" && ! -f "$LOG_FILE" ) ]] && die 2 "the log file $LOG_FILE must be a regular file"
mkdir -p "$(dirname "$LOG_FILE")"
touch "$LOG_FILE" || die 5 "cannot write the log file $LOG_FILE"
chmod 0640 "$LOG_FILE"
chgrp adm "$LOG_FILE" 2>/dev/null || true
# Everything written to stderr also lands in the log file (tee -p: keeps logging if the caller goes away).
exec 2> >(exec tee -p -a "$LOG_FILE" >&2)
{
  echo
  echo "======================================================================"
  echo "aurora-install $(date -u '+%F %T') UTC — caller: ${SUDO_USER:-root}"
  echo "disk=$DISK user=$USERNAME host=$HOST_NAME lang=$LANGUAGE_ID keyboard=$KEYBOARD timezone=$TIMEZONE autologin=$AUTOLOGIN${NVIDIA_DRIVER:+ nvidia-driver=$NVIDIA_DRIVER}${GAMING:+ gaming=$GAMING}"
} >&2

exec 9>"$LOCK"
flock -n 9 || die 4 "another installation is already running"

child_pids() { ps -o pid= --ppid "$1" 2>/dev/null | tr -d ' ' || true; }
kill_tree() { # kill_tree PID: SIGTERM to PID and all its descendants (children first)
  local c
  for c in $(child_pids "$1"); do kill_tree "$c"; done
  kill -TERM "$1" 2>/dev/null || true
}
umount_under() { # unmount everything at/below a path, deepest first
  local base mp
  base=$(readlink -f "$1" 2>/dev/null || echo "$1")
  while read -r mp; do
    [[ -n "$mp" ]] || continue
    umount "$mp" 2>/dev/null || umount -l "$mp" 2>/dev/null || log "warning: could not unmount $mp"
  done < <(findmnt -rn -o TARGET | awk -v b="$base" '$0 == b || index($0, b "/") == 1' | sort -r)
}
# shellcheck disable=SC2317  # invoked through traps
cleanup() {
  local rc=$?
  trap - EXIT INT TERM HUP ERR
  set +e
  # Stop a running copy/dpkg/grub-install (cancellation), then wait until it has really exited
  # so that the file systems can be unmounted.
  if [[ -n "$BG_PID" ]] && kill -0 "$BG_PID" 2>/dev/null; then
    kill_tree "$BG_PID"
    local i
    for ((i = 0; i < 100; i++)); do kill -0 "$BG_PID" 2>/dev/null || break; sleep 0.1; done
    wait "$BG_PID" 2>/dev/null
  fi
  if ((!DONE)); then
    ((rc == 0)) && rc=5
    emit_error "$rc" "installation failed (exit $rc)"
    esp_rollback
  fi
  ((DONE)) && [[ -n "$ESP_BACKUP" ]] && rm -rf "$ESP_BACKUP"
  rm -f "$TARGET/usr/sbin/policy-rc.d" 2>/dev/null
  sync
  umount_under "$WORKDIR"
  rmdir "$TARGET" "$WORKDIR" 2>/dev/null
  remove_created_links
  log "aurora-install finished with status $rc after $(( $(date +%s) - T0 ))s"
  exit "$rc"
}
trap cleanup EXIT
trap 'die 130 "installation cancelled"' INT TERM HUP
trap 'log "failed: $BASH_COMMAND (line $LINENO)"' ERR

# Long-running commands run in the background so that a cancellation (SIGTERM) is handled at once.
bg_wait() { # bg_wait CMD... : runs CMD in the background and waits for it (interruptible)
  local rc=0
  "$@" &
  BG_PID=$!
  wait "$BG_PID" || rc=$?
  BG_PID=""
  return "$rc"
}

# ------------------------------------------------------------------ disk checks
# Whole-disk device(s) underneath a block device (partitions, loop backing files, dm/md stacks).
disks_of() {
  local dev=$1 name bf src
  dev=$(readlink -f "$dev" 2>/dev/null) || return 0
  [[ -b "$dev" ]] || return 0
  name=${dev#/dev/}
  if [[ "$name" == loop* && -r "/sys/class/block/$name/loop/backing_file" ]]; then
    echo "$dev"
    bf=$(cat "/sys/class/block/$name/loop/backing_file")
    src=$(findmnt -n -o SOURCE -T "$bf" 2>/dev/null | head -n1)
    src=${src%%\[*}
    [[ "$src" == /dev/* ]] && disks_of "$src"
    return 0
  fi
  lsblk -nrspo NAME,TYPE "$dev" 2>/dev/null | awk '$2 == "disk" || $2 == "loop" || $2 == "rom" {print $1}'
}
# Devices that must never be erased: the live medium and whatever holds the source and the running root.
protected_disks() {
  local m src
  for m in /cdrom /rofs /isodevice /run/live/medium /media/cdrom /run/initramfs/live /; do
    src=$(findmnt -n -o SOURCE --mountpoint "$m" 2>/dev/null | head -n1) || continue
    src=${src%%\[*}   # bind mounts are reported as /dev/sdX[/subdir]
    [[ "$src" == /dev/* ]] && disks_of "$src"
  done
  if [[ -n "$SOURCE" && -e "$SOURCE" ]]; then
    src=$(findmnt -n -o SOURCE -T "$SOURCE" 2>/dev/null | head -n1)
    src=${src%%\[*}
    [[ "$src" == /dev/* ]] && disks_of "$src"
  fi
  return 0
}
part_path() { # part_path N -> /dev/sda3, /dev/nvme0n1p3, /dev/loop0p3
  if [[ "$DISK" =~ [0-9]$ ]]; then echo "${DISK}p$1"; else echo "${DISK}$1"; fi
}

# Low memory (track "robust"): a warning in the log only, never a failure (4 GB recommended, README).
warn_low_ram() {
  local kb
  kb=$(sed -n 's/^MemTotal: *\([0-9]*\) kB$/\1/p' /proc/meminfo 2>/dev/null) || return 0
  [[ -n "$kb" ]] && ((kb < 3670016)) && log "warning: $((kb / 1024)) MB of RAM; 4 GB recommended (installing anyway)"
  return 0
}

check_disk() {
  warn_low_ram
  local real name type ro size d mp part
  real=$(readlink -f "$DISK") || die 3 "disk $DISK not found"
  [[ -b "$real" ]] || die 3 "$DISK is not a block device"
  DISK=$real name=${DISK#/dev/}
  [[ -e "/sys/class/block/$name/partition" ]] && die 4 "$DISK is a partition: choose a whole disk"
  type=$(lsblk -dno TYPE "$DISK" 2>/dev/null | head -n1)
  case "$type" in
    disk|loop) ;;
    *) die 4 "$DISK is not a disk (type: ${type:-unknown})" ;;
  esac
  [[ "$name" == zram* || "$name" == ram* || "$name" == sr* ]] && die 4 "$DISK cannot be used for an installation"
  if [[ "$type" == loop ]]; then
    [[ -r "/sys/class/block/$name/loop/backing_file" ]] || die 4 "$DISK is not attached to an image"
    [[ "$(cat "/sys/class/block/$name/loop/partscan" 2>/dev/null)" == 1 ]] \
      || die 4 "$DISK has no partition scanning: attach the image with 'losetup -P'"
  fi
  ro=$(cat "/sys/class/block/$name/ro" 2>/dev/null || echo 0)
  [[ "$ro" == 0 ]] || die 4 "$DISK is read-only"
  size=$(blockdev --getsize64 "$DISK")
  DISK_SIZE=$size
  ((size >= MIN_SIZE)) || die 4 "$DISK is too small: $((size / 1000000)) MB, at least $((MIN_SIZE / 1000000000)) GB are needed"
  for d in $(protected_disks | sort -u); do
    [[ "$d" == "$DISK" ]] && die 4 "$DISK holds the live system or the installation source: choose another disk"
  done
  # Partitions in use: unmount removable-media style mounts, refuse anything else.
  local swaps; swaps=$(swapon --show=NAME --noheadings --raw 2>/dev/null || true)
  for part in $(lsblk -nrpo NAME "$DISK" 2>/dev/null); do
    while read -r mp; do
      [[ -n "$mp" ]] || continue
      mp=$(printf '%b' "$mp")   # findmnt -r escapes blanks as \x20
      case "$mp" in
        /media/*|/mnt/*|/run/media/*|"$WORKDIR"|"$WORKDIR"/*)
          log "unmounting $part from $mp"
          umount_under "$mp" ;;
        *) die 4 "$part is in use (mounted on $mp): choose another disk" ;;
      esac
    done < <(findmnt -rn -S "$part" -o TARGET 2>/dev/null || true)
    if grep -qxF -- "$part" <<<"$swaps"; then
      log "disabling swap on $part"
      swapoff "$part" || die 4 "cannot disable the swap space on $part"
    fi
  done
  # Holders of the whole disk (LVM/RAID/crypt directly on the disk) or of one of its partitions.
  for part in /sys/class/block/"$name"/holders/* /sys/class/block/"$name"/"$name"*/holders/*; do
    [[ -e "$part" ]] && die 4 "$DISK is in use by $(basename "$part") (LVM, RAID or encryption): choose another disk"
  done
  return 0
}

resolve_source() {
  if [[ -z "$SOURCE" ]]; then
    if [[ -f /cdrom/casper/filesystem.squashfs ]]; then SOURCE=/cdrom/casper/filesystem.squashfs
    elif mountpoint -q /rofs; then SOURCE=/rofs
    else die 3 "no installation source: not running from the Selene OS live medium (use --source)"; fi
  fi
  [[ "$SOURCE" != / ]] || die 2 "--source / is the running system; use the read-only live root (/rofs)"
  if [[ -f "$SOURCE" ]]; then
    SOURCE_KIND=squashfs
    unsquashfs -s "$SOURCE" >/dev/null 2>&1 || die 3 "$SOURCE is not a squashfs image"
    [[ -n "$MEDIUM" ]] || MEDIUM=$(cd "$(dirname "$SOURCE")/.." && pwd)
  elif [[ -d "$SOURCE" ]]; then
    SOURCE_KIND=dir
    [[ -n "$MEDIUM" ]] || MEDIUM=/cdrom
  else
    die 3 "installation source $SOURCE not found"
  fi
  # The source must be a Selene OS system.
  local osr
  if [[ "$SOURCE_KIND" == squashfs ]]; then
    osr=$(unsquashfs -cat "$SOURCE" usr/lib/os-release 2>/dev/null || true)
  else
    osr=$(cat "$SOURCE/usr/lib/os-release" 2>/dev/null || true)
  fi
  grep -q '^IMAGE_ID=aurora-os' <<<"$osr" || die 3 "$SOURCE is not a Selene OS system image"
  log "source: $SOURCE ($SOURCE_KIND), medium: $MEDIUM"
}

source_cat() { # source_cat REL-PATH -> file content from the source
  if [[ "$SOURCE_KIND" == squashfs ]]; then unsquashfs -cat "$SOURCE" "$1" 2>/dev/null; else cat "$SOURCE/$1" 2>/dev/null; fi
}

check_choices() {
  # The account must not exist in the source (system accounts such as daemon or _greetd).
  if grep -qxF -- "$USERNAME" <<<"$(source_cat etc/passwd | cut -d: -f1)"; then
    die 2 "the user name '$USERNAME' is already used by the system: choose another one"
  fi
  # Keyboard layout and time zone (checked on this system: the live system is the same image).
  if [[ -d /usr/share/X11/xkb/symbols ]]; then
    [[ -f "/usr/share/X11/xkb/symbols/$XKB_LAYOUT" ]] || die 2 "unknown keyboard layout: $XKB_LAYOUT"
    if [[ -n "$XKB_VARIANT" ]]; then
      grep -q "xkb_symbols \"$XKB_VARIANT\"" "/usr/share/X11/xkb/symbols/$XKB_LAYOUT" \
        || die 2 "unknown keyboard variant: $KEYBOARD"
    fi
  fi
  if [[ -d /usr/share/zoneinfo && "$TIMEZONE" != UTC ]]; then
    [[ -f "/usr/share/zoneinfo/$TIMEZONE" ]] || die 2 "unknown time zone: $TIMEZONE"
  fi
}

# ------------------------------------------------------------------ chroot helpers
chroot_mount() {
  local t=$TARGET
  mkdir -p "$t/proc" "$t/sys" "$t/dev" "$t/run" "$t/tmp"
  mountpoint -q "$t/proc" || mount -t proc proc "$t/proc"
  mountpoint -q "$t/sys" || mount -t sysfs sysfs "$t/sys" 2>/dev/null || mount --rbind /sys "$t/sys"
  mountpoint -q "$t/dev" || mount --bind /dev "$t/dev"
  mountpoint -q "$t/dev/pts" || mount --bind /dev/pts "$t/dev/pts"
  mountpoint -q "$t/run" || mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs "$t/run"
  # udev's database (read-only): os-prober (update-grub) recognises an EFI system partition by its udev
  # ID_PART_ENTRY_TYPE; without it « Windows Boot Manager » is missing from the menu of a dual boot install.
  if [[ -d /run/udev ]] && ! mountpoint -q "$t/run/udev"; then
    mkdir -p "$t/run/udev"
    { mount --bind /run/udev "$t/run/udev" && mount -o remount,bind,ro "$t/run/udev"; } \
      || log "warning: could not show udev's database in the target (os-prober may miss Windows)"
  fi
  # Maintainer scripts must not start services in the target.
  printf '#!/bin/sh\n# aurora-install: do not start daemons in the target\nexit 101\n' >"$t/usr/sbin/policy-rc.d"
  chmod 0755 "$t/usr/sbin/policy-rc.d"
}
in_target() {
  chroot "$TARGET" /usr/bin/env -i \
    HOME=/root PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LANG=C.UTF-8 LC_ALL=C.UTF-8 TERM=dumb \
    DEBIAN_FRONTEND=noninteractive DEBCONF_NONINTERACTIVE_SEEN=true DEBCONF_NOWARNINGS=yes \
    "$@"
}

parts_ready() { [[ -b "$(part_path 1)" && -b "$(part_path 2)" && -b "$(part_path 3)" ]]; }
# The EFI system partition is mounted on $TARGET/boot/efi. Where the running kernel cannot mount
# FAT (no vfat driver, e.g. a container), a tmpfs named after the partition is mounted there instead
# (grub-install identifies the ESP by the mount's source device and checks it with GRUB's own FAT
# reader), and its content is written into the FAT file system with mtools by flush_esp.
ESP_MODE=""
mount_esp() {
  mkdir -p "$TARGET/boot/efi"
  log "\$ mount -t vfat $P_ESP $TARGET/boot/efi"
  if mount -t vfat -o umask=0077 "$P_ESP" "$TARGET/boot/efi"; then ESP_MODE=mount; return 0; fi
  grep -qw vfat /proc/filesystems && die 5 "could not mount the EFI system partition"
  command -v mcopy >/dev/null 2>&1 || die 5 "this kernel cannot mount FAT file systems and mtools is not installed"
  run "could not prepare the EFI system partition" mount -t tmpfs -o size=512m,mode=0700 "$P_ESP" "$TARGET/boot/efi"
  ESP_MODE=mtools
  log "no vfat support in the running kernel: EFI files are staged on a tmpfs and written with mtools"
}
flush_esp() {
  [[ "$ESP_MODE" == mtools ]] || return 0
  local e out rc="$WORKDIR/mtoolsrc"
  printf 'mtools_skip_check=1\ndrive e: file="%s"\n' "$P_ESP" >"$rc"
  if ((ALONGSIDE)); then flush_esp_alongside "$rc"; return; fi
  shopt -s nullglob dotglob
  for e in "$TARGET"/boot/efi/*; do
    log "\$ mcopy -s ${e#"$TARGET"} $P_ESP:/"
    out=$(MTOOLSRC=$rc mcopy -s -o -m -Q "$e" e:/ 2>&1) || { printf '%s\n' "$out" >&2; die 5 "could not write the EFI system partition (mcopy)"; }
    grep -v 'Could not get geometry' <<<"$out" >&2 || true
  done
  shopt -u nullglob dotglob
  MTOOLSRC=$rc mtype e:/EFI/BOOT/BOOTX64.EFI 2>/dev/null | cmp -s - "$TARGET/boot/efi/EFI/BOOT/BOOTX64.EFI" \
    || die 5 "EFI/BOOT/BOOTX64.EFI on the EFI system partition does not match"
  MTOOLSRC=$rc mdir -/ e:/EFI 2>&1 | grep -v 'Could not get geometry' >&2 || true
  rm -f "$rc"
  umount "$TARGET/boot/efi" || die 5 "could not unmount the EFI staging area"
  ESP_MODE=flushed
}

flush_esp_alongside() { # only EFI/ubuntu (and EFI/BOOT when the disk had none) go to the shared ESP
  local rc=$1 d f out
  MTOOLSRC=$rc mmd e:/EFI >/dev/null 2>&1 || true   # exists on any ESP that boots something
  for d in ubuntu BOOT; do
    [[ "$d" == BOOT ]] && ((!ESP_OWN_FALLBACK)) && continue
    [[ -d "$TARGET/boot/efi/EFI/$d" ]] || continue
    log "\$ mcopy -s /boot/efi/EFI/$d $P_ESP:/EFI/"
    out=$(MTOOLSRC=$rc mcopy -s -o -m -Q "$TARGET/boot/efi/EFI/$d" e:/EFI/ 2>&1) || { printf '%s\n' "$out" >&2; die 5 "could not write the EFI system partition (mcopy)"; }
    grep -v 'Could not get geometry' <<<"$out" >&2 || true
  done
  for f in "$TARGET"/boot/efi/EFI/ubuntu/*; do
    [[ -f "$f" ]] || continue
    MTOOLSRC=$rc mtype "e:/EFI/ubuntu/${f##*/}" 2>/dev/null | cmp -s - "$f" || die 5 "EFI/ubuntu/${f##*/} on the EFI system partition does not match"
  done
  MTOOLSRC=$rc mdir -/ e:/EFI 2>&1 | grep -v 'Could not get geometry' >&2 || true
  rm -f "$rc"
  umount "$TARGET/boot/efi" || die 5 "could not unmount the EFI staging area"
  ESP_MODE=flushed
}

wait_for_partitions() {
  local i
  udevadm settle --timeout=10 >/dev/null 2>&1 || true
  for ((i = 0; i < 50; i++)); do parts_ready && return 0; sleep 0.1; done
  # Some setups need an explicit re-read (partx/partprobe) before the nodes appear.
  partx -u "$DISK" >/dev/null 2>&1 || partprobe "$DISK" >/dev/null 2>&1 || true
  for ((i = 0; i < 100; i++)); do
    udevadm settle --timeout=2 >/dev/null 2>&1 || true
    parts_ready && return 0
    sleep 0.1
  done
  die 5 "the new partitions of $DISK did not appear ($(part_path 1) …)"
}

# grub-mkconfig only writes root=UUID=… when /dev/disk/by-uuid/<uuid> exists (udev creates it;
# create it ourselves where udev does not run). They are removed at the end, or by the next run
# when this one was killed.
ensure_uuid_link() { # ensure_uuid_link UUID DEVICE
  local l=/dev/disk/by-uuid/$1
  [[ -e "$l" ]] && return 0
  mkdir -p /dev/disk/by-uuid
  ln -sf "../../${2#/dev/}" "$l"
  echo "$l" >>"$LINKS_STATE"
}
remove_created_links() {
  local l
  if [[ -f "$LINKS_STATE" ]]; then
    while read -r l; do [[ "$l" == /dev/disk/by-uuid/* && -L "$l" ]] && rm -f "$l"; done <"$LINKS_STATE"
    rm -f "$LINKS_STATE"
  fi
  rmdir /dev/disk/by-uuid /dev/disk 2>/dev/null || true
}

# ====================================================================== stages
stage_partition() {
  maybe_fail partition
  progress partition 1 "Partitioning $DISK"
  local p
  # Old signatures inside the existing partitions, then the partition table itself.
  for p in $(lsblk -nrpo NAME,TYPE "$DISK" | awk '$2 == "part" {print $1}'); do
    wipefs --all --force --quiet "$p" >/dev/null 2>&1 || true
  done
  run "could not erase $DISK" wipefs --all --force "$DISK"
  progress partition 2 ""
  log "\$ sfdisk --label gpt $DISK"
  sfdisk --quiet --wipe always --wipe-partitions always --label gpt "$DISK" <<'EOF' || die 5 "could not create the partition table on the disk"
label: gpt
size=1MiB, type=21686148-6449-6E6F-744E-656564454649, name="BIOS boot"
size=512MiB, type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B, name="EFI System"
type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, name="Selene OS"
EOF
  blockdev --rereadpt "$DISK" >/dev/null 2>&1 || partx -u "$DISK" >/dev/null 2>&1 || true
  wait_for_partitions
  P_BIOS=$(part_path 1) P_ESP=$(part_path 2) P_ROOT=$(part_path 3)
  sfdisk --dump "$DISK" >&2 || true
  progress partition 4 ""
}

stage_format() {
  maybe_fail format
  progress format 4 "Formatting the partitions"
  wipefs --all --force --quiet "$P_BIOS" "$P_ESP" "$P_ROOT" >/dev/null 2>&1 || true
  run "could not format the EFI system partition" mkfs.vfat -F 32 -n EFI "$P_ESP"
  progress format 5 ""
  run "could not format the system partition" mkfs.ext4 -F -q -L AURORA "$P_ROOT"
  udevadm settle --timeout=10 >/dev/null 2>&1 || true
  ROOT_UUID=$(blkid -p -s UUID -o value "$P_ROOT" 2>/dev/null || blkid -s UUID -o value "$P_ROOT")
  ESP_UUID=$(blkid -p -s UUID -o value "$P_ESP" 2>/dev/null || blkid -s UUID -o value "$P_ESP")
  [[ -n "$ROOT_UUID" && -n "$ESP_UUID" ]] || die 5 "could not read the UUIDs of the new file systems"
  log "root $P_ROOT UUID=$ROOT_UUID, ESP $P_ESP UUID=$ESP_UUID"
  ensure_uuid_link "$ROOT_UUID" "$P_ROOT"
  ensure_uuid_link "$ESP_UUID" "$P_ESP"
  mkdir -p "$TARGET"
  run "could not mount the system partition" mount -t ext4 "$P_ROOT" "$TARGET"
  progress format 7 ""
}

# ------------------------------------------------------------------ install alongside (--alongside)
# P_ROOT is a NEW partition; the EFI system partition is the existing one (never formatted); nothing else
# on the disk is touched except the partition being shrunk (--shrink).
PROBE=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/aurora-disk-probe
declare -A PLAN=()
TEST_NO_FIRMWARE=0
[[ "${AURORA_INSTALL_TEST_NO_FIRMWARE:-}" == 1 ]] && TEST_NO_FIRMWARE=1   # build machines (sudo never forwards it)
ESP_OWN_FALLBACK=0   # 1: the disk had no EFI/BOOT folder, Selene OS installs the removable EFI/BOOT/BOOTX64.EFI
pt_fingerprint() { sfdisk --dump "$DISK" 2>/dev/null | sha256sum | cut -d' ' -f1; }
plan_alongside() {
  if ((TEST_NO_FIRMWARE)); then
    log "test mode (AURORA_INSTALL_TEST_NO_FIRMWARE=1): firmware check and NVRAM boot entry skipped"
  else
    [[ -d /sys/firmware/efi ]] || die 4 "this computer started in legacy BIOS mode: installing alongside needs UEFI mode (restart and choose the UEFI entry of the USB drive), or erase the whole disk"
  fi
  [[ -x "$PROBE" ]] || die 3 "$PROBE is missing"
  local out rc=0 line k v
  local args=(--disk "$DISK" --plan "$PLAN_SPEC" --fingerprint "$FINGERPRINT" --format shell)
  args+=(--esp "$ESP_NUM_ARG")
  ((TEST_NO_FIRMWARE)) && args+=(--assume-uefi)
  log "\$ aurora-disk-probe ${args[*]}"
  out=$("$PROBE" "${args[@]}" 2>"$WORKDIR/probe.err") || rc=$?
  cat "$WORKDIR/probe.err" >&2 2>/dev/null; rm -f "$WORKDIR/probe.err"
  while IFS= read -r line; do
    [[ "$line" =~ ^([A-Z_]{2,32})=(.*)$ ]] || continue
    k=${BASH_REMATCH[1]} v=${BASH_REMATCH[2]}
    if [[ "$k" == CHAIN_NAME ]]; then   # a menu entry title (spaces allowed; never a quote or shell / GRUB metacharacter)
      [[ "$v" =~ $RE_MENU_NAME ]] || { log "warning: unexpected name of the other system from aurora-disk-probe: ignored"; continue; }
    else
      [[ "$k" == MESSAGE || "$v" =~ ^[A-Za-z0-9/._:-]*$ ]] || die 5 "unexpected value from aurora-disk-probe: $k"
    fi
    PLAN[$k]=$v
  done <<<"$out"
  if [[ "${PLAN[OK]:-0}" != 1 ]]; then
    ((rc == 0)) && rc=4
    ((rc == 3 || rc == 4)) || rc=5
    die "$rc" "${PLAN[MESSAGE]:-the installation plan was refused (aurora-disk-probe exit $rc)}"
  fi
  # Everything the destructive steps use comes from the probe's fresh survey, checked again here.
  local key
  for key in KIND NEW_START NEW_SECTORS NEW_SIZE_MIB ESP_NUM ESP_PART SECTOR_SIZE FINGERPRINT; do
    [[ -n "${PLAN[$key]:-}" ]] || die 5 "incomplete plan from aurora-disk-probe ($key)"
  done
  for key in NEW_START NEW_SECTORS NEW_SIZE_MIB ESP_NUM SECTOR_SIZE; do
    [[ "${PLAN[$key]}" =~ ^[0-9]{1,15}$ ]] || die 5 "invalid plan value $key"
  done
  [[ "${PLAN[FINGERPRINT]}" == "$FINGERPRINT" ]] || die 4 "the partition table changed since it was shown: nothing was changed"
  [[ "${PLAN[ESP_PART]}" == "$(part_path "${PLAN[ESP_NUM]}")" ]] || die 5 "unexpected EFI system partition ${PLAN[ESP_PART]}"
  ((PLAN[NEW_SIZE_MIB] >= MIN_ALONGSIDE_MIB)) || die 4 "the Selene OS partition would be smaller than $MIN_ALONGSIDE_MIB MiB"
  [[ -z "$ROOT_SIZE_MIB" ]] || ((PLAN[NEW_SIZE_MIB] == ROOT_SIZE_MIB)) || die 5 "the planned Selene OS partition (${PLAN[NEW_SIZE_MIB]} MiB) is not the size asked ($ROOT_SIZE_MIB MiB)"
  if [[ "${PLAN[KIND]}" == shrink ]]; then
    for key in SHRINK_NUM SHRINK_START SHRINK_OLD_SECTORS SHRINK_NEW_SECTORS SHRINK_NEW_BYTES SHRINK_OLD_MIB SHRINK_NEW_MIB; do
      [[ "${PLAN[$key]:-}" =~ ^[0-9]{1,15}$ ]] || die 5 "invalid plan value $key"
    done
    [[ "${PLAN[SHRINK_PART]:-}" == "$(part_path "${PLAN[SHRINK_NUM]}")" ]] || die 5 "unexpected partition ${PLAN[SHRINK_PART]:-}"
    [[ "${PLAN[SHRINK_FS]:-}" == ntfs || "${PLAN[SHRINK_FS]:-}" == ext4 ]] || die 4 "only NTFS and ext4 partitions can be shrunk"
    ((PLAN[SHRINK_NEW_SECTORS] < PLAN[SHRINK_OLD_SECTORS])) || die 4 "the new size must be smaller than the current one"
    ((PLAN[NEW_START] >= PLAN[SHRINK_START] + PLAN[SHRINK_NEW_SECTORS])) || die 5 "the new partition would overlap the shrunk one"
    [[ "${PLAN[SHRINK_NUM]}" != "${PLAN[ESP_NUM]}" ]] || die 4 "the EFI system partition cannot be shrunk"
  elif [[ "${PLAN[KIND]}" == reuse ]]; then
    [[ "${PLAN[REUSE_NUM]:-}" =~ ^[0-9]{1,3}$ && "${PLAN[REUSE_NUM]}" == "$((10#$REUSE_NUM_ARG))" ]] || die 5 "invalid plan value REUSE_NUM"
    [[ "${PLAN[REUSE_PART]:-}" == "$(part_path "${PLAN[REUSE_NUM]}")" ]] || die 5 "unexpected partition ${PLAN[REUSE_PART]:-}"
    [[ "${PLAN[REUSE_NUM]}" != "${PLAN[ESP_NUM]}" ]] || die 4 "the EFI system partition cannot be reused"
  elif [[ "${PLAN[KIND]}" != free ]]; then
    die 5 "unknown plan kind ${PLAN[KIND]}"
  fi
  # The Linux system whose own boot loader is on the ESP (stage_bootloader_alongside chainloads it).
  if [[ -n "${PLAN[CHAIN_UUID]:-}" ]]; then
    [[ "${PLAN[CHAIN_UUID]}" =~ ^[0-9A-Fa-f-]{4,36}$ && "${PLAN[CHAIN_PART]:-}" =~ ^[0-9]{1,3}$ ]] \
      || { log "warning: unexpected other-system values from aurora-disk-probe: ignored"; PLAN[CHAIN_UUID]="" PLAN[CHAIN_NAME]=""; }
  fi
  P_ESP=${PLAN[ESP_PART]}
  [[ "${PLAN[ESP_HAS_BOOT_DIR]:-1}" == 0 ]] && ESP_OWN_FALLBACK=1
  if [[ "${PLAN[KIND]}" == reuse ]]; then
    log "plan: reuse ${PLAN[REUSE_PART]} (the Selene OS partition an installation that stopped left behind, ${PLAN[NEW_SIZE_MIB]} MiB): formatted again, the partition table is not changed, EFI system partition $P_ESP kept"
  elif [[ "${PLAN[KIND]}" == shrink ]]; then
    log "plan: shrink ${PLAN[SHRINK_PART]} (${PLAN[SHRINK_FS]}) ${PLAN[SHRINK_OLD_MIB]} MiB -> ${PLAN[SHRINK_NEW_MIB]} MiB, new Selene OS partition ${PLAN[NEW_SIZE_MIB]} MiB at sector ${PLAN[NEW_START]}, EFI system partition $P_ESP kept"
  else
    log "plan: new Selene OS partition ${PLAN[NEW_SIZE_MIB]} MiB at sector ${PLAN[NEW_START]} (free space), EFI system partition $P_ESP kept"
  fi
  log "EFI system partition: ${PLAN[ESP_FREE_MIB]:-?} MiB free, removable EFI/BOOT path $( ((ESP_OWN_FALLBACK)) && echo 'installed (the disk has none)' || echo 'left as it is')"
}

# dump_without N...: the sfdisk dump of the disk without the partition lines of numbers N (and its header)
dump_without() {
  local skip=" $* " line n
  while IFS= read -r line; do
    [[ "$line" =~ ^(/dev/[^ ]+)[[:space:]]*: ]] || continue
    n=$(sed -n 's/.*[^0-9]\([0-9][0-9]*\)$/\1/p' <<<"${BASH_REMATCH[1]}")
    [[ "$skip" == *" $n "* ]] && continue
    printf '%s\n' "$line"
  done < <(sfdisk --dump "$DISK")
}
# entry_without_size N < DUMP: partition N's line of an sfdisk dump without its size (start, type, uuid, name, attrs)
entry_without_size() {
  local line n
  while IFS= read -r line; do
    [[ "$line" =~ ^(/dev/[^ ]+)[[:space:]]*: ]] || continue
    n=$(sed -n 's/.*[^0-9]\([0-9][0-9]*\)$/\1/p' <<<"${BASH_REMATCH[1]}")
    [[ "$n" == "$1" ]] || continue
    sed -E 's/size= *[0-9]+, *//' <<<"$line"
  done
}
wait_for_node() { # wait_for_node DEV EXPECTED_BYTES
  local i
  udevadm settle --timeout=10 >/dev/null 2>&1 || true
  for ((i = 0; i < 100; i++)); do
    [[ -b "$1" && "$(blockdev --getsize64 "$1" 2>/dev/null)" == "$2" ]] && return 0
    ((i == 20 || i == 60)) && partx -u "$DISK" >/dev/null 2>&1
    sleep 0.1
  done
  die 5 "the partition $1 did not appear with its new size"
}

shrink_ntfs() {
  local dev=${PLAN[SHRINK_PART]} bytes=${PLAN[SHRINK_NEW_BYTES]} out
  # Hibernation / Fast Startup: ntfsresize does not refuse it by itself (checked again here, right before).
  local hdr; hdr=$(ntfscat "$dev" hiberfil.sys 2>/dev/null | head -c 4 | od -An -tx1 | tr -d ' \n' || true)
  if [[ -n "$hdr" && "$hdr" != 00000000 && "$hdr" != 77616b65 && "$hdr" != 57414b45 ]]; then
    die 4 "Windows is hibernated or uses Fast Startup: turn off Fast Startup in Windows and shut it down fully, then try again (nothing was changed)"
  fi
  # Marked for a check (by Windows, or by an earlier ntfsresize): refused. --force would skip this check
  # silently, so it is made here without it (read-only).
  out=$(ntfsresize --info --no-progress-bar "$dev" </dev/null 2>&1 || true)
  if has_text 'scheduled for check' "$out"; then
    die 4 "Windows must check this partition first: start Windows (twice if needed), shut it down fully, then try again (nothing was changed). After an installation that stopped once the partition was shrunk, this is expected: Windows checks the disk (chkdsk) at its next start, once"
  fi
  # One --force only: it skips the interactive question. (A second one would also skip the dirty-volume check.)
  log "\$ ntfsresize --no-action --size $bytes $dev"
  out=$(ntfsresize --no-action --force --no-progress-bar --size "$bytes" "$dev" </dev/null 2>&1) \
    || { printf '%s\n' "$out" >&2; die 4 "Windows' partition cannot be shrunk safely (ntfsresize test run failed; nothing was changed): start Windows, run a disk check, shut it down fully and try again"; }
  printf '%s\n' "$out" | tail -n 3 >&2
  progress partition 2 ""
  log "\$ ntfsresize --size $bytes $dev"
  bg_wait ntfsresize --force --no-progress-bar --size "$bytes" "$dev" </dev/null >&2 \
    || die 5 "shrinking the Windows partition failed (ntfsresize); the partition table was not changed"
  local now
  now=$(ntfsresize --info --force --no-progress-bar "$dev" 2>/dev/null | sed -n 's/^Current volume size: *\([0-9]*\) bytes.*/\1/p')
  [[ "$now" =~ ^[0-9]+$ ]] && ((now <= bytes)) || die 5 "the NTFS file system is not smaller than $bytes bytes after ntfsresize (${now:-unknown}); the partition table was not changed"
  log "NTFS file system now $now bytes (Windows checks the disk once at its next start)"
}
shrink_ext4() {
  local dev=${PLAN[SHRINK_PART]} bytes=${PLAN[SHRINK_NEW_BYTES]} rc=0
  log "\$ e2fsck -f -p $dev"
  bg_wait e2fsck -f -p "$dev" >&2 || rc=$?
  ((rc <= 1)) || die 4 "the ext4 partition $dev has errors e2fsck cannot fix by itself (exit $rc): check it from its own system, then try again (nothing was changed)"
  progress partition 2 ""
  log "\$ resize2fs $dev $((bytes / 1024))K"
  bg_wait resize2fs "$dev" "$((bytes / 1024))K" >&2 || die 5 "shrinking the ext4 partition failed (resize2fs); the partition table was not changed"
  local bc bs
  bc=$(dumpe2fs -h "$dev" 2>/dev/null | sed -n 's/^Block count: *//p') bs=$(dumpe2fs -h "$dev" 2>/dev/null | sed -n 's/^Block size: *//p')
  [[ "$bc" =~ ^[0-9]+$ && "$bs" =~ ^[0-9]+$ ]] && ((bc * bs <= bytes)) || die 5 "the ext4 file system is not smaller than $bytes bytes after resize2fs; the partition table was not changed"
  e2fsck -f -n "$dev" >&2 || die 5 "the ext4 file system reports errors after resize2fs; the partition table was not changed"
  log "ext4 file system now $((bc * bs)) bytes"
}

stage_partition_alongside() {
  maybe_fail partition
  progress partition 1 "Preparing the disk (your files are kept)"
  local before="$WORKDIR/partitions-before.sfdisk" others_before others_after new_num=""
  sfdisk --dump "$DISK" >"$before" || die 5 "cannot read the partition table of $DISK"
  log "partition table before the change (restore with: sfdisk $DISK < this dump):"; cat "$before" >&2
  [[ "$(sha256sum <"$before" | cut -d' ' -f1)" == "$FINGERPRINT" ]] || die 4 "the partition table changed since it was shown: nothing was changed"
  if [[ "${PLAN[KIND]}" == reuse ]]; then reuse_partition_alongside "$before"; return 0; fi
  others_before=$(dump_without ${PLAN[SHRINK_NUM]:-})
  local shrunk_before="" shrunk_after=""
  [[ "${PLAN[KIND]}" == shrink ]] && shrunk_before=$(entry_without_size "${PLAN[SHRINK_NUM]}" <"$before")
  if [[ "${PLAN[KIND]}" == shrink ]]; then
    maybe_fail shrink
    local slow=""; [[ "${PLAN[SHRINK_FS]}" == ext4 ]] && slow="; this can take from a few minutes to an hour, depending on the data"
    progress partition 1 "Shrinking ${PLAN[SHRINK_PART]} from ${PLAN[SHRINK_OLD_MIB]} MiB to ${PLAN[SHRINK_NEW_MIB]} MiB (your files are kept$slow)"
    findmnt -rn -S "${PLAN[SHRINK_PART]}" >/dev/null 2>&1 && die 4 "${PLAN[SHRINK_PART]} is mounted: nothing was changed"
    case "${PLAN[SHRINK_FS]}" in
      ntfs) shrink_ntfs ;;
      ext4) shrink_ext4 ;;
    esac
    # The file system is smaller now; the table must still be the one that was shown.
    [[ "$(pt_fingerprint)" == "$FINGERPRINT" ]] || die 5 "the partition table changed during the shrink: stopped before writing it"
    progress partition 3 "Updating the partition table"
    log "\$ sfdisk -N ${PLAN[SHRINK_NUM]} $DISK (start=${PLAN[SHRINK_START]}, size=${PLAN[SHRINK_NEW_SECTORS]})"
    printf 'start=%s, size=%s\n' "${PLAN[SHRINK_START]}" "${PLAN[SHRINK_NEW_SECTORS]}" \
      | sfdisk --quiet --no-reread --wipe never --wipe-partitions never -N "${PLAN[SHRINK_NUM]}" "$DISK" >&2 \
      || die 5 "could not shrink partition ${PLAN[SHRINK_NUM]} in the partition table (its file system is already smaller: nothing is lost)"
    partx -u "$DISK" >/dev/null 2>&1 || true
    wait_for_node "${PLAN[SHRINK_PART]}" "${PLAN[SHRINK_NEW_BYTES]}"
    # The shrunk entry keeps its start, type, UUID, name and attributes (Windows' boot configuration names it).
    shrunk_after=$(entry_without_size "${PLAN[SHRINK_NUM]}" < <(sfdisk --dump "$DISK"))
    [[ -n "$shrunk_before" && "$shrunk_after" == "$shrunk_before" ]] \
      || die 5 "partition ${PLAN[SHRINK_NUM]} changed more than its size (before: $shrunk_before; after: $shrunk_after)"
  fi
  progress partition 3 "Creating the Selene OS partition"
  log "\$ sfdisk --append $DISK (start=${PLAN[NEW_START]}, size=${PLAN[NEW_SECTORS]}, Selene OS)"
  printf 'start=%s, size=%s, type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, name="Selene OS"\n' "${PLAN[NEW_START]}" "${PLAN[NEW_SECTORS]}" \
    | sfdisk --quiet --no-reread --wipe never --wipe-partitions never --append "$DISK" >&2 \
    || die 5 "could not create the Selene OS partition"
  partx -u "$DISK" >/dev/null 2>&1 || partx -a "$DISK" >/dev/null 2>&1 || true
  # The new partition: the entry that starts at NEW_START.
  local line node
  while IFS= read -r line; do
    [[ "$line" =~ ^(/dev/[^ ]+)[[:space:]]*:[[:space:]]*start=[[:space:]]*([0-9]+), ]] || continue
    if [[ "${BASH_REMATCH[2]}" == "${PLAN[NEW_START]}" ]]; then node=${BASH_REMATCH[1]}; break; fi
  done < <(sfdisk --dump "$DISK")
  [[ -n "${node:-}" ]] || die 5 "the new partition is not in the partition table"
  new_num=$(sed -n 's/.*[^0-9]\([0-9][0-9]*\)$/\1/p' <<<"$node")
  P_ROOT=$(part_path "$new_num")
  [[ "$P_ROOT" == "$node" ]] || die 5 "unexpected partition name $node"
  # Every other partition is exactly as before (start, size, type, UUID, name).
  others_after=$(dump_without ${PLAN[SHRINK_NUM]:-} "$new_num")
  [[ "$others_after" == "$others_before" ]] || { diff <(echo "$others_before") <(echo "$others_after") >&2 || true; die 5 "another partition changed unexpectedly (see the log)"; }
  sfdisk --verify "$DISK" >&2 || die 5 "the partition table does not verify after the change"
  wait_for_node "$P_ROOT" "$((PLAN[NEW_SECTORS] * PLAN[SECTOR_SIZE]))"
  # The kernel's node is the partition just created (same start), not a stale one: only then it is formatted.
  local kstart; kstart=$(cat "/sys/class/block/${P_ROOT#/dev/}/start" 2>/dev/null || echo -1)
  [[ "$kstart" =~ ^[0-9]+$ ]] && ((kstart * 512 == PLAN[NEW_START] * PLAN[SECTOR_SIZE])) \
    || die 5 "the kernel does not show $P_ROOT at sector ${PLAN[NEW_START]} (start: $kstart): nothing was formatted"
  P_BIOS=""
  sfdisk --dump "$DISK" >&2 || true
  progress partition 4 ""
}

# --reuse-partition: the « Selene OS » partition an installation that stopped left behind is formatted again; the
# partition table is not written. Checked once more right here: same entry (start, size, Linux type, name « Selene OS »),
# not mounted, and either no file system or the ext4 « AURORA » (aurora-disk-probe checked the completion marker).
reuse_partition_alongside() {
  local before=$1 line entry="" fstype label
  P_ROOT=${PLAN[REUSE_PART]}
  progress partition 2 "Reusing the Selene OS partition of the previous attempt ($P_ROOT; nothing else changes)"
  while IFS= read -r line; do
    [[ "$line" =~ ^(/dev/[^ ]+)[[:space:]]*: && "${BASH_REMATCH[1]}" == "$P_ROOT" ]] && entry=$line
  done <"$before"
  [[ -n "$entry" && "$entry" =~ start=\ *${PLAN[NEW_START]}, && "$entry" =~ size=\ *${PLAN[NEW_SECTORS]}, \
     && "${entry^^}" == *"TYPE=0FC63DAF-8483-4772-8E79-3D69D8477DE4"* && "$entry" == *'name="Selene OS"'* ]] \
    || die 4 "$P_ROOT is not the Selene OS partition of an installation that stopped: nothing was changed"
  findmnt -rn -S "$P_ROOT" >/dev/null 2>&1 && die 4 "$P_ROOT is mounted: nothing was changed"
  fstype=$(blkid -p -s TYPE -o value "$P_ROOT" 2>/dev/null || true) label=$(blkid -p -s LABEL -o value "$P_ROOT" 2>/dev/null || true)
  [[ -z "$fstype" || ( "$fstype" == ext4 && "$label" == AURORA ) ]] \
    || die 4 "$P_ROOT holds a $fstype file system that is not Selene OS's: nothing was changed"
  wait_for_node "$P_ROOT" "$((PLAN[NEW_SECTORS] * PLAN[SECTOR_SIZE]))"
  local kstart; kstart=$(cat "/sys/class/block/${P_ROOT#/dev/}/start" 2>/dev/null || echo -1)
  [[ "$kstart" =~ ^[0-9]+$ ]] && ((kstart * 512 == PLAN[NEW_START] * PLAN[SECTOR_SIZE])) \
    || die 5 "the kernel does not show $P_ROOT at sector ${PLAN[NEW_START]} (start: $kstart): nothing was formatted"
  P_BIOS=""
  log "reusing $P_ROOT (${PLAN[NEW_SIZE_MIB]} MiB, left by an installation that stopped); the partition table is not changed"
  progress partition 4 ""
}

stage_format_alongside() {
  maybe_fail format
  progress format 4 "Formatting the Selene OS partition"
  wipefs --all --force --quiet "$P_ROOT" >/dev/null 2>&1 || true
  run "could not format the system partition" mkfs.ext4 -F -q -L AURORA "$P_ROOT"
  udevadm settle --timeout=10 >/dev/null 2>&1 || true
  ROOT_UUID=$(blkid -p -s UUID -o value "$P_ROOT" 2>/dev/null || blkid -s UUID -o value "$P_ROOT")
  ESP_UUID=$(blkid -p -s UUID -o value "$P_ESP" 2>/dev/null || blkid -s UUID -o value "$P_ESP")
  [[ -n "$ROOT_UUID" && -n "$ESP_UUID" ]] || die 5 "could not read the UUIDs of the file systems"
  [[ "$(blkid -p -s TYPE -o value "$P_ESP" 2>/dev/null)" == vfat ]] || die 5 "the EFI system partition $P_ESP is not a FAT file system"
  log "root $P_ROOT UUID=$ROOT_UUID (new), ESP $P_ESP UUID=$ESP_UUID (kept)"
  ensure_uuid_link "$ROOT_UUID" "$P_ROOT"
  ensure_uuid_link "$ESP_UUID" "$P_ESP"
  mkdir -p "$TARGET"
  run "could not mount the system partition" mount -t ext4 "$P_ROOT" "$TARGET"
  progress format 7 ""
}

# esp_snapshot OUT: sha256 of every file of the EFI system partition outside the folders Selene OS writes
# (EFI/ubuntu, and EFI/BOOT when the disk had none): compared before and after the boot loader is written.
esp_snapshot() {
  local out=$1 dir excl='^[0-9a-f]+  \./efi/ubuntu/'
  ((ESP_OWN_FALLBACK)) && excl='^[0-9a-f]+  \./efi/(ubuntu|boot)/'
  if [[ "$ESP_MODE" == mount ]]; then
    dir=$TARGET/boot/efi
  else
    dir=$WORKDIR/esp-snapshot
    rm -rf "$dir"; mkdir -p "$dir"
    MTOOLS_SKIP_CHECK=1 mcopy -s -n -m -Q -i "$P_ESP" '::*' "$dir/" >/dev/null 2>&1 || { rm -rf "$dir"; return 1; }
  fi
  (cd "$dir" && find . -type f -print0 | LC_ALL=C sort -z | xargs -0r sha256sum) | awk -v r="$excl" 'tolower($0) !~ r' >"$out"
  [[ "$ESP_MODE" == mount ]] || rm -rf "$dir"
  return 0
}

# ------------------------------------------------------------------ shared EFI system partition safety net (--alongside)
# Right before the boot loader stage, the whole EFI system partition (small: it only holds boot files) is copied to a
# root-only folder under /run (esp_backup). When a file of another system (anything outside EFI/ubuntu, and EFI/BOOT
# when the disk had none) changed during the boot loader stage, or when the installation fails after that stage
# started, the partition is put back exactly as it was (esp_restore: every file byte for byte, the files and folders
# added — EFI/ubuntu when it did not exist before — removed) and the « Selene » firmware entry this run added is
# deleted again (esp_rollback, from cleanup), so that the other systems start as before and a retry is possible.
ESP_BACKUP="" ESP_ROLLBACK=0 ESP_DIR="" ESP_TMP_MNT="" BOOTENTRY_ADDED="" BOOTORDER_BEFORE=""
esp_open() { # ESP_DIR = the mounted partition, or "" (written with mtools: this kernel cannot mount FAT)
  ESP_DIR=""
  if [[ "$ESP_MODE" == mount ]]; then
    if mountpoint -q "$TARGET/boot/efi"; then ESP_DIR=$TARGET/boot/efi; return 0; fi
    ESP_TMP_MNT=$(mktemp -d /run/aurora-esp-mnt.XXXXXX) || return 1
    mount -t vfat -o umask=0077 "$P_ESP" "$ESP_TMP_MNT" || { rmdir "$ESP_TMP_MNT"; ESP_TMP_MNT=""; return 1; }
    ESP_DIR=$ESP_TMP_MNT; return 0
  fi
  [[ -z "$(findmnt -rn -t vfat -S "$P_ESP" -o TARGET 2>/dev/null)" ]] || { log "the EFI system partition is mounted elsewhere"; return 1; }
  command -v mcopy >/dev/null 2>&1
}
esp_close() {
  if [[ -n "$ESP_TMP_MNT" ]]; then
    umount "$ESP_TMP_MNT" 2>/dev/null || umount -l "$ESP_TMP_MNT" 2>/dev/null || true
    rmdir "$ESP_TMP_MNT" 2>/dev/null || true
    ESP_TMP_MNT=""
  fi
  ESP_DIR=""
}
esp_m() { MTOOLS_SKIP_CHECK=1 "$@"; }   # mtools on $P_ESP (never while it is mounted as vfat: see esp_open)
esp_dump() { # esp_dump DIR: copy of every file and folder of the partition into the empty folder DIR
  if [[ -n "$ESP_DIR" ]]; then cp -r --preserve=timestamps "$ESP_DIR"/. "$1"/
  else esp_m mcopy -s -n -m -Q -i "$P_ESP" '::*' "$1"/ >/dev/null 2>&1; fi
}
esp_files() { (cd "$1" && find . -type f -print0 | LC_ALL=C sort -z | xargs -0r sha256sum); }   # "sha256  ./path"
esp_dirs() { (cd "$1" && find . -mindepth 1 -type d | LC_ALL=C sort); }
esp_backup() {
  local d; d=$(mktemp -d /run/aurora-esp-backup.XXXXXX) || die 5 "could not prepare the copy of the EFI system partition in /run: nothing was written to it"
  chmod 0700 "$d"; mkdir -m 0700 "$d/files"
  ESP_BACKUP=$d
  if ! esp_open || ! esp_dump "$d/files"; then
    esp_close; rm -rf "$d"; ESP_BACKUP=""
    die 5 "could not copy the EFI system partition to /run before writing the boot loader (not enough memory?): nothing was written to it"
  fi
  esp_close
  esp_files "$d/files" >"$d/files.sha256"; esp_dirs "$d/files" >"$d/dirs"
  ESP_ROLLBACK=1
  log "EFI system partition copied to $d ($(wc -l <"$d/files.sha256") files, $(du -sh "$d/files" | cut -f1)); put back if the boot loader stage changes a file of another system or fails"
}
esp_restore() { # the partition exactly as in ESP_BACKUP (file contents byte for byte, files and folders added removed)
  # FAT names are case-insensitive: paths are compared in lower case (a file written as EFI/BOOT/BOOTX64.EFI over
  # EFI/Boot/bootx64.efi is the same file). 0 = put back and checked again from the partition.
  [[ -n "$ESP_BACKUP" && -s "$ESP_BACKUP/files.sha256" ]] || return 1
  local cur f line ok=0 p seg s
  local -A have=() keep=() keepd=()
  esp_open || return 1
  cur=$ESP_DIR
  if [[ -z "$cur" ]]; then cur=$ESP_BACKUP/now; rm -rf "$cur"; mkdir "$cur"; esp_dump "$cur" || { esp_close; return 1; }; fi
  while IFS= read -r line; do have[${line,,}]=1; done < <(esp_files "$cur")
  while IFS= read -r line; do   # files missing or different: copied back
    f=${line#*  }; keep[${f,,}]=1
    [[ -n "${have[${line,,}]:-}" ]] && continue
    log "restoring ${f#./} on the EFI system partition"
    if [[ -n "$ESP_DIR" ]]; then
      { mkdir -p "$(dirname "$ESP_DIR/$f")" && cp --preserve=timestamps "$ESP_BACKUP/files/$f" "$ESP_DIR/$f"; } || ok=1
    else
      p=""; IFS=/ read -r -a seg <<<"$(dirname "${f#./}")"
      for s in "${seg[@]}"; do [[ -z "$s" || "$s" == . ]] && continue; p+=/$s; esp_m mmd -i "$P_ESP" "::$p" >/dev/null 2>&1 || true; done
      esp_m mcopy -o -m -Q -i "$P_ESP" "$ESP_BACKUP/files/$f" "::/${f#./}" >/dev/null 2>&1 || ok=1
    fi
  done <"$ESP_BACKUP/files.sha256"
  while IFS= read -r line; do   # files that were not there: removed
    f=${line#*  }
    [[ -n "${keep[${f,,}]:-}" ]] && continue
    log "removing ${f#./} from the EFI system partition"
    if [[ -n "$ESP_DIR" ]]; then rm -f "$ESP_DIR/$f" || ok=1; else esp_m mdel -i "$P_ESP" "::/${f#./}" >/dev/null 2>&1 || ok=1; fi
  done < <(esp_files "$cur")
  while IFS= read -r f; do keepd[${f,,}]=1; done <"$ESP_BACKUP/dirs"
  while IFS= read -r f; do   # folders that were not there (EFI/ubuntu, …): deepest first
    [[ -n "${keepd[${f,,}]:-}" ]] && continue
    if [[ -n "$ESP_DIR" ]]; then rmdir "$ESP_DIR/$f" 2>/dev/null || ok=1; else esp_m mrd -i "$P_ESP" "::/${f#./}" >/dev/null 2>&1 || ok=1; fi
  done < <(esp_dirs "$cur" | LC_ALL=C sort -r)
  # Checked again from the partition itself.
  if [[ -z "$ESP_DIR" ]]; then rm -rf "$cur"; mkdir "$cur"; esp_dump "$cur" || ok=1; fi
  [[ "$(esp_files "$cur" | tr 'A-Z' 'a-z' | LC_ALL=C sort)" == "$(tr 'A-Z' 'a-z' <"$ESP_BACKUP/files.sha256" | LC_ALL=C sort)" ]] || ok=1
  [[ "$(esp_dirs "$cur" | tr 'A-Z' 'a-z' | LC_ALL=C sort)" == "$(tr 'A-Z' 'a-z' <"$ESP_BACKUP/dirs" | LC_ALL=C sort)" ]] || ok=1
  if [[ -n "$ESP_DIR" ]]; then sync -f "$ESP_DIR/." 2>/dev/null || true; else rm -rf "$cur"; fi
  esp_close
  return "$ok"
}
# esp_rollback (cleanup, failed run): the « Selene » firmware entry added by this run removed, the boot order and the
# EFI system partition put back as they were before the boot loader stage.
esp_rollback() {
  ((ESP_ROLLBACK)) || return 0
  ESP_ROLLBACK=0
  log "the installation stopped after the boot loader stage started: putting the boot files and the firmware boot entries back as they were"
  if [[ -n "$BOOTENTRY_ADDED" ]]; then
    if efibootmgr -q -b "$BOOTENTRY_ADDED" -B >&2 2>&1; then log "firmware boot entry Boot$BOOTENTRY_ADDED « Selene » removed"
    else log "warning: could not remove the firmware boot entry Boot$BOOTENTRY_ADDED « Selene »"; fi
    if [[ -n "$BOOTORDER_BEFORE" ]]; then
      efibootmgr -q --bootorder "$BOOTORDER_BEFORE" >&2 2>&1 || log "warning: could not set the boot order back to $BOOTORDER_BEFORE"
    fi
    BOOTENTRY_ADDED=""
  fi
  if esp_restore; then
    log "EFI system partition: exactly as before the installation (checked file by file)"
    rm -rf "$ESP_BACKUP"; ESP_BACKUP=""
  else
    log "WARNING: the EFI system partition could not be put back exactly as before; its copy is in $ESP_BACKUP (root only; lost at restart: copy it to a USB drive)"
  fi
}
# test_tamper_esp (tools/test-alongside.sh only, test mode): a grub-install that replaced another system's removable
# EFI/BOOT/BOOTX64.EFI and added EFI/BOOT/fbx64.efi anyway, written on the partition itself.
test_tamper_esp() {
  local junk="$WORKDIR/tamper.efi"
  head -c 4096 /dev/urandom >"$junk"
  esp_open || die 5 "test: cannot open the EFI system partition"
  log "TEST: replacing EFI/BOOT/BOOTX64.EFI and adding EFI/BOOT/fbx64.efi on the EFI system partition"
  if [[ -n "$ESP_DIR" ]]; then mkdir -p "$ESP_DIR/EFI/BOOT"; cp "$junk" "$ESP_DIR/EFI/BOOT/BOOTX64.EFI"; cp "$junk" "$ESP_DIR/EFI/BOOT/fbx64.efi"
  else esp_m mcopy -o -Q -i "$P_ESP" "$junk" ::/EFI/BOOT/BOOTX64.EFI >/dev/null 2>&1; esp_m mcopy -o -Q -i "$P_ESP" "$junk" ::/EFI/BOOT/fbx64.efi >/dev/null 2>&1; fi
  esp_close; rm -f "$junk"
}

# GRUB updates on the installed system (grub-multi-install, run by the grub-efi-amd64 / shim packages, calls
# grub-install through PATH) must never replace another system's removable EFI/BOOT/BOOTX64.EFI: next to a system that
# has one, /usr/local/sbin/grub-install adds --no-extra-removable to every x86_64-efi install (and drops
# --force-extra-removable). Only written by an installation « à côté » on a disk with an EFI/BOOT folder.
write_grub_wrapper() {
  mkdir -p "$TARGET/usr/local/sbin"
  write_file "$TARGET/usr/local/sbin/grub-install" 0755 <<'EOF'
#!/bin/sh
# Selene OS was installed next to another system that boots through the removable path EFI/BOOT/BOOTX64.EFI of the
# shared EFI system partition. GRUB updates call grub-install through PATH: this wrapper (written by the Selene OS
# installer) adds --no-extra-removable to every UEFI (x86_64-efi) installation so that they never replace that file.
real=/usr/sbin/grub-install
target="" prev=""
for a in "$@"; do
  case "$a" in --target=*) target=${a#--target=} ;; esac
  [ "$prev" = --target ] && target=$a
  prev=$a
done
[ -z "$target" ] && [ -d /sys/firmware/efi ] && target=x86_64-efi
if [ "$target" = x86_64-efi ]; then
  for a in "$@"; do
    shift
    [ "$a" = --force-extra-removable ] || set -- "$@" "$a"
  done
  exec "$real" "$@" --no-extra-removable
fi
exec "$real" "$@"
EOF
  log "GRUB updates: /usr/local/sbin/grub-install adds --no-extra-removable (another system boots through EFI/BOOT)"
}

# GRUB entries that start the other systems' OWN EFI boot loaders (Limine, systemd-boot, rEFInd, another distribution's
# GRUB), so the person gets the menu they know: os-prober does not know Limine, and its linux-boot-prober builds fragile
# entries for a Linux whose kernels live on the ESP. Source of truth: the firmware's boot entries on this ESP, read
# before « Selene » is added (efibootmgr -v; test mode: AURORA_INSTALL_TEST_EFIBOOTMGR_V=<file>, only with
# AURORA_INSTALL_TEST_NO_FIRMWARE=1), else the known loader paths of the ESP (aurora-disk-probe --chainload, on the copy
# esp_backup just made). Title: the other Linux's PRETTY_NAME (the plan's CHAIN_NAME), else the firmware label. Its
# partition goes to GRUB_OS_PROBER_SKIP_LIST: one clean entry. Written as /etc/aurora/boot-chainload.list (read by
# /etc/grub.d/25_aurora_chainload at every update-grub). Never fatal: without it the menu is os-prober's.
CHAIN_ENTRIES=0 CHAIN_SKIP_UUID=""
write_chainload_entries() {
  local nv="$WORKDIR/efibootmgr-v.txt" partuuid out path title named list="" re_path='^/EFI/[A-Za-z0-9._+-]{1,64}(/[A-Za-z0-9._+-]{1,64}){1,3}$'
  : >"$nv"
  if ((TEST_NO_FIRMWARE)); then
    if [[ -n "${AURORA_INSTALL_TEST_EFIBOOTMGR_V:-}" && -f "${AURORA_INSTALL_TEST_EFIBOOTMGR_V}" ]]; then
      head -c 1048576 "$AURORA_INSTALL_TEST_EFIBOOTMGR_V" >"$nv"
      log "test mode: firmware boot entries read from $AURORA_INSTALL_TEST_EFIBOOTMGR_V"
    fi
  elif command -v efibootmgr >/dev/null 2>&1; then
    efibootmgr -v >"$nv" 2>/dev/null || log "warning: efibootmgr -v failed: the known boot loader paths of the EFI system partition are used"
  fi
  [[ -s "$nv" ]] && { log "firmware boot entries before « Selene » is added:"; grep -E '^Boot(Order|[0-9A-Fa-f]{4})' "$nv" | cut -c1-200 >&2 || true; }
  partuuid=$(blkid -p -s PART_ENTRY_UUID -o value "$P_ESP" 2>/dev/null || true)
  [[ "$partuuid" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]] \
    || { log "warning: no PARTUUID for $P_ESP: the other systems' boot loaders are not chainloaded"; return 0; }
  [[ "$ESP_UUID" =~ ^[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}$ && -n "$ESP_BACKUP" && -d "$ESP_BACKUP/files" ]] || return 0
  local args=(--chainload "$ESP_BACKUP/files" --esp-partuuid "$partuuid" --efibootmgr "$nv")
  [[ -n "${PLAN[CHAIN_NAME]:-}" ]] && args+=(--name "${PLAN[CHAIN_NAME]}")
  [[ -n "${PLAN[CHAIN_ID]:-}" ]] && args+=(--os-id "${PLAN[CHAIN_ID]}")
  out=$("$PROBE" "${args[@]}" 2>"$WORKDIR/chain.err") || { cat "$WORKDIR/chain.err" >&2; log "warning: aurora-disk-probe --chainload failed: no chainload entries"; return 0; }
  while IFS=$'\t' read -r path title named; do
    [[ -n "$path" ]] || continue
    if [[ ! "$path" =~ $re_path || ! "${path,,}" =~ \.efi$ || ! "$title" =~ $RE_MENU_NAME || ! "$named" =~ ^[01]$ ]]; then
      log "warning: unexpected chainload entry from aurora-disk-probe: skipped"; continue
    fi
    list+="$ESP_UUID"$'\t'"$path"$'\t'"$title"$'\n'
    CHAIN_ENTRIES=$((CHAIN_ENTRIES + 1))
    log "boot menu: « $title » starts its own boot loader $path (EFI system partition $ESP_UUID)"
    if [[ "$named" == 1 && -n "${PLAN[CHAIN_UUID]:-}" ]]; then CHAIN_SKIP_UUID=${PLAN[CHAIN_UUID]}; fi
  done <<<"$out"
  if ((!CHAIN_ENTRIES)); then log "no other boot loader to chainload on the EFI system partition (Windows: os-prober)"; return 0; fi
  { printf '# Written by the Selene OS installer: the other systems of this computer, started through their own boot loader\n'
    printf '# by /etc/grub.d/25_aurora_chainload (run sudo update-grub after a change). ESP_FS_UUID<TAB>/EFI/path.efi<TAB>Title\n'
    printf '%s' "$list"; } | write_file "$TARGET/etc/aurora/boot-chainload.list" 0644
  write_file "$TARGET/etc/grub.d/25_aurora_chainload" 0755 <<'EOF'
#!/bin/sh
# Selene OS (written by its installer next to another system): one GRUB menu entry per line of
# /etc/aurora/boot-chainload.list (ESP_FS_UUID<TAB>/EFI/…/loader.efi<TAB>Title). Each entry starts that system's OWN
# boot loader (chainloader), so it boots exactly as it does on its own (Limine, systemd-boot, rEFInd, GRUB…).
# Every field is checked again here: a line that does not match is skipped. When that EFI system partition is mounted
# (FAT) on /boot/efi and the loader is gone (that system was removed), its entry is left out. (The installer stages
# /boot/efi on a tmpfs when the live kernel cannot mount FAT: no check then.)
set -e
list=/etc/aurora/boot-chainload.list
[ -r "$list" ] || exit 0
tab=$(printf '\t')
n=0
while IFS="$tab" read -r uuid path title; do
  case "$uuid" in ''|'#'*) continue ;; esac
  if ! printf '%s\n' "$uuid" | grep -Eqx '[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}|[0-9A-Fa-f-]{8,36}' \
    || ! printf '%s\n' "$path" | grep -Eqx '/EFI/[A-Za-z0-9._+-]{1,64}(/[A-Za-z0-9._+-]{1,64}){1,3}' \
    || ! printf '%s\n' "$path" | grep -Eqi '\.efi$' \
    || ! printf '%s\n' "$title" | grep -Eqx '[A-Za-z0-9][A-Za-z0-9 ._+(),/-]{0,63}'; then
    echo "25_aurora_chainload: invalid line in $list skipped" >&2
    continue
  fi
  if [ "$(stat -f -c %T /boot/efi 2>/dev/null || true)" = msdos ] && [ "$(grub-probe --target=fs_uuid /boot/efi 2>/dev/null || true)" = "$uuid" ] \
    && [ ! -e "/boot/efi$path" ]; then
    echo "25_aurora_chainload: $path is no longer on the EFI system partition: $title left out" >&2
    continue
  fi
  n=$((n + 1))
  echo "Found $title (its own boot loader $path)" >&2
  cat <<ENTRY
menuentry '$title' --class os --class efi \$menuentry_id_option 'aurora-chainload-$n' {
	insmod part_gpt
	insmod fat
	insmod chain
	search --no-floppy --fs-uuid --set=root $uuid
	chainloader $path
}
ENTRY
done <"$list"
EOF
  if [[ -n "$CHAIN_SKIP_UUID" ]]; then
    write_file "$TARGET/etc/default/grub.d/51-aurora-chainload.cfg" 0644 <<EOF
# Written by the Selene OS installer: ${PLAN[CHAIN_NAME]:-the other Linux} starts through its own boot loader
# (/etc/grub.d/25_aurora_chainload), so os-prober must not add a second entry for its partition (file system UUID below).
# GRUB's 30_os-prober compares « UUID@/dev/<partition> » for a Linux partition (\${DEVICE#*@} is the whole device name
# when it has no @), so the partition's current name is looked up at every update-grub; the bare UUID is kept as well.
_aurora_skip=$CHAIN_SKIP_UUID
_aurora_dev=\$(blkid -U "\$_aurora_skip" 2>/dev/null || true)
case "\$_aurora_dev" in /dev/*) ;; *) _aurora_dev="" ;; esac
GRUB_OS_PROBER_SKIP_LIST="\${GRUB_OS_PROBER_SKIP_LIST:+\$GRUB_OS_PROBER_SKIP_LIST }\$_aurora_skip\${_aurora_dev:+ \$_aurora_skip@\$_aurora_dev}"
unset _aurora_skip _aurora_dev
EOF
    log "os-prober skips partition ${PLAN[CHAIN_PART]:-?} (UUID $CHAIN_SKIP_UUID): « ${PLAN[CHAIN_NAME]:-} » is started by its own boot loader"
  fi
}

# add_boot_entry: firmware boot entry « Selene » (shim) first in BootOrder. Never fatal: reported with emit_bootentry.
add_boot_entry() {
  if ((TEST_NO_FIRMWARE)); then emit_bootentry skipped "test mode: no firmware boot entry"; return 0; fi
  command -v efibootmgr >/dev/null 2>&1 || { emit_bootentry failed "efibootmgr is not installed"; return 0; }
  local loader='\EFI\ubuntu\shimx64.efi' partuuid out num order line
  [[ -s "$TARGET/boot/efi/EFI/ubuntu/shimx64.efi" || "$ESP_MODE" != mount ]] || loader='\EFI\ubuntu\grubx64.efi'
  partuuid=$(blkid -p -s PART_ENTRY_UUID -o value "$P_ESP" 2>/dev/null | tr 'A-F' 'a-f')
  # An entry « Selene » left on this same EFI system partition by an earlier attempt is replaced.
  while IFS= read -r line; do
    if [[ "$line" =~ ^Boot([0-9A-Fa-f]{4})\*?[[:space:]]+Selene[[:space:]] ]] && [[ -n "$partuuid" && "${line,,}" == *"$partuuid"* ]]; then
      log "\$ efibootmgr -b ${BASH_REMATCH[1]} -B (earlier « Selene » entry)"
      efibootmgr -q -b "${BASH_REMATCH[1]}" -B >&2 2>&1 || log "warning: could not remove the earlier entry Boot${BASH_REMATCH[1]}"
    fi
  done < <(efibootmgr -v 2>/dev/null || true)
  BOOTORDER_BEFORE=$(efibootmgr 2>/dev/null | sed -n 's/^BootOrder: *//p' || true)
  log "\$ efibootmgr --create --disk $DISK --part ${PLAN[ESP_NUM]} --label Selene --loader $loader"
  if ! out=$(efibootmgr --create --disk "$DISK" --part "${PLAN[ESP_NUM]}" --label Selene --loader "$loader" 2>&1); then
    printf '%s\n' "$out" >&2
    emit_bootentry failed "the computer refused the new boot entry (efibootmgr): choose « Selene » or the disk in its boot menu"
    return 0
  fi
  printf '%s\n' "$out" >&2
  num=$(sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\)\*\{0,1\}[[:space:]]\{1,\}Selene\([[:space:]].*\)\{0,1\}$/\1/p' <<<"$out" | tail -n1)
  order=$(sed -n 's/^BootOrder: *//p' <<<"$out")
  if [[ -z "$num" ]]; then emit_bootentry failed "the new boot entry was not found after efibootmgr --create"; return 0; fi
  BOOTENTRY_ADDED=$num   # removed again if the installation fails after this (esp_rollback)
  if [[ "$order" != "$num"* ]]; then
    order=$num$(tr ',' '\n' <<<"$order" | grep -vix "$num" | sed 's/^/,/' | tr -d '\n')
    log "\$ efibootmgr --bootorder $order"
    efibootmgr -q --bootorder "$order" >&2 2>&1 || { emit_bootentry failed "could not put « Selene » first in the boot order"; return 0; }
  fi
  emit_bootentry added "Boot$num"
}

copy_progress() { # reads tool output; percentages -> overall 7..75
  local line pct last=-1
  while IFS= read -r line; do
    if [[ "$line" =~ ^[[:space:]]*([0-9]{1,3})[[:space:]]*$ ]]; then
      pct=${BASH_REMATCH[1]}
    elif [[ "$line" =~ [[:space:]]([0-9]{1,3})%[[:space:]] ]]; then
      pct=${BASH_REMATCH[1]}
    else
      [[ -n "${line// /}" ]] && printf '%s\n' "$line" >&2
      continue
    fi
    ((pct > 100)) && pct=100
    if ((pct != last)); then
      last=$pct
      progress copy $((7 + pct * 68 / 100)) ""
    fi
  done
}

stage_copy() {
  maybe_fail copy
  progress copy 7 "Copying the system files"
  local t0=$SECONDS
  if [[ "$SOURCE_KIND" == squashfs ]]; then
    log "\$ unsquashfs -f -d $TARGET -percentage $SOURCE"
    bg_wait bash -o pipefail -c '
      unsquashfs -f -d "$1" -percentage -processors "$(nproc)" "$2" | copy_progress' \
      _ "$TARGET" "$SOURCE" || die 5 "copying the system failed (unsquashfs; is the disk or the medium damaged?)"
  else
    log "\$ rsync -aHAXx --info=progress2 $SOURCE/ $TARGET/"
    bg_wait bash -o pipefail -c '
      rsync -aHAXx --numeric-ids --info=progress2 --no-inc-recursive \
        --exclude=/proc/* --exclude=/sys/* --exclude=/dev/* --exclude=/run/* --exclude=/tmp/* \
        --exclude=/var/tmp/* --exclude=/boot/efi/* --exclude=/lost+found --exclude=/cdrom/* \
        --exclude=/rofs/* --exclude=/media/* --exclude=/mnt/* --exclude=/swapfile \
        "$2"/ "$1"/ | tr "\r" "\n" | copy_progress' \
      _ "$TARGET" "$SOURCE" || die 5 "copying the system failed (rsync)"
  fi
  for f in usr/lib/os-release usr/bin/bash etc/passwd; do
    [[ -e "$TARGET/$f" ]] || die 5 "the copied system is incomplete ($f is missing)"
  done
  compgen -G "$TARGET/boot/vmlinuz-*" >/dev/null || die 5 "the copied system has no kernel"
  log "system copied in $((SECONDS - t0))s"
  progress copy 75 ""
}
export -f copy_progress progress log json_str
export JSON PROGRESS STAGE NVIDIA_DRIVER   # copy_progress runs in a child bash: same percentage rescaling

write_file() { # write_file PATH MODE  (content on stdin)
  local f=$1 mode=$2
  mkdir -p "$(dirname "$f")"
  cat >"$f.aurora-tmp"
  chmod "$mode" "$f.aurora-tmp"
  mv -f "$f.aurora-tmp" "$f"
}

machine_id() { # random 128-bit id, UUID v4 layout, as systemd generates it
  local h
  h=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
  printf '%s4%s%x%s\n' "${h:0:12}" "${h:13:3}" $(( (0x${h:16:1} & 0x3) | 0x8 )) "${h:17:15}"
}

remove_live_remnants() {
  local live_user uid
  live_user=$(sed -n 's/^export USERNAME="\{0,1\}\([a-z_][a-z0-9_-]*\)"\{0,1\}$/\1/p' "$TARGET/etc/casper.conf" 2>/dev/null | head -n1)
  live_user=${live_user:-aurora}
  if [[ "$live_user" != "$USERNAME" ]] && uid=$(in_target id -u "$live_user" 2>/dev/null) && ((uid >= 1000)); then
    log "removing the live user $live_user"
    in_target userdel --force --remove "$live_user" >&2 2>&1 || log "warning: userdel $live_user failed"
  fi
  [[ "$live_user" != "$USERNAME" ]] && rm -rf "${TARGET:?}/home/$live_user"
  rm -f "$TARGET/etc/sudoers.d/casper" "$TARGET/etc/casper.conf" "$TARGET/var/lib/AccountsService/users/$live_user"
  rm -f "$TARGET"/etc/systemd/system/getty@*.service.d/*autologin*.conf "$TARGET"/etc/systemd/system/serial-getty@*.service.d/*autologin*.conf
  rmdir "$TARGET"/etc/systemd/system/getty@*.service.d "$TARGET"/etc/systemd/system/serial-getty@*.service.d 2>/dev/null || true
  # The automated install is for live media only: never leave it enabled on the installed system.
  rm -f "$TARGET"/etc/systemd/system/*.wants/aurora-autoinstall.service
}

purge_live_packages() {
  local list=() p f="$MEDIUM/casper/filesystem.manifest-remove"
  if [[ -r "$f" ]]; then
    while read -r p _; do
      p=${p%%:*}
      [[ "$p" =~ ^[a-z0-9][a-z0-9+.-]*$ ]] && list+=("$p")
    done < <(grep -v '^[[:space:]]*#' "$f")
  else
    log "warning: $f not found; removing casper and user-setup only"
    list=(casper user-setup)
  fi
  local installed=()
  for p in "${list[@]}"; do
    [[ "$(in_target dpkg-query -W -f='${db:Status-Abbrev}' "$p" 2>/dev/null)" == [ir]* ]] && installed+=("$p")
  done
  if ((${#installed[@]})); then
    log "purging live-only packages: ${installed[*]}"
    bg_wait in_target dpkg --purge "${installed[@]}" >&2 || die 5 "could not remove the live-session packages (${installed[*]})"
  fi
  if [[ "$(in_target dpkg-query -W -f='${db:Status-Abbrev}' casper 2>/dev/null || true)" == i* ]]; then
    die 5 "casper is still installed after the purge"
  fi
}

# The live-session scripts (scripts/casper, scripts/casper-bottom, …) must not be in the installed system's initramfs.
# initramfs_list KVER prints the names of the initramfs members that contain "scripts/casper" (nothing: there are none)
# and fails when the image could not be read to its end. It scans the cpio headers with python3: the uncompressed
# early archives (microcode, ~48 MB) are skipped by their sizes and the compressed main archive is streamed through its
# decompressor, in seconds — lsinitramfs took ~40 min for the same answer in a virtual machine without KVM. lsinitramfs
# (in the target, full listing) is the fallback when python3 or the decompressor is missing. Interruptible (bg_wait).
INITRAMFS_SCAN_PY='
import os, subprocess, sys
NEEDLE = b"scripts/casper"
CPIO = (b"070701", b"070702")
DECOMP = ((b"\x28\xb5\x2f\xfd", ["zstd", "-dcq"]), (b"\x1f\x8b", ["gzip", "-dc"]), (b"\xfd7zXZ\x00", ["xz", "-dc"]),
          (b"\x02\x21\x4c\x18", ["lz4", "-dc"]), (b"\x89LZO", ["lzop", "-dc"]), (b"BZh", ["bzip2", "-dc"]),
          (b"\x5d\x00\x00", ["xz", "--format=lzma", "-dc"]))
class Bad(Exception): pass
class R:
    def __init__(s, f): s.f, s.b, s.i, s.pos = f, b"", 0, 0
    def peek(s, n):
        if len(s.b) - s.i < n:
            parts, have = [s.b[s.i:]], len(s.b) - s.i
            while have < n:
                c = s.f.read(max(n - have, 1 << 20))
                if not c: break
                parts.append(c); have += len(c)
            s.b, s.i = b"".join(parts), 0
        return s.b[s.i:s.i + n]
    def read(s, n):
        out = s.peek(n); s.i += len(out); s.pos += len(out)
        if len(out) < n: raise Bad("truncated at byte %d" % s.pos)
        return out
    def skip(s, n):
        a = min(n, len(s.b) - s.i); s.i += a; s.pos += a; n -= a
        while n > 0:
            c = s.f.read(min(n, 1 << 20))
            if not c: raise Bad("truncated at byte %d" % s.pos)
            n -= len(c); s.pos += len(c)
def archives(r, found):  # consecutive newc archives -> "eof" or "other" (data that is not a cpio archive); count
    count = 0
    while True:
        while True:  # zero padding between archives
            p = r.peek(512)
            z = len(p) - len(p.lstrip(b"\0"))
            if not z: break
            r.skip(z)
        if not r.peek(1): return "eof", count
        if r.peek(6) not in CPIO: return "other", count
        if r.pos % 4: raise Bad("misaligned archive at byte %d" % r.pos)
        while True:
            h = r.read(110)
            if h[:6] not in CPIO: raise Bad("bad cpio header at byte %d" % (r.pos - 110))
            try: size, nsize = int(h[54:62], 16), int(h[94:102], 16)
            except ValueError: raise Bad("bad cpio header at byte %d" % (r.pos - 110))
            name = r.read(nsize).rstrip(b"\0")
            r.skip(-r.pos % 4)
            if name == b"TRAILER!!!": break
            if NEEDLE in name: found.append(name.decode("utf-8", "replace"))
            r.skip(size); r.skip(-r.pos % 4)
        count += 1
def main(path):
    found = []
    with open(path, "rb") as f:
        r = R(f)
        what, n = archives(r, found)
        if what == "other":
            magic = r.peek(6)
            cmd = next((c for m, c in DECOMP if magic.startswith(m)), None)
            if cmd is None: raise Bad("unknown data at byte %d" % r.pos)
            fd = os.open(path, os.O_RDONLY); os.lseek(fd, r.pos, 0)
            try: p = subprocess.Popen(cmd, stdin=fd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            except OSError: sys.exit(3)  # no decompressor here
            finally: os.close(fd)
            what, m = archives(R(p.stdout), found)
            p.stdout.close()
            if p.wait() != 0 or what != "eof" or m < 1: raise Bad("the compressed archive could not be read (%s)" % cmd[0])
            n += m
    if n < 1: raise Bad("no cpio archive")
    for x in found: print(x)
try: main(sys.argv[1])
except (Bad, OSError) as e:
    print("initramfs scan: %s" % e, file=sys.stderr); sys.exit(2)
'
initramfs_list() {
  local out="$WORKDIR/initramfs.list" img="$TARGET/boot/initrd.img-$1" rc=0
  [[ -s "$img" ]] || return 1
  if command -v python3 >/dev/null 2>&1; then
    bg_wait python3 -I -c "$INITRAMFS_SCAN_PY" "$img" >"$out" || rc=$?
    if ((rc == 0)); then cat "$out"; rm -f "$out"; return 0; fi
    rm -f "$out"
    ((rc == 3)) || return 1   # unreadable: never taken as "no casper scripts"
    log "initramfs scan: no decompressor for $img here; using lsinitramfs (slow)"
  fi
  bg_wait in_target lsinitramfs "/boot/initrd.img-$1" >"$out" 2>/dev/null || { rm -f "$out"; return 1; }
  cat "$out"; rm -f "$out"
}
regenerate_initramfs() {
  local k kvers=() need=0 since=$1
  for k in "$TARGET"/usr/lib/modules/*; do [[ -d "$k" && -e "$TARGET/boot/vmlinuz-${k##*/}" ]] && kvers+=("${k##*/}"); done
  ((${#kvers[@]})) || die 5 "no kernel found in the installed system"
  # Purging casper may already have regenerated it through the initramfs-tools trigger.
  for k in "${kvers[@]}"; do
    local img="$TARGET/boot/initrd.img-$k"
    if [[ ! -s "$img" ]] || (( $(stat -c %Y "$img") < since )) \
       || has_text scripts/casper "$(initramfs_list "$k" || true)"; then
      need=1
    fi
  done
  if ((need)); then
    log "\$ update-initramfs -u -k all"
    bg_wait in_target update-initramfs -u -k all >&2 || die 5 "could not generate the initramfs"
  else
    log "initramfs already regenerated by the package removal"
  fi
  for k in "${kvers[@]}"; do
    [[ -s "$TARGET/boot/initrd.img-$k" ]] || die 5 "initramfs missing for kernel $k"
    local content; content=$(initramfs_list "$k") || die 5 "cannot read the initramfs of kernel $k"
    if has_text scripts/casper "$content"; then
      die 5 "the initramfs of kernel $k still contains the live-session (casper) scripts"
    fi
  done
  log "initramfs: ${kvers[*]}"
}

# write_gaming_request HOME UID GID: HOME/.config/aurora/first-login/gaming.json for the gaming apps (--gaming), owned by
# the new account (file 0644, directories 0755). Never dies: returns 1 with GAMING_ERR set (the installation goes on).
GAMING_ERR=""
write_gaming_request() {
  local home=$1 uid=$2 gid=$3 dir p f tmp ids_json="" id
  dir=$home/.config/aurora/first-login
  for p in "$home" "$home/.config" "$home/.config/aurora" "$dir"; do
    # never follow a link out of the account's home (it is written as root)
    if [[ -L "$p" ]]; then GAMING_ERR="~${p#"$home"} is a symbolic link"; return 1; fi
    [[ -d "$p" ]] && continue
    if [[ -e "$p" || "$p" == "$home" ]]; then GAMING_ERR="~${p#"$home"} is not a directory"; return 1; fi
    install -d -m 0755 -o "$uid" -g "$gid" "$p" 2>/dev/null || { GAMING_ERR="could not create ~${p#"$home"}"; return 1; }
  done
  for id in "${GAMING_APPS[@]}"; do ids_json+="${ids_json:+, }\"$id\""; done
  f=$dir/gaming.json tmp=$dir/.gaming.json.aurora-tmp
  rm -f "$tmp" 2>/dev/null
  if ! printf '{\n  "version": 1,\n  "apps": [%s],\n  "requestedAt": "%s"\n}\n' "$ids_json" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$tmp" 2>/dev/null \
     || ! chown "$uid:$gid" "$tmp" 2>/dev/null || ! chmod 0644 "$tmp" 2>/dev/null || ! mv -fT "$tmp" "$f" 2>/dev/null; then
    rm -f "$tmp" 2>/dev/null
    GAMING_ERR="could not write ~/.config/aurora/first-login/gaming.json"
    return 1
  fi
  log "gaming apps for the first sign-in written to ~/.config/aurora/first-login/gaming.json: ${GAMING_APPS[*]}"
  return 0
}

stage_configure() {
  maybe_fail configure
  progress configure 76 "Configuring the system"
  local t_start; t_start=$(date +%s)
  mount_esp
  chroot_mount

  write_file "$TARGET/etc/fstab" 0644 <<EOF
# /etc/fstab: static file system information (written by the Selene OS installer).
# Use 'blkid' to print the UUID of a device. Swap: compressed RAM (zram), see /etc/systemd/zram-generator.conf.
# <file system>                            <mount point>  <type>  <options>          <dump>  <pass>
UUID=$ROOT_UUID  /              ext4    errors=remount-ro  0       1
UUID=$ESP_UUID                             /boot/efi      vfat    umask=0077         0       1
EOF
  printf '%s\n' "$HOST_NAME" | write_file "$TARGET/etc/hostname" 0644
  write_file "$TARGET/etc/hosts" 0644 <<EOF
127.0.0.1	localhost
127.0.1.1	$HOST_NAME

# The following lines are desirable for IPv6 capable hosts
::1     ip6-localhost ip6-loopback
fe00::0 ip6-localnet
ff00::0 ip6-mcastprefix
ff02::1 ip6-allnodes
ff02::2 ip6-allrouters
EOF

  progress configure 77 "Removing the live session"
  remove_live_remnants
  purge_live_packages
  progress configure 79 ""

  # Language, keyboard, time zone.
  progress configure 80 "Setting the language, keyboard and time zone"
  if ! grep -qix -- "${LOCALE%%.*}.utf8" <<<"$(in_target locale -a 2>/dev/null || true)"; then
    grep -q "^$LOCALE " "$TARGET/etc/locale.gen" 2>/dev/null || echo "$LOCALE UTF-8" >>"$TARGET/etc/locale.gen"
    run "could not generate the locale $LOCALE" in_target locale-gen "$LOCALE"
  fi
  run "could not set the system language" in_target update-locale --reset "LANG=$LOCALE"
  [[ -f "$TARGET/usr/share/X11/xkb/symbols/$XKB_LAYOUT" ]] || die 2 "unknown keyboard layout: $XKB_LAYOUT"
  write_file "$TARGET/etc/default/keyboard" 0644 <<EOF
# KEYBOARD CONFIGURATION FILE (written by the Selene OS installer)
# Consult the keyboard(5) manual page.

XKBMODEL="pc105"
XKBLAYOUT="$XKB_LAYOUT"
XKBVARIANT="$XKB_VARIANT"
XKBOPTIONS=""

BACKSPACE="guess"
EOF
  in_target debconf-set-selections >&2 2>&1 <<EOF || log "warning: debconf-set-selections (keyboard) failed"
keyboard-configuration keyboard-configuration/layoutcode string $XKB_LAYOUT
keyboard-configuration keyboard-configuration/variantcode string $XKB_VARIANT
keyboard-configuration keyboard-configuration/modelcode string pc105
EOF
  if [[ "$TIMEZONE" == UTC ]]; then TIMEZONE=Etc/UTC; fi
  [[ -f "$TARGET/usr/share/zoneinfo/$TIMEZONE" ]] || die 2 "unknown time zone: $TIMEZONE"
  ln -sfn "/usr/share/zoneinfo/$TIMEZONE" "$TARGET/etc/localtime"
  printf '%s\n' "$TIMEZONE" | write_file "$TARGET/etc/timezone" 0644

  # User account.
  progress configure 81 "Creating the user account $USERNAME"
  in_target id -u "$USERNAME" >/dev/null 2>&1 && die 2 "the user name '$USERNAME' is already used by the system"
  local g groups=""
  for g in "${USER_GROUPS[@]}"; do
    in_target getent group "$g" >/dev/null || run "could not create the group $g" in_target groupadd --system "$g"
    groups+="${groups:+,}$g"
  done
  run "could not create the user $USERNAME" in_target useradd --create-home --shell /bin/bash \
    --comment "$FULLNAME" --groups "$groups" "$USERNAME"
  log "\$ chpasswd ($USERNAME)"
  printf '%s:%s\n' "$USERNAME" "$PASSWORD" | in_target chpasswd || die 5 "could not set the password of $USERNAME"
  [[ "$(in_target getent shadow "$USERNAME" | cut -d: -f2)" == \$* ]] || die 5 "the password of $USERNAME was not set"
  local uid gid home
  uid=$(in_target id -u "$USERNAME") gid=$(in_target id -g "$USERNAME")
  home=$(in_target getent passwd "$USERNAME" | cut -d: -f6)
  # Per-user Selene OS settings: the shell's language follows the installation language.
  install -d -m 0755 -o "$uid" -g "$gid" "$TARGET$home/.config" "$TARGET$home/.config/aurora"
  local sf="$TARGET$home/.config/aurora/settings.json"
  if [[ -s "$sf" ]]; then
    in_target python3 -I -c 'import json,sys; f=sys.argv[1]; d=json.load(open(f)); d["lang"]=sys.argv[2]; json.dump(d, open(f, "w"), indent=2)' \
      "$home/.config/aurora/settings.json" "$LANGUAGE_ID" || die 5 "could not write the user settings"
  else
    printf '{\n  "lang": "%s"\n}\n' "$LANGUAGE_ID" >"$sf"
  fi
  chown "$uid:$gid" "$sf"; chmod 0644 "$sf"
  # Gaming apps (--gaming): recorded for the session, which installs them from Flathub at the first sign-in.
  if ((${#GAMING_APPS[@]})); then
    if write_gaming_request "$TARGET$home" "$uid" "$gid"; then emit_gaming saved
    else emit_gaming failed "$GAMING_ERR"; fi
  fi
  progress configure 82 ""

  # Sign-in screen (greetd): no live autologin; the new account when --autologin is set.
  {
    cat <<'EOF'
# Selene OS — greetd configuration (written by the Selene OS installer).
# Automatic sign-in: Settings > Accounts > Sign-in options (aurora-admin set-autologin).

[terminal]
# VT used by the sign-in screen and the desktop session (tty1 keeps a text console).
vt = 7

# Sign-in screen: Xorg + Selene Shell in greeter mode, as greetd's system user.
[default_session]
command = "/usr/lib/aurora/aurora-greeter"
user = "_greetd"
EOF
    if ((AUTOLOGIN)); then
      cat <<EOF

# Automatic sign-in once per boot; signing out shows the sign-in screen.
[initial_session]
command = "/usr/bin/aurora-session"
user = "$USERNAME"
EOF
    fi
  } | write_file "$TARGET/etc/greetd/config.toml" 0644

  # Per-machine identity and installation record.
  machine_id | write_file "$TARGET/etc/machine-id" 0444
  [[ -L "$TARGET/var/lib/dbus/machine-id" ]] || { mkdir -p "$TARGET/var/lib/dbus"; ln -sfn /etc/machine-id "$TARGET/var/lib/dbus/machine-id"; }
  local build_id
  build_id=$(cat "$MEDIUM/.disk/aurora-build-id" 2>/dev/null || cat "$TARGET/etc/aurora/build-id" 2>/dev/null || echo unknown)
  write_file "$TARGET/etc/aurora/install-info" 0644 <<EOF
AURORA_INSTALL_DATE=$(date -u +%Y-%m-%dT%H:%M:%SZ)
AURORA_INSTALL_BUILD_ID=$build_id
AURORA_INSTALL_FIRMWARE=$([[ -d /sys/firmware/efi ]] && echo uefi || echo bios)
AURORA_INSTALL_LANG=$LANGUAGE_ID
EOF
  # No hibernation: zram swap only (skips the initramfs resume-device lookup at boot).
  printf 'RESUME=none\n' | write_file "$TARGET/etc/initramfs-tools/conf.d/resume" 0644

  progress configure 83 "Updating the initramfs"
  regenerate_initramfs "$t_start"
  progress configure 86 ""
}

# ------------------------------------------------------------------ graphics driver (--nvidia-driver)
# driver_progress: APT status lines (APT::Status-Fd) -> overall progress 80..88; everything else to the log.
driver_progress() {
  local line kind pct dl=0 pm=0
  while IFS= read -r line; do
    case "$line" in
      dlstatus:*|pmstatus:*)
        kind=${line%%:*}; pct=${line#*:}; pct=${pct#*:}; pct=${pct%%:*}; pct=${pct%%.*}
        [[ "$pct" =~ ^[0-9]{1,3}$ ]] || continue
        ((pct > 100)) && pct=100
        if [[ "$kind" == dlstatus ]]; then
          ((dl)) || { dl=1; progress drivers 80 "Downloading the NVIDIA driver"; }
          progress drivers $((80 + pct * 4 / 100)) ""
        else
          ((pm)) || { pm=1; progress drivers 84 "Installing the NVIDIA driver"; }
          progress drivers $((84 + pct * 4 / 100)) ""
        fi ;;
      *) [[ -n "${line// /}" ]] && printf '%s\n' "$line" >&2 ;;
    esac
  done
  return 0
}
# nvidia_offered: `ubuntu-drivers devices` output on stdin -> "<package> [recommended]" per NVIDIA driver offered
nvidia_offered() {
  awk '$1 == "driver" && $2 == ":" && $3 ~ /^nvidia-driver-[0-9][0-9][0-9](-open|-server|-server-open)?$/ {
         print $3 ($NF == "recommended" ? " recommended" : "") }'
}
# The target resolves names with the live session's DNS servers while the driver is downloaded
# (/etc/resolv.conf of the installed system points into /run, a tmpfs here: nothing is left behind).
target_dns() {
  local src="" l
  for l in /run/systemd/resolve/resolv.conf /etc/resolv.conf; do
    [[ -s "$l" ]] && { src=$l; break; }
  done
  [[ -n "$src" ]] || return 1
  # The stub resolver (127.0.0.53) of the live session also answers inside the chroot (same network).
  l=$(readlink "$TARGET/etc/resolv.conf" 2>/dev/null || true)
  if [[ "$l" == ../run/* || "$l" == /run/* ]]; then
    l=/run/${l#*run/}
    mkdir -p "$TARGET$(dirname "$l")"
    cp -L "$src" "$TARGET$l"
  else
    [[ -e "$TARGET/etc/resolv.conf" ]] || : >"$TARGET/etc/resolv.conf"
    mount --bind "$src" "$TARGET/etc/resolv.conf"   # unmounted with everything else under $WORKDIR
  fi
}
# install_nvidia_driver: 0 when the driver is installed; else 1 with DRIVER_ERR set (never dies).
DRIVER_ERR="" DRIVER_PKG=""
install_nvidia_driver() {
  local offered spec out="$WORKDIR/ubuntu-drivers.txt" aptconf=/run/aurora-install-apt.conf
  DRIVER_PKG=$NVIDIA_DRIVER
  target_dns || { DRIVER_ERR="no DNS configuration in the live session (no Internet connection?)"; return 1; }
  if ! in_target sh -c 'command -v ubuntu-drivers' >/dev/null 2>&1; then
    DRIVER_ERR="ubuntu-drivers is not installed in the system (package ubuntu-drivers-common)"; return 1
  fi
  progress drivers 77 "Downloading the list of drivers"
  log "\$ apt-get update (in the installed system)"
  # --error-on=any: offline, apt-get update only prints warnings and exits 0 otherwise
  bg_wait in_target apt-get -q --error-on=any -o Acquire::Retries=3 -o Acquire::http::Timeout=30 update >&2 \
    || { DRIVER_ERR="could not download the package lists (no Internet connection?)"; return 1; }
  progress drivers 79 "Checking the drivers offered for this graphics card"
  log "\$ ubuntu-drivers devices"
  bg_wait in_target ubuntu-drivers devices >"$out" 2>/dev/null || true
  offered=$(nvidia_offered <"$out"); rm -f "$out"
  log "NVIDIA drivers offered: $(tr '\n' ' ' <<<"$offered")"
  if [[ "$NVIDIA_DRIVER" == recommended ]]; then
    DRIVER_PKG=$(awk '$2 == "recommended" { print $1; exit }' <<<"$offered")
    # nothing marked recommended: the newest desktop driver (not a -server one), whatever order ubuntu-drivers printed
    [[ -n "$DRIVER_PKG" ]] || DRIVER_PKG=$(awk '$1 !~ /-server/ { print $1 }' <<<"$offered" | sort -V | tail -n1)
    [[ -n "$DRIVER_PKG" ]] || DRIVER_PKG=$(awk '{ print $1 }' <<<"$offered" | sort -V | tail -n1)
    [[ -n "$DRIVER_PKG" ]] || { DRIVER_PKG=""; DRIVER_ERR="no NVIDIA driver is offered for this graphics card"; return 1; }
  fi
  [[ "$DRIVER_PKG" =~ $RE_NVIDIA ]] || { DRIVER_ERR="invalid driver package $DRIVER_PKG"; return 1; }
  awk -v p="$DRIVER_PKG" '$1 == p { f = 1 } END { exit !f }' <<<"$offered" \
    || { DRIVER_ERR="$DRIVER_PKG is not offered for this graphics card"; return 1; }
  spec="nvidia:${DRIVER_PKG#nvidia-driver-}"
  # APT status lines on stdout for the progress bar (apt-get is run by ubuntu-drivers; APT_CONFIG is inherited).
  printf 'APT::Status-Fd "1";\nDpkg::Use-Pty "0";\nAPT::Color "0";\nDPkg::Lock::Timeout "60";\n' >"$TARGET$aptconf"
  log "\$ ubuntu-drivers install $spec (in the installed system)"
  export -f driver_progress in_target
  export TARGET
  bg_wait bash -o pipefail -c 'in_target APT_CONFIG="$1" ubuntu-drivers install "$2" 2>&1 | driver_progress' _ "$aptconf" "$spec" \
    || { rm -f "$TARGET$aptconf"; DRIVER_ERR="ubuntu-drivers install $spec failed (see the log)"; return 1; }
  rm -f "$TARGET$aptconf"
  [[ "$(in_target dpkg-query -W -f='${db:Status-Abbrev}' "$DRIVER_PKG" 2>/dev/null || true)" == ii* ]] \
    || { DRIVER_ERR="$DRIVER_PKG is not installed after ubuntu-drivers install"; return 1; }
  local mods; mods=$(in_target dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' 'linux-modules-nvidia-*' 'nvidia-dkms-*' 2>/dev/null | awk '$1 == "ii" { print $2 }' | tr '\n' ' ' || true)
  log "NVIDIA kernel modules: ${mods:-none found}"
  # Kernel mode setting for the nvidia driver (rootless Xorg through logind needs it): noble's
  # nvidia-kernel-common-NNN ships /etc/modprobe.d/nvidia-graphics-drivers-kms.conf; add it when missing.
  if ! grep -rqsE '^[[:space:]]*options[[:space:]]+nvidia[-_]drm[[:space:]].*modeset=1' \
       "$TARGET/etc/modprobe.d" "$TARGET/usr/lib/modprobe.d" "$TARGET/lib/modprobe.d"; then
    printf '# Selene OS installer: kernel mode setting for the NVIDIA driver (Xorg via logind, no root).\noptions nvidia-drm modeset=1\n' \
      | write_file "$TARGET/etc/modprobe.d/aurora-nvidia-kms.conf" 0644
    log "nvidia-drm modeset=1 set in /etc/modprobe.d/aurora-nvidia-kms.conf"
    bg_wait in_target update-initramfs -u -k all >&2 || log "warning: update-initramfs after the driver failed"
  fi
  return 0
}
stage_drivers() {
  [[ -n "$NVIDIA_DRIVER" ]] || return 0
  progress drivers 76 "Installing the NVIDIA graphics driver"
  if [[ "$FAIL_AT" == drivers ]]; then
    DRIVER_PKG=$NVIDIA_DRIVER
    emit_driver failed "$DRIVER_PKG" "simulated failure at stage 'drivers' (--fail-at)"
  elif install_nvidia_driver; then
    emit_driver installed "$DRIVER_PKG"
  else
    emit_driver failed "${DRIVER_PKG:-$NVIDIA_DRIVER}" "$DRIVER_ERR"
    # A half-done apt run must not leave dpkg locked or broken for the first boot.
    in_target dpkg --configure -a >&2 2>&1 || true
  fi
  rm -f "$TARGET/var/cache/apt/archives/"*.deb 2>/dev/null || true
  progress drivers 88 ""
}

stage_bootloader() {
  maybe_fail bootloader
  if ((ALONGSIDE)); then stage_bootloader_alongside; return; fi
  progress bootloader 87 "Installing the boot loader (BIOS)"
  # GRUB settings (Ubuntu's /etc/default/grub stays untouched; this drop-in overrides it).
  local theme_src="$MEDIUM/boot/grub/themes/aurora" theme_line="#GRUB_THEME= (no Selene OS theme on the installation medium)"
  [[ -f "$TARGET/usr/share/grub/themes/aurora/theme.txt" ]] && theme_src="$TARGET/usr/share/grub/themes/aurora"
  if [[ -f "$theme_src/theme.txt" ]]; then
    rm -rf "$TARGET/boot/grub/themes/aurora"
    mkdir -p "$TARGET/boot/grub/themes"
    cp -r "$theme_src" "$TARGET/boot/grub/themes/aurora"
    chmod -R u+rwX,go+rX,go-w "$TARGET/boot/grub/themes/aurora"
    theme_line='GRUB_THEME=/boot/grub/themes/aurora/theme.txt'
  else
    log "warning: no GRUB theme at $theme_src; using the plain menu"
  fi
  write_file "$TARGET/etc/default/grub.d/50-aurora.cfg" 0644 <<EOF
# Selene OS boot menu (written by the Selene OS installer). Sourced after /etc/default/grub;
# run 'sudo update-grub' after changing it.
GRUB_DISTRIBUTOR="Selene OS"
GRUB_TIMEOUT_STYLE=menu
GRUB_TIMEOUT=3
GRUB_RECORDFAIL_TIMEOUT=10
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"
GRUB_GFXMODE=1920x1080,1600x900,1280x800,1024x768,auto
GRUB_GFXPAYLOAD_LINUX=keep
$theme_line
EOF
  # Kernel/GRUB package updates keep the removable UEFI boot path (EFI/BOOT) up to date too.
  in_target debconf-set-selections >&2 2>&1 <<'EOF' || log "warning: debconf-set-selections (grub) failed"
grub-efi-amd64 grub2/force_efi_extra_removable boolean true
EOF

  run "could not install the BIOS boot loader on $DISK" \
    in_target grub-install --target=i386-pc --boot-directory=/boot --recheck "$DISK"
  [[ -s "$TARGET/boot/grub/i386-pc/core.img" ]] || die 5 "the BIOS boot loader was not installed (core.img missing)"

  progress bootloader 91 "Installing the boot loader (UEFI)"
  # EFI/ubuntu: Ubuntu's signed GRUB reads its configuration from /EFI/ubuntu (its built-in prefix);
  # EFI/BOOT/BOOTX64.EFI: removable path, boots without any firmware boot entry (no NVRAM writes).
  run "could not install the UEFI boot loader" \
    in_target grub-install --target=x86_64-efi --efi-directory=/boot/efi --boot-directory=/boot \
      --bootloader-id=ubuntu --no-nvram --recheck
  run "could not install the removable UEFI boot loader" \
    in_target grub-install --target=x86_64-efi --efi-directory=/boot/efi --boot-directory=/boot \
      --removable --no-nvram --recheck
  [[ -s "$TARGET/boot/efi/EFI/BOOT/BOOTX64.EFI" ]] || die 5 "EFI/BOOT/BOOTX64.EFI was not installed"
  # Every directory that holds a GRUB image gets the configuration stub (search root by UUID).
  local stub="" d
  for d in "$TARGET/boot/efi/EFI/ubuntu" "$TARGET/boot/efi/EFI/BOOT"; do
    [[ -s "$d/grub.cfg" ]] && { stub=$d/grub.cfg; break; }
  done
  if [[ -z "$stub" ]]; then
    stub=$TARGET/boot/efi/EFI/ubuntu/grub.cfg
    mkdir -p "$(dirname "$stub")"
    printf "search.fs_uuid %s root\nset prefix=(\$root)'/boot/grub'\nconfigfile \$prefix/grub.cfg\n" "$ROOT_UUID" >"$stub"
  fi
  grep -q "$ROOT_UUID" "$stub" || die 5 "the UEFI boot loader configuration does not point to the system partition"
  for d in "$TARGET/boot/efi/EFI/ubuntu" "$TARGET/boot/efi/EFI/BOOT"; do
    [[ -d "$d" && ! -s "$d/grub.cfg" ]] && cp "$stub" "$d/grub.cfg"
  done

  progress bootloader 94 "Writing the boot menu"
  run "could not write the boot menu (update-grub)" in_target update-grub
  local cfg="$TARGET/boot/grub/grub.cfg"
  [[ -s "$cfg" ]] || die 5 "/boot/grub/grub.cfg was not generated"
  grep -q "root=UUID=$ROOT_UUID" "$cfg" || die 5 "the boot menu does not boot the system partition by UUID"
  grep -q 'scripts/casper\|boot=casper' "$cfg" && die 5 "the boot menu still refers to the live system"
  flush_esp
  progress bootloader 97 ""
}

# Next to other systems: UEFI only, on the shared EFI system partition, without touching other folders.
stage_bootloader_alongside() {
  progress bootloader 87 "Installing the boot loader (UEFI, next to your other systems)"
  local theme_src="$MEDIUM/boot/grub/themes/aurora" theme_line="#GRUB_THEME= (no Selene OS theme on the installation medium)"
  [[ -f "$TARGET/usr/share/grub/themes/aurora/theme.txt" ]] && theme_src="$TARGET/usr/share/grub/themes/aurora"
  if [[ -f "$theme_src/theme.txt" ]]; then
    rm -rf "$TARGET/boot/grub/themes/aurora"
    mkdir -p "$TARGET/boot/grub/themes"
    cp -r "$theme_src" "$TARGET/boot/grub/themes/aurora"
    chmod -R u+rwX,go+rX,go-w "$TARGET/boot/grub/themes/aurora"
    theme_line='GRUB_THEME=/boot/grub/themes/aurora/theme.txt'
  fi
  write_file "$TARGET/etc/default/grub.d/50-aurora.cfg" 0644 <<EOF
# Selene OS boot menu (written by the Selene OS installer, installed next to other systems). Sourced after
# /etc/default/grub; run 'sudo update-grub' after changing it.
GRUB_DISTRIBUTOR="Selene OS"
GRUB_TIMEOUT_STYLE=menu
GRUB_TIMEOUT=5
GRUB_RECORDFAIL_TIMEOUT=10
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"
GRUB_GFXMODE=1920x1080,1600x900,1280x800,1024x768,auto
GRUB_GFXPAYLOAD_LINUX=keep
# The other systems of this computer (Windows, other Linux) are listed in the menu (os-prober).
GRUB_DISABLE_OS_PROBER=false
$theme_line
EOF
  # GRUB package updates must never overwrite another system's removable EFI/BOOT/BOOTX64.EFI. Ubuntu 24.04's
  # grub-install writes EFI/BOOT/{BOOTX64,fbx64,mmx64}.efi BY DEFAULT ("extra removable"); grub-efi-amd64's postinst
  # passes --no-extra-removable only when grub2/no_efi_extra_removable is true (force_efi_extra_removable is the old
  # Debian opt-in and has no effect on that default).
  local extra=false noextra=true; ((ESP_OWN_FALLBACK)) && { extra=true; noextra=false; }
  in_target debconf-set-selections >&2 2>&1 <<EOF || log "warning: debconf-set-selections (grub) failed"
grub-efi-amd64 grub2/force_efi_extra_removable boolean $extra
grub-efi-amd64 grub2/no_efi_extra_removable boolean $noextra
EOF
  ((ESP_OWN_FALLBACK)) || write_grub_wrapper   # before grub-install: this installation runs through it too
  local before="$WORKDIR/esp-before.sha256" after="$WORKDIR/esp-after.sha256" snap=1
  esp_snapshot "$before" || { snap=0; log "warning: could not read the EFI system partition for the before/after check"; }
  esp_backup   # from here on, a failure puts the EFI system partition back as it was (esp_rollback)
  write_chainload_entries   # from the copy just made, before « Selene » is added to the firmware's boot entries
  # EFI/ubuntu: Ubuntu's signed shim + GRUB (their built-in prefix is /EFI/ubuntu); the NVRAM entry is added below.
  # --no-extra-removable: without it this grub-install also replaces EFI/BOOT/BOOTX64.EFI (and adds fbx64/mmx64.efi
  # there), i.e. another system's fallback loader (seen in QEMU/OVMF next to Windows and next to Arch).
  run "could not install the UEFI boot loader" \
    in_target grub-install --target=x86_64-efi --efi-directory=/boot/efi --boot-directory=/boot \
      --bootloader-id=ubuntu --no-nvram --no-extra-removable --recheck
  [[ -s "$TARGET/boot/efi/EFI/ubuntu/grubx64.efi" ]] || die 5 "EFI/ubuntu/grubx64.efi was not installed"
  ((TEST_NO_FIRMWARE)) && [[ "${AURORA_INSTALL_TEST_TAMPER_ESP:-}" == 1 ]] && test_tamper_esp
  if ((ESP_OWN_FALLBACK)); then
    run "could not install the removable UEFI boot loader" \
      in_target grub-install --target=x86_64-efi --efi-directory=/boot/efi --boot-directory=/boot \
        --removable --no-nvram --recheck
  fi
  local stub="$TARGET/boot/efi/EFI/ubuntu/grub.cfg" d
  if [[ ! -s "$stub" ]]; then
    printf "search.fs_uuid %s root\nset prefix=(\$root)'/boot/grub'\nconfigfile \$prefix/grub.cfg\n" "$ROOT_UUID" >"$stub"
  fi
  grep -q "$ROOT_UUID" "$stub" || die 5 "the UEFI boot loader configuration does not point to the system partition"
  if ((ESP_OWN_FALLBACK)); then
    d=$TARGET/boot/efi/EFI/BOOT
    [[ -d "$d" && ! -s "$d/grub.cfg" ]] && cp "$stub" "$d/grub.cfg"
  fi

  progress bootloader 94 "Writing the boot menu (with your other systems)"
  run "could not write the boot menu (update-grub)" in_target update-grub
  local cfg="$TARGET/boot/grub/grub.cfg"
  [[ -s "$cfg" ]] || die 5 "/boot/grub/grub.cfg was not generated"
  grep -q "root=UUID=$ROOT_UUID" "$cfg" || die 5 "the boot menu does not boot the system partition by UUID"
  grep -q 'scripts/casper\|boot=casper' "$cfg" && die 5 "the boot menu still refers to the live system"
  log "boot menu entries: $(grep -o "^menuentry '[^']*'" "$cfg" | sed "s/^menuentry //" | tr '\n' ' ' || true)"
  if ((CHAIN_ENTRIES)) && (($(grep -c '^[[:space:]]*chainloader /EFI/' "$cfg" || true) < CHAIN_ENTRIES)); then
    log "warning: the boot menu lacks some of the other systems' boot loaders (see /etc/aurora/boot-chainload.list)"
  fi
  flush_esp
  if ((snap)) && esp_snapshot "$after"; then
    if ! cmp -s "$before" "$after"; then
      diff "$before" "$after" >&2 || true
      ESP_ROLLBACK=0
      if esp_restore; then
        rm -rf "$ESP_BACKUP"; ESP_BACKUP=""
        die 5 "the boot loader installation changed a boot file of another system on the EFI system partition: the original files were put back byte for byte and Selene OS's boot files removed, so your other systems start as before (details in the log). Selene OS was not installed."
      fi
      die 5 "the boot loader installation changed a boot file of another system on the EFI system partition and it could not be put back: do not restart; the original files are in $ESP_BACKUP (see the log)"
    fi
    log "EFI system partition: the $(wc -l <"$before") files of the other systems are unchanged"
  fi
  progress bootloader 96 "Adding « Selene » to the computer's boot menu"
  add_boot_entry
  progress bootloader 97 ""
}

stage_cleanup() {
  maybe_fail cleanup
  progress cleanup 98 "Finishing"
  rm -f "$TARGET/usr/sbin/policy-rc.d"
  rm -rf "${TARGET:?}"/tmp/* "${TARGET:?}"/var/tmp/* 2>/dev/null || true
  # Completion marker, written last: a disk with this line holds a complete installation
  # (aurora-autoinstall uses it to never reinstall in a loop, and to retry an interrupted one).
  printf 'AURORA_INSTALL_COMPLETE=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"$TARGET/etc/aurora/install-info"
  # Keep a copy of this log on the installed system (no secrets are ever logged).
  install -D -m 0600 "$LOG_FILE" "$TARGET/var/log/aurora-install.log" 2>/dev/null || true
  if ((ALONGSIDE)) && [[ -s "$WORKDIR/partitions-before.sfdisk" ]]; then
    install -D -m 0600 "$WORKDIR/partitions-before.sfdisk" "$TARGET/var/log/aurora-install-partitions.sfdisk" 2>/dev/null || true
  fi
  bg_wait sync
  umount_under "$TARGET"
  if has_text "$TARGET" "$(findmnt -rn -o TARGET)"; then die 5 "could not unmount the installed system"; fi
  rmdir "$TARGET" 2>/dev/null || true
  # Restarting from the live session must not wait for "remove the installation medium".
  if [[ -d /cdrom/casper ]] && grep -qw 'boot=casper' /proc/cmdline 2>/dev/null; then
    : >/run/casper-no-prompt
  fi
  progress cleanup 99 ""
}

# ====================================================================== main
progress partition 0 "Checking the disk and the installation source"
umount_under "$WORKDIR"   # leftovers of an interrupted run
remove_created_links
resolve_source
check_disk
check_choices
if ((ALONGSIDE)); then
  mkdir -p "$WORKDIR"
  plan_alongside
  log "installing to $DISK ($((DISK_SIZE / 1000000000)) GB) next to the systems already on it"
  stage_partition_alongside
  stage_format_alongside
else
  log "installing to $DISK ($((DISK_SIZE / 1000000000)) GB)"
  stage_partition
  stage_format
fi
stage_copy
stage_configure
stage_drivers
stage_bootloader
stage_cleanup
DONE=1
if ((ALONGSIDE)); then progress "done" 100 "Selene OS has been installed on $DISK next to your other systems"
else progress "done" 100 "Selene OS has been installed on $DISK"; fi
exit 0
