def autorepeat_pair(release_time, press_time):
    """X autorepeat sends a release and a press of the held key together, with one timestamp (the two
    can land on consecutive milliseconds: SDL allows the same). No hand or keyboard re-presses that fast."""
    return (press_time - release_time) & 0xFFFFFFFF <= 1


