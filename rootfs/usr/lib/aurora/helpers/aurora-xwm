FOCUS_SHELL_FIRST = {'Alt+Tab', 'Alt+Shift+Tab', 'Super', 'Super+Tab'}

WINDOW_TYPES = {'_NET_WM_WINDOW_TYPE_NORMAL': 'normal', '_NET_WM_WINDOW_TYPE_DIALOG': 'dialog',
                '_NET_WM_WINDOW_TYPE_UTILITY': 'utility', '_NET_WM_WINDOW_TYPE_SPLASH': 'splash',
                '_NET_WM_WINDOW_TYPE_TOOLBAR': 'toolbar'}
SUPPORTED = ['_NET_SUPPORTED', '_NET_SUPPORTING_WM_CHECK', '_NET_ACTIVE_WINDOW', '_NET_CLIENT_LIST',
             '_NET_CLIENT_LIST_STACKING', '_NET_CLOSE_WINDOW', '_NET_WM_MOVERESIZE', '_NET_MOVERESIZE_WINDOW',
             '_NET_REQUEST_FRAME_EXTENTS', '_NET_FRAME_EXTENTS', '_NET_WM_NAME', '_NET_WM_ICON', '_NET_WM_PID',
             '_NET_WM_STATE', '_NET_WM_STATE_FULLSCREEN', '_NET_WM_STATE_MAXIMIZED_VERT',
             '_NET_WM_STATE_MAXIMIZED_HORZ', '_NET_WM_STATE_HIDDEN', '_NET_WM_STATE_MODAL',
             '_NET_WM_WINDOW_TYPE', '_NET_NUMBER_OF_DESKTOPS', '_NET_CURRENT_DESKTOP'] + list(WINDOW_TYPES)
# _NET_WM_MOVERESIZE directions: which edges move (left, top, right, bottom).
MOVERESIZE_EDGES = {0: (1, 1, 0, 0), 1: (0, 1, 0, 0), 2: (0, 1, 1, 0), 3: (0, 0, 1, 0),
