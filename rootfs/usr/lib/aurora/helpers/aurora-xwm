#!/usr/bin/python3 -I
"""aurora-xwm: the small X11 window manager that lets Selene Shell show real Linux GUI programs.

Usage: aurora-xwm --shell-xid <XID>        (decimal or 0x hex)

See docs/XWINDOWS.md for the design and the exact protocol. In short:
  - it takes SubstructureRedirect on the root window and never reparents;
  - the shell window (--shell-xid) is never managed: its requests are granted and it is kept above
    every client; every other top-level that asks to be mapped is a client, mapped BELOW the shell;
  - it talks to the shell's main process with JSON lines: events on stdout ({"ev": ...}),
    commands on stdin ({"cmd": ...});
  - while a client has X focus it holds passive key grabs for the system shortcuts.

AURORA_XWM_DEBUG=1 adds 'log' events (level debug) for every focus and key event.

Exit status: 0 when stdin closes (or on SIGTERM), 3 when another window manager is running
(fatal EOTHERWM), 4 when python3-xlib is missing (fatal ENOXLIB), 1 when the display cannot be
opened or is lost (fatal ENODISPLAY), 2 on a usage error.
"""
import json
import os
import select
import signal
import struct
import sys
import time
import zlib
import base64

VERSION = '1.0'
DRAG_INTERVAL = 1.0 / 60   # drag events are throttled to about 60 Hz
MAX_LINE = 1 << 20         # longest accepted command line


BEFORE_EMIT = []  # callbacks run before each event is written (flush pending X requests)


def emit(ev, **fields):
    """Write one event as a JSON line (ASCII only, so the locale never matters)."""
    fields = dict(ev=ev, **fields)
    try:
        for fn in BEFORE_EMIT:
            fn()
    except Exception:
        pass
    try:
        sys.stdout.write(json.dumps(fields, separators=(',', ':')) + '\n')
        sys.stdout.flush()
    except (BrokenPipeError, OSError):
        os._exit(0)  # the main process is gone


def log(level, message):
    emit('log', level=level, message=str(message)[:2000])


def fatal(code, message, status):
    emit('fatal', code=code, message=message)
    sys.exit(status)


def parse_args(argv):
    xid = None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == '--shell-xid' and i + 1 < len(argv):
            xid = argv[i + 1]
            i += 2
        elif a.startswith('--shell-xid='):
            xid = a.split('=', 1)[1]
            i += 1
        else:
            i += 1
    try:
        return int(xid, 0) if xid is not None else None
    except ValueError:
        return None


try:
    from Xlib import X, XK, Xatom, Xutil, display, error
    from Xlib.protocol import event as xevent
except ImportError as exc:  # pragma: no cover - depends on the system
    if __name__ == '__main__':
        fatal('ENOXLIB', 'python3-xlib is not installed (%s)' % exc, 4)
    raise

