#!/bin/bash
# aurora-admin — the privileged actions behind Selene Shell's elevation prompt (UAC).
#
# Run as root through sudo by the shell (shell/main/ipc/admin.js -> lib/exec.js sudoRun):
#     sudo -S -k -p '' -- /usr/lib/aurora/helpers/aurora-admin <action> [args...]
# /etc/sudoers.d/aurora lets members of the "sudo" group run it (password required; the live user
# has NOPASSWD rights from casper).
#
# This is an ALLOW-LIST. Every argument is validated with a strict pattern and only ever passed to
# programs as a separate argv element (never through a shell or eval). Anything else is refused.
#
# Actions:
#   ping                                         -> "pong" (used to probe the setup)
#   user-add <name> <full name> <admin 0|1> <nonce>     password read from stdin (see "Secrets")
#   user-delete <name> <keep-home 0|1>
#   user-set-admin <name> <0|1>
#   user-set-fullname <name> <full name>
#   set-password <name> <nonce>                  new password read from stdin
#   set-hostname <name>
#   set-timezone <Area/City>
#   set-ntp <0|1>
#   set-locale <en_US.UTF-8|en_GB.UTF-8|fr_FR.UTF-8|fr_CA.UTF-8|fr_BE.UTF-8|fr_CH.UTF-8>
#   set-keyboard <layout> [variant]              system default (/etc/default/keyboard: sign-in screen, new users)
#   firewall <enable|disable|status>             ufw
#   set-autologin <user|none>                    greetd [initial_session]
#   kill-process <pid> <TERM|KILL|HUP|INT|QUIT|STOP|CONT|USR1|USR2>
#   service <start|stop|restart> <unit>          systemd units (.service, .socket, .timer)
#   apt-check                                    apt-get update, then one "Inst …" line per pending upgrade
#   apt-upgrade                                  non-interactive upgrade; APT status lines on stdout
#                                                ("dlstatus:…" / "pmstatus:pkg:percent:message"), apt's own output on stderr
#   apt-autoremove                               apt-get autoremove (old kernels, unused dependencies) after an upgrade
#   drivers-install <nvidia-driver-NNN[-open|-server|-server-open]>    NVIDIA driver offered by ubuntu-drivers (see below)
#   drivers-remove                               purge the NVIDIA driver, back to nouveau
#   printer-add <queue> <uri> <label>  printer-remove <queue>  printer-default <queue>  printer-enable <queue> <0|1>
#   printer-rename <queue> <label>  printer-job-cancel <queue-N>      CUPS printers (driverless IPP Everywhere, see below)
#   firmware-update <device-id>                  fwupd: install the available firmware of one device (40 hex id, see below)
#   power-lid <suspend|ignore|poweroff>          what closing the lid does (logind drop-in, see below)
#   smart-info <whole disk>                      read-only health report (smartctl -j -a JSON) of one disk (see below)
#
# Secrets: passwords never appear on a command line. The caller passes a random nonce (32 hex
# digits) as the last argument and writes "<nonce>:<base64 of the password>" on stdin, after the
# line sudo itself reads its password from. sudo -S reads its password byte by byte up to the
# newline, so the rest of stdin reaches this script untouched; when sudo needs no password (NOPASSWD)
# that first line is still there, which is why up to two lines are read and only the one carrying
# the nonce is used.
#
# Exit codes: 0 ok, 2 invalid arguments, 3 not found / not installed, 4 refused by policy, 5 failed.
# Every action is logged to the system journal (authpriv, tag aurora-admin) — never a password.
set -euo pipefail
umask 022
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
IFS=$' \t\n'

PROG=aurora-admin
ACTION=""
CALLER="${SUDO_USER:-$(id -un 2>/dev/null || echo unknown)}"
[[ $CALLER =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || CALLER=unknown

log() { logger -t "$PROG" -p authpriv.notice -- "$*" >/dev/null 2>&1 || true; }
die() {
  local code=$1
  shift
  printf '%s: %s\n' "$PROG" "$*" >&2
  log "user=$CALLER action=${ACTION:-none} refused/failed: $*"
  exit "$code"
}
run_or_die() { # run_or_die <message> cmd args... : runs cmd, maps a failure to exit code 5
  local msg=$1
  shift
  "$@" || die 5 "$msg"
}

[ "$(id -u)" -eq 0 ] || die 4 "must be run as root (through sudo)"
[ $# -ge 1 ] || die 2 "usage: $PROG <action> [arguments]"
ACTION=$1
shift

# ------------------------------------------------------------------ BEGIN apt_update (Selene updates, docs/UPDATES.md)
# apt_update [apt-get options...]: "apt-get update". When it fails and the Selene repository is configured
# (/etc/apt/sources.list.d/selene.sources), retry without that one source, so that an unreachable, unpublished
# (404) or wrongly signed Selene repository never blocks Ubuntu updates or the drivers path (--error-on=any).
selene_autoenable() { # selene.sources ships disabled until its repository is published (tools/build-debs.sh)
  local sel=/etc/apt/sources.list.d/selene.sources url suite
  [ -f "$sel" ] && grep -qx 'Enabled: no' "$sel" && grep -qx '# auto-enable when published' "$sel" || return 0
  url=$(sed -n 's|^URIs: \(https://[A-Za-z0-9./_~-]*\)$|\1|p' "$sel" | head -n1)
  suite=$(sed -n 's|^Suites: \([a-z0-9-]*\)$|\1|p' "$sel" | head -n1)
  [ -n "$url" ] && [ -n "$suite" ] || return 0
  command -v curl >/dev/null 2>&1 || return 0
  if curl -fsS --max-time 15 -o /dev/null "${url%/}/dists/$suite/InRelease" 2>/dev/null; then
    sed -i 's/^Enabled: no$/Enabled: yes/' "$sel" && log "the Selene repository is published: selene.sources enabled"
  fi
  return 0
}
apt_update() {
  selene_autoenable
  apt-get -q "$@" -o DPkg::Lock::Timeout=120 update && return 0
  local sel=/etc/apt/sources.list.d/selene.sources parts f rc=0
  [ -f "$sel" ] || return 1
  log "apt-get update failed; retrying without the Selene repository"
  echo "W: the Selene repository could not be used; Ubuntu updates continue without it" >&2
  parts=$(mktemp -d /run/aurora-apt-parts.XXXXXX) || return 1
  for f in /etc/apt/sources.list.d/*; do
    [ -f "$f" ] && [ "$f" != "$sel" ] && ln -s "$f" "$parts/"
  done
  apt-get -q "$@" -o DPkg::Lock::Timeout=120 -o Dir::Etc::SourceParts="$parts" update || rc=$?
  rm -rf -- "$parts"
  return "$rc"
}
# ------------------------------------------------------------------ END apt_update

# ------------------------------------------------------------------ validation helpers
RE_USER='^[a-z_][a-z0-9_-]{0,31}$'
RESERVED_USERS=" root daemon bin sys sync games man lp mail news uucp proxy www-data backup list irc gnats nobody systemd-network systemd-resolve systemd-timesync messagebus syslog _apt tss uuidd tcpdump sshd polkitd _greetd greeter aurora-greeter admin sudo adm users "

need_args() { # need_args <got> <min> [max]
  local got=$1 min=$2 max=${3:-$2}
  { [ "$got" -ge "$min" ] && [ "$got" -le "$max" ]; } || die 2 "$ACTION: wrong number of arguments"
}
valid_user() { [[ $1 =~ $RE_USER ]] || die 2 "invalid user name"; }
valid_bool() { [[ $1 =~ ^[01]$ ]] || die 2 "expected 0 or 1"; }
valid_nonce() { [[ $1 =~ ^[0-9a-f]{32}$ ]] || die 2 "invalid secret nonce"; }
valid_fullname() {
  local v=$1
  [ ${#v} -le 256 ] || die 2 "full name too long"
  [[ $v =~ [[:cntrl:]] ]] && die 2 "invalid characters in the full name"
  case $v in *[:,=\\]*) die 2 "the full name cannot contain : , = or \\" ;; esac
  return 0
}
uid_of() { getent passwd "$1" | cut -d: -f3; }
is_human_user() {
  local uid
  uid=$(uid_of "$1") || return 1
  [ -n "$uid" ] && [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ]
}
require_human_user() {
  valid_user "$1"
  is_human_user "$1" || die 3 "no such user account: $1"
}
in_group() { id -nG -- "$1" 2>/dev/null | tr ' ' '\n' | grep -qx -- "$2"; }
admin_count_except() { # number of human administrators other than $1
  local n=0 u
  for u in $(getent group sudo | cut -d: -f4 | tr ',' ' '); do
    [ "$u" = "$1" ] && continue
    is_human_user "$u" && n=$((n + 1))
  done
  echo "$n"
}

SECRET=""
read_secret() { # read_secret <nonce>
  local nonce=$1 line b64 _
  SECRET=""
  for _ in 1 2; do
    IFS= read -r -t 15 line || break
    if [[ $line == "$nonce:"* ]]; then
      b64=${line#"$nonce:"}
      [[ $b64 =~ ^[A-Za-z0-9+/]*={0,2}$ ]] || die 2 "malformed secret"
      SECRET=$(printf '%s' "$b64" | base64 -d 2>/dev/null) || die 2 "malformed secret"
      break
    fi
  done
  # Nothing else may read what is left on stdin (useradd, chpasswd…): the secret is in $SECRET now.
  exec </dev/null
  [ -n "$SECRET" ] || die 2 "no password was provided"
  [ ${#SECRET} -le 256 ] || die 2 "the password is too long"
  case $SECRET in *$'\n'* | *$'\r'*) die 2 "the password cannot contain line breaks" ;; esac
  return 0
}
set_password() { # set_password <user>  (uses $SECRET; chpasswd reads "user:password" on stdin)
  printf '%s:%s\n' "$1" "$SECRET" | chpasswd || die 5 "could not set the password"
}

GREETD_CONF=/etc/greetd/config.toml
greetd_without_initial() { # prints the greetd config without its [initial_session] table
  awk '/^[[:space:]]*\[/ { skip = ($0 ~ /^[[:space:]]*\[initial_session\][[:space:]]*$/) } !skip' "$GREETD_CONF"
}
write_file_atomic() { # write_file_atomic <path> <mode>   (content on stdin)
  local dst=$1 mode=$2 tmp
  tmp=$(mktemp "${dst}.aurora.XXXXXX")
  cat >"$tmp"
  chmod "$mode" "$tmp"
  mv -f -- "$tmp" "$dst"
}

log "user=$CALLER action=$ACTION"

# Only user-add and set-password read stdin (their secret, see read_secret). Every other action, and
# every program an action starts (apt-get, dpkg maintainer scripts, ufw…), gets /dev/null: when sudo
# needed no password, the line the shell wrote for it is still unread on stdin.
case $ACTION in
user-add | set-password) ;;
*) exec </dev/null ;;
esac

case $ACTION in
# ------------------------------------------------------------------ accounts
ping)
  need_args $# 0
  echo pong
  ;;

user-add)
  need_args $# 4
  name=$1 full=$2 admin=$3 nonce=$4
  valid_user "$name"
  valid_fullname "$full"
  valid_bool "$admin"
  valid_nonce "$nonce"
  case $RESERVED_USERS in *" $name "*) die 4 "this user name is reserved" ;; esac
  getent passwd "$name" >/dev/null && die 4 "the user name $name is already in use"
  getent group "$name" >/dev/null && die 4 "the name $name is already used by a group"
  read_secret "$nonce"
  groups=""
  for g in users audio video plugdev netdev bluetooth lpadmin; do
    getent group "$g" >/dev/null && groups="$groups,$g"
  done
  if [ "$admin" = 1 ]; then
    for g in sudo adm; do getent group "$g" >/dev/null && groups="$groups,$g"; done
  fi
  args=(--create-home --user-group --shell /bin/bash --comment "$full")
  [ -n "$groups" ] && args+=(--groups "${groups#,}")
  run_or_die "could not create the account" useradd "${args[@]}" -- "$name"
  if ! printf '%s:%s\n' "$name" "$SECRET" | chpasswd; then
    userdel --remove -- "$name" >/dev/null 2>&1 || true
    die 5 "could not set the password (account not created)"
  fi
  log "user=$CALLER created account $name (admin=$admin)"
  echo "created $name"
  ;;

user-delete)
  need_args $# 2
  name=$1 keep=$2
  require_human_user "$name"
  valid_bool "$keep"
  [ "$name" != "$CALLER" ] || die 4 "you can't remove the account you are signed in with"
  if pgrep -u "$name" >/dev/null 2>&1; then die 4 "$name is signed in; sign them out first"; fi
  if [ -f "$GREETD_CONF" ] && greetd_user=$(awk '/^\[/{s=($0 ~ /^\[initial_session\]/)} s && /^[[:space:]]*user[[:space:]]*=/ {gsub(/.*=[[:space:]]*"|".*/, ""); print; exit}' "$GREETD_CONF") && [ "$greetd_user" = "$name" ]; then
    greetd_without_initial | write_file_atomic "$GREETD_CONF" 644
  fi
  if [ "$keep" = 1 ]; then
    run_or_die "could not remove the account" userdel -- "$name"
  else
    # userdel -r warns (exit 12) when the mail spool does not exist; the account is gone either way.
    userdel --remove -- "$name" 2>/dev/null || { getent passwd "$name" >/dev/null && die 5 "could not remove the account"; }
  fi
  log "user=$CALLER removed account $name (keep-home=$keep)"
  echo "removed $name"
  ;;

user-set-admin)
  need_args $# 2
  name=$1 admin=$2
  require_human_user "$name"
  valid_bool "$admin"
  getent group sudo >/dev/null || die 3 "the sudo group does not exist"
  if [ "$admin" = 1 ]; then
    in_group "$name" sudo || run_or_die "could not change the account type" gpasswd -a "$name" sudo >/dev/null
    if getent group adm >/dev/null && ! in_group "$name" adm; then gpasswd -a "$name" adm >/dev/null || true; fi
  else
    [ "$(admin_count_except "$name")" -ge 1 ] || die 4 "at least one administrator account is required"
    in_group "$name" sudo && run_or_die "could not change the account type" gpasswd -d "$name" sudo >/dev/null
    if getent group adm >/dev/null && in_group "$name" adm; then gpasswd -d "$name" adm >/dev/null || true; fi
  fi
  echo "ok"
  ;;

user-set-fullname)
  need_args $# 2
  name=$1 full=$2
  require_human_user "$name"
  valid_fullname "$full"
  run_or_die "could not change the name" usermod --comment "$full" -- "$name"
  echo "ok"
  ;;

set-password)
  need_args $# 2
  name=$1 nonce=$2
  require_human_user "$name"
  valid_nonce "$nonce"
  read_secret "$nonce"
  set_password "$name"
  log "user=$CALLER changed the password of $name"
  echo "ok"
  ;;

set-autologin)
  need_args $# 1
  target=$1
  [ -f "$GREETD_CONF" ] || die 3 "greetd is not configured ($GREETD_CONF missing)"
  if [ "$target" != none ]; then require_human_user "$target"; fi
  {
    greetd_without_initial
    if [ "$target" != none ]; then
      printf '\n[initial_session]\ncommand = "/usr/bin/aurora-session"\nuser = "%s"\n' "$target"
    fi
  } | write_file_atomic "$GREETD_CONF" 644
  echo "ok"
  ;;

# ------------------------------------------------------------------ system
set-hostname)
  need_args $# 1
  host=$1
  [[ $host =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]] || die 2 "invalid device name (letters, digits and hyphens, up to 63 characters)"
  if ! hostnamectl set-hostname "$host" 2>/dev/null; then
    printf '%s\n' "$host" | write_file_atomic /etc/hostname 644
    hostname "$host" || true
  fi
  if grep -qE '^127\.0\.1\.1[[:space:]]' /etc/hosts; then
    sed -i -E "s/^127\.0\.1\.1[[:space:]].*/127.0.1.1\t$host/" /etc/hosts
  else
    printf '127.0.1.1\t%s\n' "$host" >>/etc/hosts
  fi
  echo "ok"
  ;;

set-timezone)
  need_args $# 1
  tz=$1
  [[ $tz =~ ^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+){0,2}$ ]] || die 2 "invalid time zone"
  case $tz in posix/* | right/* | */../* | ..*) die 2 "invalid time zone" ;; esac
  [ -f "/usr/share/zoneinfo/$tz" ] || die 3 "unknown time zone: $tz"
  if ! timedatectl set-timezone "$tz" 2>/dev/null; then
    ln -sfn "/usr/share/zoneinfo/$tz" /etc/localtime
    printf '%s\n' "$tz" | write_file_atomic /etc/timezone 644
  fi
  echo "ok"
  ;;

set-ntp)
  need_args $# 1
  valid_bool "$1"
  if [ "$1" = 1 ]; then v=true; else v=false; fi
  run_or_die "could not change automatic time synchronization" timedatectl set-ntp "$v"
  echo "ok"
  ;;

set-locale)
  need_args $# 1
  loc=$1
  case $loc in
  en_US.UTF-8 | en_GB.UTF-8 | fr_FR.UTF-8 | fr_CA.UTF-8 | fr_BE.UTF-8 | fr_CH.UTF-8) ;;
  *) die 2 "unsupported locale: $loc" ;;
  esac
  short=${loc%%.*}
  if ! locale -a 2>/dev/null | grep -qix -- "${short}.utf8"; then
    run_or_die "could not generate the locale $loc" locale-gen "$loc" >/dev/null
  fi
  run_or_die "could not set the system locale" update-locale "LANG=$loc" "LANGUAGE=$short:${short%%_*}"
  echo "ok"
  ;;

set-keyboard)
  need_args $# 1 2
  layout=$1 variant=${2:-}
  [[ $layout =~ ^[a-z]{2,3}$ ]] || die 2 "invalid keyboard layout"
  [[ $variant =~ ^[a-z0-9_-]{0,32}$ ]] || die 2 "invalid keyboard variant"
  sym=/usr/share/X11/xkb/symbols/$layout
  [ -f "$sym" ] || die 3 "unknown keyboard layout: $layout"
  if [ -n "$variant" ]; then grep -q "xkb_symbols \"$variant\"" "$sym" || die 3 "unknown variant $variant for layout $layout"; fi
  XKBMODEL=pc105 XKBOPTIONS="" BACKSPACE=guess
  # shellcheck disable=SC1091
  [ -r /etc/default/keyboard ] && . /etc/default/keyboard
  [[ ${XKBMODEL:-} =~ ^[A-Za-z0-9_-]*$ ]] || XKBMODEL=pc105
  [[ ${XKBOPTIONS:-} =~ ^[A-Za-z0-9_:,-]*$ ]] || XKBOPTIONS=""
  [[ ${BACKSPACE:-} =~ ^[a-z]*$ ]] || BACKSPACE=guess
  printf '# KEYBOARD CONFIGURATION FILE\n\n# Consult the keyboard(5) manual page.\n\nXKBMODEL="%s"\nXKBLAYOUT="%s"\nXKBVARIANT="%s"\nXKBOPTIONS="%s"\n\nBACKSPACE="%s"\n' \
    "${XKBMODEL:-pc105}" "$layout" "$variant" "${XKBOPTIONS:-}" "${BACKSPACE:-guess}" | write_file_atomic /etc/default/keyboard 644
  command -v setupcon >/dev/null 2>&1 && { setupcon --save-only >/dev/null 2>&1 || true; }
  echo "ok"
  ;;

firewall)
  need_args $# 1
  case $1 in enable | disable | status) ;; *) die 2 "expected enable, disable or status" ;; esac
  command -v ufw >/dev/null 2>&1 || die 3 "the firewall (ufw) is not installed"
  case $1 in
  enable) run_or_die "could not turn the firewall on" ufw --force enable ;;
  disable) run_or_die "could not turn the firewall off" ufw disable ;;
  status) ufw status verbose ;;
  *) die 2 "expected enable, disable or status" ;;
  esac
  ;;

kill-process)
  need_args $# 2
  pid=$1 sig=$2
  [[ $pid =~ ^[1-9][0-9]{0,9}$ ]] || die 2 "invalid process id"
  [ "$pid" -gt 1 ] || die 4 "refusing to signal process 1"
  if [ "$pid" -eq $$ ] || [ "$pid" -eq "$PPID" ]; then die 4 "refusing to signal the helper itself"; fi
  case $sig in TERM | KILL | HUP | INT | QUIT | STOP | CONT | USR1 | USR2) ;; *) die 2 "invalid signal" ;; esac
  [ -d "/proc/$pid" ] || die 3 "no such process: $pid"
  run_or_die "could not signal process $pid" kill -s "$sig" -- "$pid"
  echo "ok"
  ;;

service)
  need_args $# 2
  verb=$1 unit=$2
  case $verb in start | stop | restart) ;; *) die 2 "expected start, stop or restart" ;; esac
  [[ $unit =~ ^[A-Za-z0-9][A-Za-z0-9@._:-]{0,120}$ ]] || die 2 "invalid unit name"
  case $unit in *.service | *.socket | *.timer) ;; *.*) die 2 "only .service, .socket and .timer units" ;; *) unit=$unit.service ;; esac
  run_or_die "could not $verb $unit" systemctl "$verb" "$unit"
  echo "ok"
  ;;

# ------------------------------------------------------------------ updates
apt-check)
  need_args $# 0
  export DEBIAN_FRONTEND=noninteractive
  apt_update >&2 || die 5 "could not refresh the package lists (check the network connection)"
  sim=$(apt-get -s -q -o Debug::NoLocking=1 upgrade --with-new-pkgs) || die 5 "could not compute the available updates"
  printf '%s\n' "$sim" | grep '^Inst ' || true
  ;;

apt-upgrade)
  need_args $# 0
  export DEBIAN_FRONTEND=noninteractive
  # APT status lines (fd 3) go to stdout for the progress bar; apt's normal output to stderr.
  apt-get -q -y -o DPkg::Lock::Timeout=120 \
    -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold \
    -o APT::Status-Fd=3 upgrade --with-new-pkgs 3>&1 1>&2 || die 5 "the update failed (see the system journal)"
  [ -e /run/reboot-required ] && echo "reboot-required"
  echo "done"
  ;;

# ------------------------------------------------------------------ BEGIN apt-autoremove (image track)
# apt-autoremove: after « Mettre à jour » (Paramètres > Mises à jour), remove the packages nothing needs any more
# (old kernels: apt always keeps the running and the newest one; image packages are marked manual and stay).
# APT status lines on stdout, apt's own output on stderr, then "done".
apt-autoremove)
  need_args $# 0
  export DEBIAN_FRONTEND=noninteractive
  apt-get -q -y -o DPkg::Lock::Timeout=120 -o APT::Status-Fd=3 autoremove 3>&1 1>&2 \
    || die 5 "could not remove the unused packages (see the system journal)"
  echo "done"
  ;;
# ------------------------------------------------------------------ END apt-autoremove

# ------------------------------------------------------------------ BEGIN store actions (Store app)
#   store-install <package>    apt-get -y install --no-install-recommends; APT status lines on stdout
#   store-remove <package>     apt-get -y remove; APT status lines on stdout. Refused for catalog entries with
#                              "removable": false and when apt would also remove other packages.
# Only packages listed as "apt": "<name>" in the root-owned catalog /usr/share/aurora/store/catalog.json, or
# (Store source "ubuntu") listed as a desktop application in the archive's AppStream data that apt downloads into
# /var/lib/apt/lists (root-owned regular *_dep11_Components-<arch>.yml.gz files; the "appstream" package makes apt
# fetch them). store-install runs "apt-get update" once when such a package is not found on the first try.
store-install | store-remove)
  need_args $# 1
  pkg=$1
  [[ $pkg =~ ^[a-z0-9][a-z0-9+.-]{1,62}$ ]] || die 2 "invalid package name"
  # A trailing '-' would turn "apt-get install <pkg>" into a removal.
  [[ $pkg == *- ]] && die 2 "invalid package name"
  STORE_CATALOG=/usr/share/aurora/store/catalog.json
  { [ -f "$STORE_CATALOG" ] && [ ! -L "$STORE_CATALOG" ]; } || die 3 "the store catalog is missing"
  [ "$(stat -c %u -- "$STORE_CATALOG")" = 0 ] || die 4 "the store catalog is not owned by root"
  # "removable" or "fixed" (shipped with Selene OS: "removable": false); not in the catalog -> refused.
  store_kind=$(python3 -I -c 'import json, sys
for it in json.load(open(sys.argv[1])).get("items", []):
    if isinstance(it, dict) and it.get("apt") == sys.argv[2]:
        print("fixed" if it.get("removable") is False else "removable")
        sys.exit(0)
sys.exit(1)' "$STORE_CATALOG" "$pkg") || store_kind=""
  # store_dep11_has <package> <lists dir>: true when a root-owned regular DEP-11 Components file of <lists dir>
  # lists <package> as a desktop application (shell/test/store-ubuntu.test.mjs runs this function on a test dir).
  store_dep11_has() {
    python3 -I -c 'import glob, gzip, lzma, os, stat, sys
pkg, top = sys.argv[1], sys.argv[2]
for path in sorted(glob.glob(os.path.join(top, "*_dep11_Components-*.yml.gz")) + glob.glob(os.path.join(top, "*_dep11_Components-*.yml.xz"))):
    try:
        st = os.lstat(path)
    except OSError:
        continue
    if not stat.S_ISREG(st.st_mode) or st.st_uid != 0:
        continue
    kind = name = None
    try:
        with (lzma if path.endswith(".xz") else gzip).open(path, "rt", encoding="utf-8", errors="replace") as f:
            for line in f:
                if line.startswith("---"):
                    kind = name = None
                    continue
                if line.startswith("Type: "):
                    kind = line[6:].strip()
                elif line.startswith("Package: "):
                    name = line[9:].strip()
                else:
                    continue
                if kind == "desktop-application" and name == pkg:
                    sys.exit(0)
    except (OSError, EOFError, ValueError, lzma.LZMAError):
        continue
sys.exit(1)' "$1" "$2"
  }
  STORE_APT_LISTS=/var/lib/apt/lists
  if [ -z "$store_kind" ]; then
    if store_dep11_has "$pkg" "$STORE_APT_LISTS"; then
      store_kind=removable
    elif [ "$ACTION" = store-install ]; then
      # Missing or stale lists (fresh install): refresh them once and look again.
      apt_update >&2 || die 5 "could not refresh the package lists (check the network connection)"
      store_dep11_has "$pkg" "$STORE_APT_LISTS" && store_kind=removable
    fi
    [ -n "$store_kind" ] || die 4 "this package is not in the store catalog: $pkg"
  fi
  export DEBIAN_FRONTEND=noninteractive
  if [ "$ACTION" = store-install ]; then
    store_apt_install() {
      # Never take other packages along: apt-get -y install removes the installed packages that conflict.
      store_others=$(apt-get -s -q -o DPkg::Lock::Timeout=120 --no-install-recommends install "$pkg" 2>/dev/null | awk '$1 == "Remv" { printf "%s ", $2 }') || true
      [ -z "$store_others" ] || die 6 "installing $pkg would remove: ${store_others% }"
      apt-get -q -y -o DPkg::Lock::Timeout=120 --no-install-recommends \
        -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold \
        -o APT::Status-Fd=3 install "$pkg" 3>&1 1>&2
    }
    # Stale or missing package lists (fresh install): refresh them once and retry.
    if ! store_apt_install; then
      apt_update >&2 || die 5 "could not refresh the package lists (check the network connection)"
      store_apt_install || die 5 "could not install $pkg (see the system journal)"
    fi
  else
    [ "$store_kind" = fixed ] && die 6 "$pkg is part of Selene OS and cannot be removed from the Store"
    # Packages shipped in the image (list written by the ISO build) are never removed from the Store, even when
    # they are desktop applications of the Ubuntu catalogue.
    STORE_BASE=/usr/share/aurora/store/base-packages.txt
    if [ -f "$STORE_BASE" ] && [ ! -L "$STORE_BASE" ] && [ "$(stat -c %u -- "$STORE_BASE")" = 0 ] \
       && grep -qxF -- "$pkg" "$STORE_BASE"; then
      die 6 "$pkg is part of Selene OS and cannot be removed from the Store"
    fi
    # Never take other packages along (apt removes everything that depends on $pkg without asking).
    store_others=$(apt-get -s -q -o DPkg::Lock::Timeout=120 remove "$pkg" 2>/dev/null | awk -v p="$pkg" '$1 == "Remv" && $2 != p { printf "%s ", $2 }') || true
    [ -z "$store_others" ] || die 6 "removing $pkg would also remove: ${store_others% }"
    apt-get -q -y -o DPkg::Lock::Timeout=120 -o APT::Status-Fd=3 remove "$pkg" 3>&1 1>&2 || die 5 "could not remove $pkg (see the system journal)"
  fi
  echo "done"
  ;;
# ------------------------------------------------------------------ END store actions

# ------------------------------------------------------------------ BEGIN disks (Disks app)
#   format-removable <device> <vfat|exfat|ext4> <label>
#       Erases a whole REMOVABLE disk (USB stick, SD card: /sys/block/<dev>/removable = 1 or TRAN = usb), then creates
#       one msdos partition covering it and one file system. Refused: a partition or a non-removable disk, a disk that
#       holds /, /boot, /usr, /var, /home, the live medium (/cdrom, /run/live, /rofs), active swap, a partition used by
#       LVM / encryption / RAID, or a mounted partition that cannot be unmounted. Prints "ok <partition>".
format-removable)
  need_args $# 3
  dev=$1 fstype=$2 label=$3
  [[ $dev =~ ^/dev/(sd[a-z]{1,2}|mmcblk[0-9]{1,2})$ ]] || die 2 "expected a whole disk such as /dev/sdb or /dev/mmcblk0"
  case $fstype in vfat | exfat | ext4) ;; *) die 2 "expected vfat, exfat or ext4" ;; esac
  [[ $label =~ ^[A-Za-z0-9_\ -]{0,16}$ ]] || die 2 "invalid label (letters, digits, spaces, - and _)"
  case $fstype in
  vfat) label=${label^^}; [ ${#label} -le 11 ] || die 2 "FAT labels are limited to 11 characters" ;;
  exfat) [ ${#label} -le 15 ] || die 2 "exFAT labels are limited to 15 characters" ;;
  esac
  dname=${dev#/dev/}
  [ -b "$dev" ] || die 3 "no such disk: $dev"
  [ -d "/sys/block/$dname" ] || die 2 "$dev is not a whole disk"
  [ "$(lsblk -dno TYPE -- "$dev" 2>/dev/null | tr -d '[:space:]')" = disk ] || die 2 "$dev is not a disk"
  rm_flag=$(cat "/sys/block/$dname/removable" 2>/dev/null || echo 0)
  tran=$(lsblk -dno TRAN -- "$dev" 2>/dev/null | tr -d '[:space:]')
  [ "$rm_flag" = 1 ] || [ "$tran" = usb ] || die 4 "$dev is not a removable drive"
  [ "$(cat "/sys/block/$dname/ro" 2>/dev/null || echo 0)" = 0 ] || die 4 "$dev is write-protected"
  # Never the disk that holds the running system or the live medium.
  for target in / /boot /boot/efi /usr /var /home /cdrom /run/live/medium /rofs; do
    src=$(findmnt -no SOURCE --target "$target" 2>/dev/null | head -n1) || true
    { [ -n "$src" ] && [ -b "$src" ]; } || continue
    if lsblk -nso NAME -- "$src" 2>/dev/null | sed 's/^[^[:alnum:]]*//' | grep -qx -- "$dname"; then
      die 4 "$dev holds the system or the live medium"
    fi
  done
  mapfile -t fr_nodes < <(lsblk -lnpo NAME -- "$dev" 2>/dev/null)
  for node in "${fr_nodes[@]}"; do
    [ "$node" = "$dev" ] && continue
    if swapon --show=NAME --noheadings --raw 2>/dev/null | grep -qxF -- "$node"; then die 4 "$node is in use as swap"; fi
    base=${node##*/}
    if [ -d "/sys/block/$dname/$base/holders" ] && [ -n "$(ls -A "/sys/block/$dname/$base/holders" 2>/dev/null)" ]; then
      die 4 "$node is in use (LVM, encryption or RAID)"
    fi
    while IFS= read -r target; do
      [ -n "$target" ] || continue
      case $target in / | /boot* | /usr | /var | /home | /cdrom* | /run/live* | /rofs) die 4 "$dev holds the system or the live medium" ;; esac
    done < <(findmnt -rno TARGET -S "$node" 2>/dev/null)
  done
  # Unmount whatever is still mounted (most recent mount first); give up if it stays busy.
  for node in "${fr_nodes[@]}"; do
    for _ in 1 2 3 4 5; do
      findmnt -rno TARGET -S "$node" >/dev/null 2>&1 || break
      umount -- "$node" 2>/dev/null || { sleep 1; umount -- "$node" 2>/dev/null || die 4 "could not unmount $node (a program is using it)"; }
    done
    if findmnt -rno TARGET -S "$node" >/dev/null 2>&1; then die 4 "could not unmount $node (a program is using it)"; fi
  done
  case $fstype in
  vfat) mkfs_bin=mkfs.vfat parted_fs=fat32 ;;
  exfat) mkfs_bin=mkfs.exfat parted_fs=ntfs ;; # MBR type 0x07 (exFAT / NTFS)
  ext4) mkfs_bin=mkfs.ext4 parted_fs=ext4 ;;
  esac
  command -v "$mkfs_bin" >/dev/null 2>&1 || die 3 "$mkfs_bin is not installed"
  command -v parted >/dev/null 2>&1 || die 3 "parted is not installed"
  log "user=$CALLER formatting $dev ($fstype, label '$label')"
  wipefs -a -q -- "$dev" >/dev/null 2>&1 || true
  run_or_die "could not create the partition table on $dev" parted -s -a optimal -- "$dev" mklabel msdos mkpart primary "$parted_fs" 1MiB 100%
  partprobe -- "$dev" >/dev/null 2>&1 || true
  udevadm settle --timeout=10 >/dev/null 2>&1 || true
  case $dname in mmcblk*) part=${dev}p1 ;; *) part=${dev}1 ;; esac
  for _ in $(seq 1 20); do [ -b "$part" ] && break; sleep 0.5; done
  [ -b "$part" ] || die 5 "the new partition $part did not appear"
  wipefs -a -q -- "$part" >/dev/null 2>&1 || true
  case $fstype in
  vfat) mkfs_args=(-F 32) ; [ -n "$label" ] && mkfs_args+=(-n "$label") ;;
  exfat) mkfs_args=() ; [ -n "$label" ] && mkfs_args+=(-L "$label") ;;
  ext4)
    mkfs_args=(-F -q)
    [ -n "$label" ] && mkfs_args+=(-L "$label")
    # The person formatting it owns the new file system's root folder (else only root could write to the stick).
    if [ "$CALLER" != unknown ] && owner_uid=$(id -u -- "$CALLER" 2>/dev/null) && owner_gid=$(id -g -- "$CALLER" 2>/dev/null); then
      mkfs_args+=(-E "root_owner=$owner_uid:$owner_gid")
    fi
    ;;
  esac
  run_or_die "could not create the $fstype file system on $part" "$mkfs_bin" "${mkfs_args[@]}" -- "$part" >&2
  udevadm settle --timeout=10 >/dev/null 2>&1 || true
  log "user=$CALLER formatted $dev ($fstype)"
  echo "ok $part"
  ;;
# ------------------------------------------------------------------ END disks

# ------------------------------------------------------------------ BEGIN smart (Disks app: Santé du disque)
#   smart-info <whole disk>
#       Read-only health report of ONE whole disk (/dev/sdX or /dev/nvmeNnM) as smartctl's JSON, for drives udisks2 has
#       no health data for (USB enclosures whose bridge only smartctl knows, SAS / SCSI disks). The only smartctl options
#       ever used are -j -a (print all SMART / health information), and once -d sat (generic SAT pass-through) for a
#       USB bridge smartctl does not recognise. Never a self-test, never SMART on/off, never offline data collection.
#       Prints the JSON. Exit 3 when the disk gives no health data (or smartmontools is missing), 5 when smartctl failed.
smart-info)
  # smart_report <whole disk>: smartctl's JSON on stdout; returns 0, 3 (no health data) or 5 (failed). SMART_CMD is set
  # below (tests replace it with a fake). smartctl's exit status is a bit mask: bit 0 = bad command line, bit 1 = the
  # device could not be opened or gave no IDENTIFY / health data; the other bits only describe the disk's health.
  smart_report() {
    local dev=$1 out rc=0
    out=$("${SMART_CMD[@]}" -j -a -- "$dev" 2>/dev/null) || rc=$?
    if ((rc & 2)) && [[ $dev == /dev/sd* ]]; then
      rc=0
      out=$("${SMART_CMD[@]}" -j -a -d sat -- "$dev" 2>/dev/null) || rc=$?
    fi
    ((rc & 1)) && return 5
    ((rc & 2)) && return 3
    [[ $out == \{*\} ]] || return 5
    printf '%s\n' "$out"
  }
  need_args $# 1
  [[ $1 =~ ^/dev/(sd[a-z]{1,2}|nvme[0-9]{1,2}n[0-9]{1,2})$ ]] || die 2 "expected a whole disk such as /dev/sdb or /dev/nvme0n1"
  [ -b "$1" ] || die 3 "no such disk: $1"
  [ "$(lsblk -dno TYPE -- "$1" 2>/dev/null | tr -d '[:space:]')" = disk ] || die 2 "$1 is not a whole disk"
  command -v smartctl >/dev/null 2>&1 || die 3 "smartmontools is not installed"
  SMART_CMD=(timeout 90 smartctl)
  smart_rc=0
  smart_report "$1" || smart_rc=$?
  case $smart_rc in
  0) log "user=$CALLER read the health report of $1" ;;
  3) die 3 "$1 gives no health data" ;;
  *) die 5 "smartctl could not read $1" ;;
  esac
  ;;
# ------------------------------------------------------------------ END smart

# ------------------------------------------------------------------ BEGIN drivers (Paramètres > Pilotes graphiques)
#   drivers-install <nvidia-driver-NNN[-open|-server|-server-open]>
#       apt-get update, then the package must be offered for this machine by `ubuntu-drivers devices` (the archive's
#       driver list matched against the PCI ids of the graphics card). Installed with `ubuntu-drivers install
#       nvidia:NNN[-open…]`, which takes the prebuilt kernel modules signed by Canonical (linux-modules-nvidia-NNN-<kernel
#       flavour>): Secure Boot keeps working without enrolling a key (MOK). Another NVIDIA driver already installed is
#       replaced by apt (the driver packages conflict with each other).
#   drivers-remove
#       purges the installed NVIDIA driver packages (nvidia-*-NNN, libnvidia-*-NNN, linux-modules|objects|signatures-
#       nvidia-*, nvidia-prime, nvidia-settings) and goes back to the free driver (nouveau): an /etc/X11/xorg.conf that
#       names the nvidia driver is moved aside, the initramfs is rebuilt. Refused when apt would remove anything else.
#   Progress on stdout: "step:<refresh|check|install|remove|initramfs>" lines, APT status lines ("dlstatus:…",
#   "pmstatus:…"), then "reboot-required" and "done". apt's own output goes to stderr. Refused in the live session.
drivers-install | drivers-remove)
  # drivers_listed <package>: true when the `ubuntu-drivers devices` output on stdin offers <package>
  # (lines "driver   : nvidia-driver-550 - distro non-free recommended"). Unit-tested by shell/test/drivers.unit.mjs.
  drivers_listed() {
    awk -v p="$1" '$1 == "driver" && $2 == ":" && $3 == p { found = 1 } END { exit !found }'
  }
  # drivers_nvidia_pkgs: NVIDIA driver packages among the dpkg-query lines "<Status> <Package>" on stdin
  # (installed or with configuration files left). Unit-tested by shell/test/drivers.unit.mjs.
  drivers_nvidia_pkgs() {
    awk '($3 == "installed" || $3 == "config-files") && ($4 ~ /^(nvidia-|libnvidia-|xserver-xorg-video-nvidia-)([a-z0-9.+]+-)*[0-9][0-9][0-9](-open|-server|-server-open)?(-[a-z0-9.+-]+)?$/ || $4 ~ /^linux-(modules|objects|signatures)-nvidia-[a-z0-9.+-]+$/ || $4 == "nvidia-prime" || $4 == "nvidia-settings") { print $4 }'
  }
  # drivers_status_filter: APT status lines to stdout (progress bar), everything else to stderr (journal / errors)
  drivers_status_filter() {
    local line
    while IFS= read -r line; do
      case $line in
      dlstatus:* | pmstatus:* | pmerror:* | pmconffile:*) printf '%s\n' "$line" ;;
      *) printf '%s\n' "$line" >&2 ;;
      esac
    done
  }
  grep -qw 'boot=casper' /proc/cmdline 2>/dev/null && die 4 "graphics drivers cannot be installed in the live session: install Selene OS first"
  export DEBIAN_FRONTEND=noninteractive
  if [ "$ACTION" = drivers-install ]; then
    need_args $# 1
    pkg=$1
    [[ $pkg =~ ^nvidia-driver-[0-9]{3}(-open|-server|-server-open)?$ ]] || die 2 "invalid driver package name"
    command -v ubuntu-drivers >/dev/null 2>&1 || die 3 "ubuntu-drivers is not installed (package ubuntu-drivers-common)"
    echo "step:refresh"
    apt_update --error-on=any >&2 || die 5 "could not refresh the package lists (check the Internet connection)"
    echo "step:check"
    drv_devices=$(ubuntu-drivers devices 2>/dev/null) || die 5 "could not list the drivers available for this computer"
    printf '%s\n' "$drv_devices" | drivers_listed "$pkg" || die 4 "$pkg is not offered for the graphics card of this computer"
    echo "step:install"
    # APT status lines on apt-get's stdout (ubuntu-drivers runs apt-get as a child process; its stdout is inherited,
    # extra file descriptors are not). APT_CONFIG is read in addition to /etc/apt/apt.conf{,.d}.
    drv_conf=$(mktemp /run/aurora-drivers-apt.XXXXXX)
    printf '%s\n' 'APT::Status-Fd "1";' 'DPkg::Lock::Timeout "120";' 'Dpkg::Options { "--force-confdef"; "--force-confold"; };' >"$drv_conf"
    drv_rc=0
    APT_CONFIG=$drv_conf ubuntu-drivers install "nvidia:${pkg#nvidia-driver-}" 2>&1 </dev/null | drivers_status_filter || drv_rc=$?
    rm -f -- "$drv_conf"
    [ "$drv_rc" -eq 0 ] || die 5 "could not install $pkg (see the system journal)"
    dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed' || die 5 "$pkg was not installed (see the system journal)"
    log "user=$CALLER installed $pkg"
  else
    need_args $# 0
    mapfile -t drv_pkgs < <(dpkg-query -W -f='${Status} ${Package}\n' 2>/dev/null | drivers_nvidia_pkgs)
    [ "${#drv_pkgs[@]}" -gt 0 ] || die 3 "no NVIDIA driver is installed"
    # Never take other packages along (apt removes everything that depends on the driver without asking).
    drv_others=$(apt-get -s -q -o Debug::NoLocking=1 purge "${drv_pkgs[@]}" 2>/dev/null | awk '$1 == "Purg" || $1 == "Remv" { print $2 }' | grep -vxF -f <(printf '%s\n' "${drv_pkgs[@]}") | tr '\n' ' ') || true
    [ -z "$drv_others" ] || die 6 "removing the NVIDIA driver would also remove: ${drv_others% }"
    echo "step:remove"
    apt-get -q -y -o DPkg::Lock::Timeout=120 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold \
      -o APT::Status-Fd=3 purge "${drv_pkgs[@]}" 3>&1 1>&2 || die 5 "could not remove the NVIDIA driver (see the system journal)"
    # An xorg.conf written for the proprietary driver would keep Xorg from starting with nouveau / modesetting.
    if [ -f /etc/X11/xorg.conf ] && grep -qiE '^[[:space:]]*Driver[[:space:]]+"nvidia"' /etc/X11/xorg.conf; then
      mv -f -- /etc/X11/xorg.conf "/etc/X11/xorg.conf.nvidia-$(date +%Y%m%d%H%M%S)"
    fi
    echo "step:initramfs"
    update-initramfs -u >&2 || die 5 "could not rebuild the initramfs (see the system journal)"
    log "user=$CALLER removed the NVIDIA driver (${drv_pkgs[*]})"
  fi
  echo "reboot-required"
  echo "done"
  ;;
# ------------------------------------------------------------------ END drivers

# ------------------------------------------------------------------ BEGIN printers (Paramètres > Imprimantes et scanners)
#   printer-add <queue> <ipp|ipps|dnssd URI> <label>
#       driverless IPP Everywhere queue: lpadmin -p QUEUE -E -v URI -m everywhere -D LABEL (CUPS asks the printer for
#       its capabilities; no PPD or vendor driver). Jobs are retried when the printer is off (error policy retry-job),
#       and the first printer becomes the default one.
#   printer-remove <queue>                       lpadmin -x
#   printer-default <queue>                      lpadmin -d (system default)
#   printer-enable <queue> <0|1>                 0: cupsdisable (pause: jobs wait), 1: cupsenable + cupsaccept (resume)
#   printer-rename <queue> <label>               lpadmin -D: the name people see (CUPS has no queue rename)
#   printer-job-cancel <queue-N>                 cancel another user's job (people cancel their own without this)
# Queue names: letters, digits, _ . - (63 max). Labels: 1–127 characters, no control characters, " or \.
printer-add | printer-remove | printer-default | printer-enable | printer-rename | printer-job-cancel)
  RE_PRINTER_QUEUE='^[A-Za-z0-9][A-Za-z0-9_.-]{0,62}$'
  RE_PRINTER_URI='^(ipp|ipps|dnssd)://[]A-Za-z0-9._~%:/?=&+@[-]{1,480}$'
  RE_PRINTER_JOB='^[A-Za-z0-9][A-Za-z0-9_.-]{0,62}-[1-9][0-9]{0,9}$'
  # printer_valid_label <label>: 1–127 bytes (${#v} counts bytes under LC_ALL=C: an accented letter is 2), no control
  # characters, no " or \, no space at either end. admin.js and cups.js check the same UTF-8 byte length.
  printer_valid_label() {
    local v=$1
    { [ -n "$v" ] && [ ${#v} -le 127 ]; } || die 2 "invalid printer label"
    [[ $v =~ [[:cntrl:]] ]] && die 2 "invalid printer label"
    case $v in *'"'* | *\\* | [[:space:]]* | *[[:space:]]) die 2 "invalid printer label" ;; esac
    return 0
  }
  printer_queue_arg() { [[ $1 =~ $RE_PRINTER_QUEUE ]] || die 2 "invalid printer name"; }
  printer_exists() { lpstat -p "$1" >/dev/null 2>&1; }
  printer_need_cups() { command -v lpadmin >/dev/null 2>&1 || die 3 "CUPS is not installed (package cups)"; }
  case $ACTION in
  printer-add)
    need_args $# 3
    printer_queue_arg "$1"
    [[ $2 =~ $RE_PRINTER_URI ]] || die 2 "invalid printer address (ipp://, ipps:// or dnssd:// only)"
    printer_valid_label "$3"
    printer_need_cups
    printer_exists "$1" && die 4 "a printer named $1 already exists"
    run_or_die "could not add $1: the printer did not answer (IPP Everywhere)" timeout 80 lpadmin -p "$1" -E -v "$2" -m everywhere -D "$3" -o printer-error-policy=retry-job
    if ! lpstat -d 2>/dev/null | grep -q '^system default destination:'; then
      lpadmin -d "$1" || true
    fi
    log "user=$CALLER added printer $1 ($2)"
    echo "ok $1"
    ;;
  printer-remove)
    need_args $# 1
    printer_queue_arg "$1"
    printer_need_cups
    printer_exists "$1" || die 3 "no such printer: $1"
    run_or_die "could not remove $1" lpadmin -x "$1"
    log "user=$CALLER removed printer $1"
    echo "ok"
    ;;
  printer-default)
    need_args $# 1
    printer_queue_arg "$1"
    printer_need_cups
    printer_exists "$1" || die 3 "no such printer: $1"
    run_or_die "could not make $1 the default printer" lpadmin -d "$1"
    log "user=$CALLER default printer $1"
    echo "ok"
    ;;
  printer-enable)
    need_args $# 2
    printer_queue_arg "$1"
    valid_bool "$2"
    printer_need_cups
    printer_exists "$1" || die 3 "no such printer: $1"
    if [ "$2" = 1 ]; then
      run_or_die "could not resume $1" cupsenable "$1"
      run_or_die "could not resume $1" cupsaccept "$1"
    else
      run_or_die "could not pause $1" cupsdisable "$1"
    fi
    log "user=$CALLER printer $1 enabled=$2"
    echo "ok"
    ;;
  printer-rename)
    need_args $# 2
    printer_queue_arg "$1"
    printer_valid_label "$2"
    printer_need_cups
    printer_exists "$1" || die 3 "no such printer: $1"
    run_or_die "could not rename $1" lpadmin -p "$1" -D "$2"
    log "user=$CALLER renamed printer $1"
    echo "ok"
    ;;
  printer-job-cancel)
    need_args $# 1
    [[ $1 =~ $RE_PRINTER_JOB ]] || die 2 "invalid print job"
    printer_need_cups
    run_or_die "could not cancel $1" cancel "$1"
    log "user=$CALLER cancelled print job $1"
    echo "ok"
    ;;
  esac
  ;;
# ------------------------------------------------------------------ END printers

# ------------------------------------------------------------------ BEGIN firmware (Paramètres > Mises à jour > Microprogrammes)
#   firmware-update <device-id>
#       fwupdmgr update of that one device (device ids are SHA-1 strings: exactly 40 lowercase hex digits), never
#       interactive (--assume-yes, no reboot / unreported / metadata prompts). The firmware comes from the LVFS
#       metadata fwupd already checked (signed cabinet archives). Prints fwupdmgr's output, then "reboot-required"
#       when a device waits for a restart to finish (UEFI capsules, NVMe…), then "done".
#       Exit 3 when there is nothing to install for that device (fwupdmgr exit 2), 5 when the update failed.
firmware-update)
  need_args $# 1
  [[ $1 =~ ^[0-9a-f]{40}$ ]] || die 2 "invalid firmware device id"
  command -v fwupdmgr >/dev/null 2>&1 || die 3 "fwupd is not installed (package fwupd)"
  fw_rc=0
  fw_out="$(timeout 3600 fwupdmgr --assume-yes --no-reboot-check --no-unreported-check --no-metadata-check update -- "$1" 2>&1)" || fw_rc=$?
  printf '%s\n' "$fw_out"
  case $fw_rc in
  0) ;;
  2) die 3 "no firmware update is available for this device" ;;
  *) printf '%s\n' "$fw_out" | tail -n 3 >&2; die 5 "the firmware update failed (see the system journal)" ;;
  esac
  log "user=$CALLER firmware update of device $1"
  # Read into a variable first: with pipefail, `fwupdmgr … | grep -q` can fail on SIGPIPE when the JSON is large.
  fw_devs="$(fwupdmgr get-devices --json 2>/dev/null || true)"
  if grep -Eq '"(UpdateState)"[[:space:]]*:[[:space:]]*"needs-reboot"|"update-pending"' <<<"$fw_devs"; then
    echo "reboot-required"
  fi
  echo "done"
  ;;
# ------------------------------------------------------------------ END firmware

# ------------------------------------------------------------------ BEGIN power (Paramètres > Alimentation > capot)
#   power-lid <suspend|ignore|poweroff>
#       What closing the lid does (on battery and on mains): writes /etc/systemd/logind.conf.d/50-aurora-lid.conf, then
#       asks systemd-logind to reload its configuration (SIGHUP; sessions are untouched). Docked: logind's default.
power-lid)
  power_lid_conf() {
    printf '# Selene OS: written by aurora-admin power-lid (Paramètres > Alimentation)\n[Login]\nHandleLidSwitch=%s\nHandleLidSwitchExternalPower=%s\n' "$1" "$1"
  }
  need_args $# 1
  [[ $1 =~ ^(suspend|ignore|poweroff)$ ]] || die 2 "invalid lid action"
  run_or_die "cannot create /etc/systemd/logind.conf.d" install -d -m 0755 /etc/systemd/logind.conf.d
  power_lid_tmp="$(mktemp /etc/systemd/logind.conf.d/.aurora-lid.XXXXXX)" || die 5 "cannot write the logind drop-in"
  if ! { power_lid_conf "$1" >"$power_lid_tmp" && chmod 0644 "$power_lid_tmp" && mv -f -- "$power_lid_tmp" /etc/systemd/logind.conf.d/50-aurora-lid.conf; }; then
    rm -f -- "$power_lid_tmp"
    die 5 "cannot write the logind drop-in"
  fi
  systemctl kill -s HUP systemd-logind >/dev/null 2>&1 || true
  log "user=$CALLER lid action set to $1"
  echo "ok"
  ;;
# ------------------------------------------------------------------ END power

*)
  die 2 "unknown action: $ACTION"
  ;;
esac
