#!/usr/bin/python3
# aurora-sessionbus — Selene's session D-Bus helper, run as the signed-in user by shell/main/ipc/sessionbus.js.
#
# 1. Notification server: owns org.freedesktop.Notifications (Desktop Notifications spec 1.2). Each Notify becomes a
#    Selene notification (toast + notification centre) drawn by the shell; NotificationClosed / ActionInvoked go
#    back to the app. Flatpak apps reach it through xdg-desktop-portal(-gtk), which forwards to this name.
# 2. System tray: owns org.kde.StatusNotifierWatcher and is its host. Registered StatusNotifierItems are read
#    (icon name / ARGB pixmap -> PNG data URL, status, tooltip, menu) and listed to the shell; items go away when
#    their owner leaves the bus. Right click: the item's com.canonical.dbusmenu layout, Event "clicked" back.
#    Legacy XEmbed tray icons are not bridged (no cheap bridge in noble: snixembed is not packaged,
#    xembedsniproxy comes only with plasma-workspace).
# 3. Idle inhibitors: owns org.freedesktop.ScreenSaver (/org/freedesktop/ScreenSaver and /ScreenSaver) and
#    org.freedesktop.PowerManagement (/org/freedesktop/PowerManagement/Inhibit). Video players and browsers call
#    Inhibit while they play (Firefox, VLC, Chromium / Electron wake locks — the shell's own webviews and the
#    Navigateur included —, Flatpak apps through xdg-desktop-portal-gtk). ScreenSaver ones (kind "screen": video)
#    count as activity in the shell (no screen off, lock or idle sleep); PowerManagement ones (kind "power": audio,
#    Chromium's audio wake lock) only hold back idle sleep. Cookies belong to the D-Bus connection that took them and
#    are dropped when it leaves the bus (an app that crashes mid-film does not keep the screen on forever).
# Any name already owned by someone else: that part is off ("ready" says which, stderr logs it), the rest keeps working.
#
# Protocol: JSON lines.
#   stdin   {"id": 1, "cmd": "state"}                                  -> {"id": 1, "ok": true, "result": <state>}
#           {"id": 2, "cmd": "closed", "nid": 7, "reason": 2}          the shell removed it (1 expired, 2 dismissed)
#           {"id": 3, "cmd": "action", "nid": 7, "key": "reply"}       ActionInvoked (+ NotificationClosed 2 unless
#                                                                       the notification is resident)
#           {"id": 4, "cmd": "activate"|"secondary"|"context", "item": "<key>", "x": 0, "y": 0}
#           {"id": 5, "cmd": "scroll", "item": "<key>", "delta": 1, "orientation": "vertical"}
#           {"id": 6, "cmd": "menu", "item": "<key>"}                  -> {"items": [<menu entry>]}
#           {"id": 7, "cmd": "menu-event", "item": "<key>", "mid": 12}  Event(mid, "clicked")
#           {"id": 8, "cmd": "inhibitors"}                             -> <inhibitors>
#           {"id": 9, "cmd": "mpris-self", "state": <mpris state> | null}  export / update / withdraw the Lecteur
#           {"id": 10, "cmd": "mpris-seeked", "position": 12.5}        Seeked(µs) after a jump in the Lecteur
#   stdout  {"id": n, "ok": false, "error": "…", "code": "ENOTFOUND"|"EFAIL"|…}
#           {"event": "ready", "notifications": bool, "tray": bool, "screensaver": bool, "power": bool}
#           {"event": "inhibitors", "count": n, "apps": [names], "list": [{cookie, app, reason, kind}]}  on change
#           {"event": "activity"}                                       SimulateUserActivity (resets the idle timer)
#           {"event": "notify", "n": {id, app, icon, image, summary, body, actions: [[key, label]], urgency,
#                    timeout, entry, resident, transient, silent, replaces}}
#           {"event": "notify-close", "id": 7}                          CloseNotification from the app
#           {"event": "items", "items": [<item>]}                       whenever the tray changes (debounced)
#           {"event": "mpris-call", "method": "PlayPause"|"Play"|"Pause"|"Stop"|"Next"|"Previous"|"Raise"|"Quit"|
#                    "Seek" (offset s)|"SetPosition" (position s)|"OpenUri" (path)|"Set" (prop, value)}
# 4. MPRIS: while the Lecteur is open the shell sends its state and the helper owns org.mpris.MediaPlayer2.selene
#    (/org/mpris/MediaPlayer2: MediaPlayer2 + Player, PropertiesChanged on every change but Position, Seeked);
#    method calls (KDE Connect, playerctl, any MPRIS client) go back to the Lecteur. OpenUri: local file:// media only.
# <mpris state> = {active, identity, status: Playing|Paused|Stopped, track: {id, title, artist, album, length (s),
#                  art (absolute path)} | null, position (s), rate, volume (0-1), loop: None|Track|Playlist, shuffle,
#                  canNext, canPrev, canPlay, canPause, canSeek}
# <item> = {key, id, title, category, status, icon, iconPng, attentionIcon, attentionPng, themePath,
#           tooltip: {title, body}, menu: bool, itemIsMenu: bool}
# <menu entry> = {id, label, type: "standard"|"separator", enabled, toggle: "checkmark"|"radio"|null, state, icon,
#                 children: [...]}
# Environment: DBUS_SESSION_BUS_ADDRESS picks the bus (tests use a private dbus-daemon).
