#!/usr/bin/python3 -I
"""aurora-pty: run a program on a new pseudo-terminal and relay it over pipes (Aurora Terminal).

Usage: aurora-pty [--cwd DIR] [--cols N] [--rows N] [--] [COMMAND [ARG...]]

Without COMMAND the user's login shell (from /etc/passwd, falling back to /bin/bash) starts as a
login shell. The program runs with TERM=xterm-256color and COLORTERM=truecolor; LANG and the rest
of the environment are passed through.

  stdin   -> terminal input (binary safe). EOF on stdin hangs the terminal up.
  stdout  <- terminal output (binary safe).
  fd 3    optional control pipe, one command per line:
            resize <cols> <rows>   set the window size (TIOCSWINSZ) and send SIGWINCH to the
                                   foreground process group
            signal <NAME|NUMBER>   send a signal to the foreground process group ("signal INT")
            hangup                 hang the terminal up, as when its window is closed
  stderr  diagnostics. Once the program runs, the first line is "@pid <pid>".

SIGTERM, SIGHUP and SIGINT received by the helper hang the terminal up: SIGHUP (and SIGCONT) go to
the foreground process group and to the program, and the terminal is closed. If the program is
still running after a grace period, it and the foreground job are killed. Jobs started with nohup
survive, as in any terminal.

Exit status: the program's exit status, 128+N when it was killed by signal N, 126 when it could not
be executed, 127 when it was not found, 2 on a usage error.

The helper never changes privileges. It refuses to run as root through sudo: the sudoers rule for
/usr/lib/aurora/helpers/* must not turn it into a generic "run anything as root" path.
"""
import errno
import fcntl
import os
import pwd
import select
import signal
import struct
import sys
import termios
import time

CHUNK = 65536
OUT_HIGH = 1 << 20       # stop reading the terminal while this much output waits for stdout
IN_HIGH = 4 << 20        # stop reading stdin while this much input waits for the terminal
DRAIN_QUIET = 0.05       # after the program exits: stop once the terminal is quiet this long
DRAIN_MAX = 2.0          # ... or after this long at most (background jobs still writing)
HANGUP_GRACE = 1.5       # seconds between SIGHUP and SIGKILL


def usage(msg):
    sys.stderr.write(f"aurora-pty: {msg}\nusage: aurora-pty [--cwd DIR] [--cols N] [--rows N] [--] [COMMAND [ARG...]]\n")
    sys.exit(2)


def parse_args(argv):
    opts = {"cwd": None, "cols": 80, "rows": 24, "command": []}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--":
            opts["command"] = argv[i + 1:]
            break
        if a in ("--cwd", "--cols", "--rows"):
            if i + 1 >= len(argv):
                usage(f"{a} needs a value")
            val = argv[i + 1]
            i += 2
        elif a.startswith(("--cwd=", "--cols=", "--rows=")):
            a, val = a.split("=", 1)
            i += 1
        elif a in ("-h", "--help"):
            sys.stdout.write(__doc__)
            sys.exit(0)
        elif a.startswith("--"):
            usage(f"unknown option {a}")
        else:
            opts["command"] = argv[i:]
            break
        if a == "--cwd":
            opts["cwd"] = val
        else:
            try:
                n = int(val)
            except ValueError:
                usage(f"{a} must be a number")
            if not 1 <= n <= 10000:
                usage(f"{a} out of range")
            opts[a[2:]] = n
    return opts


def login_shell():
    try:
        sh = pwd.getpwuid(os.getuid()).pw_shell
    except KeyError:
        sh = ""
    if sh and os.path.basename(sh) not in ("nologin", "false") and os.access(sh, os.X_OK):
        return sh
    for cand in ("/bin/bash", "/usr/bin/bash", "/bin/sh"):
        if os.access(cand, os.X_OK):
            return cand
    return "/bin/sh"


def home_dir():
    try:
        return pwd.getpwuid(os.getuid()).pw_dir or "/"
    except KeyError:
        return os.environ.get("HOME") or "/"


def set_winsize(fd, cols, rows):
    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))


def set_nonblock(fd):
    fl = fcntl.fcntl(fd, fcntl.F_GETFL)
    fcntl.fcntl(fd, fcntl.F_SETFL, fl | os.O_NONBLOCK)


def set_block(fd):
    try:
        fl = fcntl.fcntl(fd, fcntl.F_GETFL)
        fcntl.fcntl(fd, fcntl.F_SETFL, fl & ~os.O_NONBLOCK)
    except OSError:
        pass


def fd_open(fd):
    try:
        os.fstat(fd)
        return True
    except OSError:
        return False


def exit_code(status):
    if os.WIFEXITED(status):
        return os.WEXITSTATUS(status)
    if os.WIFSIGNALED(status):
        return 128 + os.WTERMSIG(status)
    return 1


def child_exec(slave, opts):
    """Runs in the forked child: becomes a session leader on the new terminal and execs the program."""
    try:
        os.setsid()
        fcntl.ioctl(slave, termios.TIOCSCTTY, 0)
        for fd in (0, 1, 2):
            os.dup2(slave, fd)
        os.closerange(3, 65536)
        # Python ignores SIGPIPE (and the parent installs handlers); ignored signals and the signal
        # mask survive exec, so give the program the default dispositions a terminal would.
        for sig in (signal.SIGPIPE, signal.SIGINT, signal.SIGQUIT, signal.SIGTERM, signal.SIGHUP, signal.SIGCHLD,
                    signal.SIGTSTP, signal.SIGTTIN, signal.SIGTTOU, signal.SIGWINCH, signal.SIGXFSZ, signal.SIGALRM):
            signal.signal(sig, signal.SIG_DFL)
        signal.pthread_sigmask(signal.SIG_SETMASK, [])
        env = dict(os.environ)
        for k in ("COLUMNS", "LINES", "TERMCAP", "TERMINFO_DIRS_OVERRIDE"):
            env.pop(k, None)
        env["TERM"] = "xterm-256color"
        env["COLORTERM"] = "truecolor"
        home = home_dir()
        cwd = opts["cwd"] or home
        try:
            os.chdir(cwd)
        except OSError:
            try:
                os.chdir(home)
            except OSError:
                os.chdir("/")
        env["PWD"] = os.getcwd()
        if opts["command"]:
            argv = list(opts["command"])
            prog = argv[0]
        else:
            prog = login_shell()
            argv = ["-" + os.path.basename(prog)]
            env.setdefault("SHELL", prog)
        try:
            os.execvpe(prog, argv, env)
        except OSError as e:
            code = 127 if e.errno == errno.ENOENT else 126
            os.write(2, f"aurora-pty: cannot run '{prog}': {e.strerror}\n".encode("utf-8", "replace"))
            os._exit(code)
    except BaseException as e:  # never fall back into the parent's code
        try:
            os.write(2, f"aurora-pty: {e}\n".encode("utf-8", "replace"))
        finally:
            os._exit(126)


class Relay:
    def __init__(self, opts):
        self.opts = opts
        self.master = -1
        self.pid = 0
        self.status = None          # child's wait status once reaped
        self.outbuf = bytearray()   # terminal output waiting for stdout
        self.inbuf = bytearray()    # input waiting for the terminal
        self.ctlbuf = bytearray()
        self.stdin_open = True
        self.stdout_open = True
        self.ctl_open = fd_open(3)
        self.master_open = True
        self.hup_requested = False
        self.wake_r, self.wake_w = os.pipe()

    # ------------------------------------------------------------------ setup
    def start(self):
        master, slave = os.openpty()
        try:
            attrs = termios.tcgetattr(slave)
            if hasattr(termios, "IUTF8"):
                attrs[0] |= termios.IUTF8   # line editing erases whole UTF-8 characters
            termios.tcsetattr(slave, termios.TCSANOW, attrs)
        except termios.error:
            pass
        set_winsize(master, self.opts["cols"], self.opts["rows"])
        pid = os.fork()
        if pid == 0:
            os.close(master)
            child_exec(slave, self.opts)
        os.close(slave)
        self.master, self.pid = master, pid
        for fd in (self.wake_r, self.wake_w, master, 0, 1):
            set_nonblock(fd)
        if self.ctl_open:
            set_nonblock(3)
        signal.set_wakeup_fd(self.wake_w, warn_on_full_buffer=False)
        for sig in (signal.SIGCHLD, signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
            signal.signal(sig, self.on_signal)
        signal.signal(signal.SIGPIPE, signal.SIG_IGN)
        try:
            os.write(2, f"@pid {pid}\n".encode())
        except OSError:
            pass

    def on_signal(self, sig, _frame):
        if sig != signal.SIGCHLD:
            self.hup_requested = True

    # ------------------------------------------------------------------ helpers
    def reap(self):
        if self.status is not None:
            return True
        try:
            pid, status = os.waitpid(self.pid, os.WNOHANG)
        except ChildProcessError:
            self.status = 0
            return True
        if pid == self.pid:
            self.status = status
            return True
        return False

    def fg_pgrp(self):
        try:
            return os.tcgetpgrp(self.master)
        except OSError:
            return 0

    def signal_fg(self, sig):
        targets = {self.fg_pgrp()} - {0}
        for pg in targets:
            try:
                os.killpg(pg, sig)
            except OSError:
                pass

    def resize(self, cols, rows):
        set_winsize(self.master, cols, rows)
        # The kernel signals a real size change itself; repeat it for programs that missed it.
        self.signal_fg(signal.SIGWINCH)

    def control(self, line):
        parts = line.split()
        if not parts:
            return
        cmd = parts[0]
        try:
            if cmd == "resize" and len(parts) == 3:
                cols, rows = int(parts[1]), int(parts[2])
                if 1 <= cols <= 10000 and 1 <= rows <= 10000 and self.master_open:
                    self.resize(cols, rows)
            elif cmd == "signal" and len(parts) == 2:
                name = parts[1].upper()
                sig = int(name) if name.isdigit() else getattr(signal, name if name.startswith("SIG") else "SIG" + name)
                if self.master_open:
                    self.signal_fg(sig)
            elif cmd == "hangup":
                self.hup_requested = True
        except (ValueError, AttributeError, OSError) as e:
            sys.stderr.write(f"aurora-pty: bad control command {line!r}: {e}\n")

    def write_out(self, block=False):
        while self.outbuf and self.stdout_open:
            try:
                n = os.write(1, self.outbuf[:CHUNK])
            except BlockingIOError:
                if not block:
                    return
                select.select([], [1], [], 1.0)
                continue
            except OSError:            # EPIPE: nobody listens any more
                self.stdout_open = False
                self.outbuf.clear()
                self.hup_requested = True
                return
            del self.outbuf[:n]

    def read_master(self):
        """Reads what the terminal has. Returns False at end of file (no more writers)."""
        try:
            data = os.read(self.master, CHUNK)
        except BlockingIOError:
            return True
        except OSError as e:
            if e.errno == errno.EIO:
                return False
            raise
        if not data:
            return False
        self.outbuf += data
        return True

    # ------------------------------------------------------------------ main loop
    def run(self):
        master_eof = False
        while True:
            if self.hup_requested:
                return self.hangup()
            if self.reap():
                return self.finish(master_eof)
            rlist = [self.wake_r]
            if self.stdin_open and len(self.inbuf) < IN_HIGH:
                rlist.append(0)
            if self.ctl_open:
                rlist.append(3)
            if not master_eof and len(self.outbuf) < OUT_HIGH:
                rlist.append(self.master)
            wlist = []
            if self.outbuf and self.stdout_open:
                wlist.append(1)
            if self.inbuf and not master_eof:
                wlist.append(self.master)
            try:
                r, w, _ = select.select(rlist, wlist, [], 1.0)
            except InterruptedError:
                continue
            if self.wake_r in r:
                try:
                    os.read(self.wake_r, 512)
                except OSError:
                    pass
            if self.master in r:
                if not self.read_master():
                    master_eof = True   # the program closed the terminal; wait for it to exit
            if 1 in w:
                self.write_out()
            if 0 in r:
                try:
                    data = os.read(0, CHUNK)
                except BlockingIOError:
                    data = None
                except OSError:
                    data = b""
                if data == b"":
                    self.stdin_open = False
                    self.hup_requested = True
                elif data:
                    self.inbuf += data
            if self.ctl_open and 3 in r:
                try:
                    data = os.read(3, 4096)
                except BlockingIOError:
                    data = None
                except OSError:
                    data = b""
                if data == b"":
                    self.ctl_open = False
                elif data:
                    self.ctlbuf += data
                    while b"\n" in self.ctlbuf:
                        line, _, rest = bytes(self.ctlbuf).partition(b"\n")
                        self.ctlbuf = bytearray(rest)
                        self.control(line.decode("ascii", "replace"))
                    if len(self.ctlbuf) > 4096:
                        self.ctlbuf.clear()
            if self.inbuf and not master_eof and (self.master in w or 0 in r):
                try:
                    n = os.write(self.master, self.inbuf[:CHUNK])
                    del self.inbuf[:n]
                except BlockingIOError:
                    pass
                except OSError:
                    self.inbuf.clear()

    def finish(self, master_eof):
        """The program exited: forward the output it left in the terminal, then exit with its status."""
        deadline = time.monotonic() + DRAIN_MAX
        while not master_eof and time.monotonic() < deadline and self.stdout_open:
            if len(self.outbuf) >= OUT_HIGH:
                self.write_out(block=True)
            try:
                r, _, _ = select.select([self.master], [], [], DRAIN_QUIET)
            except InterruptedError:
                continue
            if not r:
                break
            if not self.read_master():
                break
        self.close_master()
        self.write_out(block=True)
        return exit_code(self.status)

    def close_master(self):
        if self.master_open:
            self.master_open = False
            try:
                os.close(self.master)
            except OSError:
                pass

    def hangup(self):
        """Like closing a terminal window: SIGHUP the session, close the terminal, then insist."""
        fg = self.fg_pgrp()
        for target in {fg, self.pid} - {0}:
            for sig in (signal.SIGHUP, signal.SIGCONT):
                try:
                    os.killpg(target, sig)
                except OSError:
                    pass
        self.close_master()
        deadline = time.monotonic() + HANGUP_GRACE
        while not self.reap() and time.monotonic() < deadline:
            time.sleep(0.02)
        if self.status is None:
            for target in {fg, self.pid} - {0}:
                try:
                    os.killpg(target, signal.SIGKILL)
                except OSError:
                    pass
            try:
                _, self.status = os.waitpid(self.pid, 0)
            except ChildProcessError:
                self.status = signal.SIGKILL
        if self.stdout_open:
            set_block(1)
            self.write_out(block=True)
        return exit_code(self.status)


def main():
    if os.geteuid() == 0 and os.environ.get("SUDO_UID") and os.getuid() == 0:
        sys.stderr.write("aurora-pty: refusing to run as root through sudo\n")
        return 2
    opts = parse_args(sys.argv[1:])
    relay = Relay(opts)
    try:
        relay.start()
    except OSError as e:
        sys.stderr.write(f"aurora-pty: cannot create a terminal: {e}\n")
        return 1
    try:
        return relay.run()
    except Exception as e:  # keep the child from being orphaned on an unexpected error
        sys.stderr.write(f"aurora-pty: {e}\n")
        relay.hup_requested = True
        return relay.hangup()


if __name__ == "__main__":
    sys.exit(main())
