#!/usr/bin/python3 -I
"""aurora-xresize XID X Y WIDTH HEIGHT

Moves/resizes an X11 window directly through Xlib (no window manager runs under Selene Shell).

Used by the shell (shell/main/index.js) to make its window cover the display exactly: Chromium
never creates a window exactly as large as a display (it subtracts one pixel so that window
managers do not maximize it), which would leave a 1px gap on the right and bottom edges.
"""
import ctypes
import sys


def main(argv):
    if len(argv) != 6:
        print(__doc__.strip().splitlines()[0], file=sys.stderr)
        return 2
    try:
        xid, x, y, width, height = (int(a, 0) for a in argv[1:])
    except ValueError:
        print("aurora-xresize: numeric arguments expected", file=sys.stderr)
        return 2
    if xid <= 0 or width <= 0 or height <= 0:
        print("aurora-xresize: invalid window or size", file=sys.stderr)
        return 2
    xlib = ctypes.CDLL("libX11.so.6")
    xlib.XOpenDisplay.restype = ctypes.c_void_p
    xlib.XOpenDisplay.argtypes = [ctypes.c_char_p]
    xlib.XMoveResizeWindow.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int, ctypes.c_int,
                                       ctypes.c_uint, ctypes.c_uint]
    xlib.XSync.argtypes = [ctypes.c_void_p, ctypes.c_int]
    xlib.XCloseDisplay.argtypes = [ctypes.c_void_p]
    display = xlib.XOpenDisplay(None)
    if not display:
        print("aurora-xresize: cannot open the X display", file=sys.stderr)
        return 1
    try:
        xlib.XMoveResizeWindow(display, xid, x, y, width, height)
        xlib.XSync(display, 0)
    finally:
        xlib.XCloseDisplay(display)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
