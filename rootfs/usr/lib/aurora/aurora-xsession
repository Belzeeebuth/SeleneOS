#!/bin/sh
# X client of the desktop session (started by aurora-session through aurora-xstart):
# X settings, environment for user services, then the shell. A crashed shell is restarted
# (at most 3 times within 2 minutes; the third start is in safe mode); a normal exit (sign out) ends the session.
set -u
# AURORA_COMMON / AURORA_SHELL_BIN: test hooks only (shell/test/robust.test.mjs); this script runs as the user.
. "${AURORA_COMMON:-/usr/lib/aurora/aurora-common}"

aurora_x_setup

# Display settings saved in Settings (resolution, scale, arrangement), applied on top of the
# defaults above. Owned by the Settings backend; optional.
if [ -x /usr/lib/aurora/helpers/aurora-apply-display ]; then
  timeout 20 /usr/lib/aurora/helpers/aurora-apply-display \
    || aurora_log "aurora-apply-display failed (status $?); keeping the current display mode"
fi

# User folders (Desktop, Documents, Downloads, Pictures, Music, Videos; see
# /etc/skel/.config/user-dirs.dirs). Creates whatever is missing, e.g. after a reset.
xdg-user-dirs-update >/dev/null 2>&1 || true

# Make the display known to D-Bus-activated and systemd user services.
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_SESSION_TYPE \
    XDG_CURRENT_DESKTOP LANG AURORA_LANG XCURSOR_THEME XCURSOR_SIZE >/dev/null 2>&1 || true
fi

# SPICE guest agent (clipboard sharing, automatic resolution) when the VM provides the channel.
if [ -e /dev/virtio-ports/com.redhat.spice.0 ] && command -v spice-vdagent >/dev/null 2>&1; then
  spice-vdagent >/dev/null 2>&1 || true
fi

crashes=0
window=$(date +%s)
while :; do
  "${AURORA_SHELL_BIN:-/usr/bin/aurora-shell}"
  rc=$?
  [ "$rc" -eq 0 ] && exit 0
  now=$(date +%s)
  if [ $((now - window)) -gt 120 ]; then crashes=0; window=$now; fi
  crashes=$((crashes + 1))
  aurora_log "aurora-shell exited with status $rc (failure $crashes)"
  # A GPU driver that crashes the shell (e.g. a VM without 3D acceleration that looks like a GPU):
  # retry with software rendering, unless the user forced the GPU on (AURORA_GPU / aurora.gpu=).
  if [ -z "${AURORA_GPU:-}" ] && ! aurora_cmdline aurora.gpu >/dev/null && [ "$(aurora_gpu_mode)" = on ]; then
    export AURORA_GPU=off
    aurora_log "retrying the shell with software rendering (AURORA_GPU=off)"
  fi
  if [ "$crashes" -ge 3 ]; then
    aurora_log "aurora-shell keeps failing; ending the session"
    exit "$rc"
  fi
  # Safe mode after 2 crashes in a row (before giving up): the shell ignores the user's look and startup apps
  # and shows a banner to restart normally (shell/main/lib/robust.js, core/features/robust.js).
  if [ "$crashes" -ge 2 ] && [ "${AURORA_SAFE_MODE:-}" != 1 ]; then
    export AURORA_SAFE_MODE=1
    aurora_log "starting the shell in safe mode (AURORA_SAFE_MODE=1)"
  fi
  sleep 1
done
