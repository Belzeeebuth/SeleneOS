# Selene OS: default handlers for xdg-open, GIO and the OpenURI portal (Flatpak apps).
# The user's own choices (~/.config/mimeapps.list, e.g. a Flathub browser picked later) always win.
[Default Applications]
x-scheme-handler/http=aurora-browser.desktop
x-scheme-handler/https=aurora-browser.desktop
x-scheme-handler/mailto=aurora-mail.desktop
message/rfc822=aurora-mail.desktop
inode/directory=aurora-files.desktop
text/plain=aurora-notepad.desktop
text/markdown=aurora-notepad.desktop
text/x-log=aurora-notepad.desktop
text/csv=aurora-notepad.desktop
application/json=aurora-notepad.desktop
application/xml=aurora-notepad.desktop
text/xml=aurora-notepad.desktop
application/x-yaml=aurora-notepad.desktop
application/x-shellscript=aurora-notepad.desktop
text/x-python=aurora-notepad.desktop
text/x-csrc=aurora-notepad.desktop
text/x-chdr=aurora-notepad.desktop
text/x-c++src=aurora-notepad.desktop
application/toml=aurora-notepad.desktop
application/x-subrip=aurora-notepad.desktop
image/png=aurora-photos.desktop
image/jpeg=aurora-photos.desktop
image/gif=aurora-photos.desktop
image/webp=aurora-photos.desktop
image/bmp=aurora-photos.desktop
image/svg+xml=aurora-photos.desktop
image/avif=aurora-photos.desktop
image/vnd.microsoft.icon=aurora-photos.desktop
audio/mpeg=aurora-media.desktop
audio/x-wav=aurora-media.desktop
audio/wav=aurora-media.desktop
audio/ogg=aurora-media.desktop
audio/opus=aurora-media.desktop
audio/flac=aurora-media.desktop
audio/mp4=aurora-media.desktop
audio/aac=aurora-media.desktop
video/mp4=aurora-media.desktop
video/x-m4v=aurora-media.desktop
video/webm=aurora-media.desktop
video/ogg=aurora-media.desktop
video/x-matroska=aurora-media.desktop
video/quicktime=aurora-media.desktop
application/pdf=aurora-pdf.desktop
application/zip=aurora-archive.desktop
application/x-tar=aurora-archive.desktop
application/gzip=aurora-archive.desktop
application/x-compressed-tar=aurora-archive.desktop
application/x-xz=aurora-archive.desktop
application/x-xz-compressed-tar=aurora-archive.desktop
application/x-bzip2=aurora-archive.desktop
application/x-bzip2-compressed-tar=aurora-archive.desktop
application/zstd=aurora-archive.desktop
application/x-zstd-compressed-tar=aurora-archive.desktop
application/x-7z-compressed=aurora-archive.desktop
application/vnd.rar=aurora-archive.desktop
application/vnd.ms-cab-compressed=aurora-archive.desktop
application/x-java-archive=aurora-archive.desktop

