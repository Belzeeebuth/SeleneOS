// Selene OS: unattended-upgrades keeps the system clean after security updates.
// Old kernels (and the dependencies the updates no longer need) are removed; the running
// kernel and the newest one are always kept by apt's kernel autoremoval rules.
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-New-Unused-Dependencies "true";
Unattended-Upgrade::Remove-Unused-Dependencies "false";
Unattended-Upgrade::Automatic-Reboot "false";
